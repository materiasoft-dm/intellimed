@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Entities
@using IntelliMed.Web.Services
@inject IClientService ClientService

@if (Visible)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">@Title</h6>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2" @onkeydown="HandleKeyDown">
                        <div class="col-3">
                            <label class="form-label small mb-0">Surname</label>
                            <input class="form-control form-control-sm" @bind="_surname" @bind:event="oninput" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-0">Given Name</label>
                            <input class="form-control form-control-sm" @bind="_givenName" @bind:event="oninput" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-0">Medicare#</label>
                            <input class="form-control form-control-sm" @bind="_medicareNumber" @bind:event="oninput" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-0">DVA#</label>
                            <input class="form-control form-control-sm" @bind="_dvaNumber" @bind:event="oninput" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-0">D.O.B.</label>
                            <input type="date" class="form-control form-control-sm" @bind="_dob" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-0">Gender</label>
                            <select class="form-select form-select-sm" @bind="_gender">
                                <option value="">Any</option>
                                <option value="@GenderEnum.Male">Male</option>
                                <option value="@GenderEnum.Female">Female</option>
                                <option value="@GenderEnum.Other">Other</option>
                            </select>
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-0">File#</label>
                            <input class="form-control form-control-sm" @bind="_fileNumber" @bind:event="oninput" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-0">Mobile Phone</label>
                            <input class="form-control form-control-sm" @bind="_mobilePhone" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-2 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearAsync">Clear</button>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="SearchAsync">Search</button>
                    </div>
                    <div style="max-height: 300px; overflow-y: auto;">
                        @if (!_hasSearched)
                        {
                            <div class="text-muted small">Enter search criteria and click Search (or press Enter).</div>
                        }
                        else if (_results.Count == 0)
                        {
                            <div class="text-muted small">No matches.</div>
                        }
                        else
                        {
                            <table class="table table-sm table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>D.O.B.</th>
                                        <th>Medicare#</th>
                                        <th>DVA#</th>
                                        <th>File#</th>
                                        <th>Mobile</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in _results)
                                    {
                                        <tr style="cursor:pointer" @onclick="() => Select(c)">
                                            <td>@c.FullName</td>
                                            <td>@c.DateOfBirth.ToString("dd/MM/yyyy")</td>
                                            <td>@c.MedicareNumber</td>
                                            <td>@c.DvaNumber</td>
                                            <td>@c.FileNumber</td>
                                            <td>@c.MobilePhone</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="Close">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback<ClientDto> OnSelected { get; set; }
    [Parameter] public string Title { get; set; } = "Find Client";

    private string _surname = string.Empty;
    private string _givenName = string.Empty;
    private string _medicareNumber = string.Empty;
    private string _dvaNumber = string.Empty;
    private DateTime? _dob;
    private GenderEnum? _gender;
    private string _fileNumber = string.Empty;
    private string _mobilePhone = string.Empty;

    private List<ClientDto> _results = new();
    private bool _hasSearched;
    private bool _wasVisible;

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            ResetFilters();
        }
        _wasVisible = Visible;
    }

    private void ResetFilters()
    {
        _surname = string.Empty;
        _givenName = string.Empty;
        _medicareNumber = string.Empty;
        _dvaNumber = string.Empty;
        _dob = null;
        _gender = null;
        _fileNumber = string.Empty;
        _mobilePhone = string.Empty;
        _results = new();
        _hasSearched = false;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _hasSearched = true;
        var search = new ClientSearchDto
        {
            PageSize = 20,
            Surname = NullIfEmpty(_surname),
            GivenName = NullIfEmpty(_givenName),
            MedicareNumber = NullIfEmpty(_medicareNumber),
            DvaNumber = NullIfEmpty(_dvaNumber),
            DobFrom = _dob,
            DobTo = _dob,
            Gender = _gender,
            FileNumber = NullIfEmpty(_fileNumber),
            MobilePhone = NullIfEmpty(_mobilePhone)
        };
        var result = await ClientService.SearchClientsAsync(search);
        _results = result.Items.ToList();
    }

    private async Task ClearAsync()
    {
        ResetFilters();
        await Task.CompletedTask;
    }

    private static string? NullIfEmpty(string value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private async Task Select(ClientDto client)
    {
        await OnSelected.InvokeAsync(client);
        await Close();
    }

    private async Task Close()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }
}
