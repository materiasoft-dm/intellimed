@using IntelliMed.Core.DTOs
@using IntelliMed.Web.Services
@inject INotificationService NotificationService
@inject NavigationManager Navigation
@implements IDisposable

<div class="dropdown me-2">
    <button class="btn btn-outline-secondary border-0 position-relative" type="button"
            data-bs-toggle="dropdown" aria-expanded="false" @onclick="OnDropdownOpened" title="Notifications">
        <i class="bi bi-bell"></i>
        @if (_unreadCount > 0)
        {
            <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle" style="font-size:0.6rem;">
                @(_unreadCount > 99 ? "99+" : _unreadCount.ToString())
            </span>
        }
    </button>
    <ul class="dropdown-menu dropdown-menu-end" style="width: 340px; max-height: 420px; overflow-y: auto;">
        <li class="d-flex justify-content-between align-items-center px-3 py-1">
            <strong>Notifications</strong>
            @if (_unreadCount > 0)
            {
                <button class="btn btn-link btn-sm p-0" type="button" @onclick="MarkAllReadAsync">Mark all read</button>
            }
        </li>
        <li><hr class="dropdown-divider" /></li>
        @if (_loaded && _recent.Count == 0)
        {
            <li class="px-3 py-2 text-muted small">No notifications</li>
        }
        @foreach (var n in _recent)
        {
            <li>
                <button class="dropdown-item @(n.IsRead ? "" : "fw-bold")" type="button" @onclick="() => OpenAsync(n)">
                    <div class="small">@n.Message</div>
                    <div class="text-muted" style="font-size:0.7rem;">@n.CreatedAt.ToLocalTime().ToString("g")</div>
                </button>
            </li>
        }
    </ul>
</div>

@code {
    private int _unreadCount;
    private List<NotificationDto> _recent = new();
    private bool _loaded;
    private System.Threading.Timer? _pollTimer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshUnreadCountAsync();
        _pollTimer = new System.Threading.Timer(
            _ => InvokeAsync(RefreshUnreadCountAsync), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task RefreshUnreadCountAsync()
    {
        _unreadCount = await NotificationService.GetUnreadCountAsync();
        StateHasChanged();
    }

    private async Task OnDropdownOpened()
    {
        _recent = (await NotificationService.GetRecentAsync()).ToList();
        _loaded = true;
    }

    private async Task OpenAsync(NotificationDto notification)
    {
        if (!notification.IsRead)
        {
            await NotificationService.MarkReadAsync(notification.Id);
            notification.IsRead = true;
            _unreadCount = Math.Max(0, _unreadCount - 1);
        }

        if (!string.IsNullOrEmpty(notification.LinkUrl))
            Navigation.NavigateTo(notification.LinkUrl);
    }

    private async Task MarkAllReadAsync()
    {
        await NotificationService.MarkAllReadAsync();
        foreach (var n in _recent) n.IsRead = true;
        _unreadCount = 0;
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }
}
