@* Shared across AddClient.razor / ProgressNoteEditor.razor / NewAppointment.razor — each already
   loads the full ClientDto (or has the equivalent denormalized AppointmentDto fields) for its own
   purposes, so this only ever renders from already-fetched data, never triggers its own fetch.
   WaitingRoom.razor deliberately does NOT use this component — it wants a compact icon+tooltip in a
   table cell, not full alert boxes, so it renders its own equivalent inline. *@

@if (Deceased || !string.IsNullOrWhiteSpace(Warnings) || InterpreterRequired || IsMinor)
{
    <div>
        @if (Deceased)
        {
            <div class="alert alert-danger small py-2 mb-1">
                <i class="bi bi-exclamation-triangle me-1"></i>
                This client is recorded as deceased.
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Warnings))
        {
            <div class="alert alert-warning small py-2 mb-1">
                <i class="bi bi-exclamation-triangle me-1"></i>
                @Warnings
            </div>
        }
        @if (InterpreterRequired)
        {
            <div class="alert alert-secondary small py-2 mb-1">
                <i class="bi bi-info-circle me-1"></i>
                Interpreter required@(string.IsNullOrWhiteSpace(InterpreterLanguage) ? "." : $" — {InterpreterLanguage}.")
            </div>
        }
        @if (IsMinor)
        {
            <div class="alert alert-secondary small py-2 mb-0">
                <i class="bi bi-info-circle me-1"></i>
                Patient is a minor (age @Age).@GuardianText
            </div>
        }
    </div>
}

@code {
    [Parameter] public bool Deceased { get; set; }
    [Parameter] public string? Warnings { get; set; }
    [Parameter] public bool InterpreterRequired { get; set; }
    [Parameter] public string? InterpreterLanguage { get; set; }
    [Parameter] public int Age { get; set; }
    [Parameter] public string? NextOfKinName { get; set; }
    [Parameter] public string? NextOfKinPhone { get; set; }

    private bool IsMinor => Age < 18;

    private string GuardianText => string.IsNullOrWhiteSpace(NextOfKinName)
        ? ""
        : $" Next of kin: {NextOfKinName}{(string.IsNullOrWhiteSpace(NextOfKinPhone) ? "" : $" ({NextOfKinPhone})")}.";
}
