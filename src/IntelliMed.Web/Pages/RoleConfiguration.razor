@page "/admin/roles"
@layout MainLayout
@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Permissions
@using IntelliMed.Web.Services
@inject IAdminService AdminService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Role Configuration - IntelliMed</PageTitle>

<h4 class="mb-4">Role Configuration</h4>

@* =========================================================================
   HEADER CARD
   ========================================================================= *@
<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
            <span class="d-flex align-items-center">
                <i class="bi bi-shield-lock me-2"></i> Configure which pages each role can access
            </span>
            <button type="button" class="btn btn-outline-primary" @onclick="NavigateBackToUsers">
                <i class="bi bi-arrow-left me-1"></i> Back to Users
            </button>
        </div>
    </div>
</div>

@* =========================================================================
   LOADING STATE
   ========================================================================= *@
@if (_isLoading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (_error != null)
{
    <div class="alert alert-danger mb-4">@_error</div>
}
else
{
    @* =========================================================================
       ROLE SELECTOR + SEARCH + SAVE
       ========================================================================= *@
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label">Select Role</label>
                    <select class="form-select" value="@_selectedRole"
                            @onchange="OnRoleChanged">
                        <option value="">-- Choose a role --</option>
                        @foreach (var role in _roles)
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Search pages...</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Search..."
                               value="@_searchText"
                               @oninput="OnSearchChanged" />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-primary w-100"
                            @onclick="SavePermissionsAsync"
                            disabled="@(_selectedRole == null)">
                        <i class="bi bi-save me-1"></i> Save Permissions
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* =========================================================================
       NO ROLE SELECTED
       ========================================================================= *@
    @if (_selectedRole == null)
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <i class="bi bi-hand-index-thumb fs-1 text-muted mb-3 d-block"></i>
                <h5>Select a role above to configure its page access</h5>
            </div>
        </div>
    }
    else
    {
        @* =========================================================================
           PERMISSION TREE — category > group > permission. Ticking a parent grants everything
           under it; a parent with only some of its permissions granted shows a partial tick.
           ========================================================================= *@
        <div class="card mb-3">
            <div class="card-header d-flex flex-wrap align-items-center gap-2">
                <span class="small text-muted">
                    Tick a parent to grant everything under it. A partly ticked parent means only some of its permissions are granted.
                </span>
                <span class="ms-auto d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnExpandAll" @onclick="ExpandAll">Expand all</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnCollapseAll" @onclick="CollapseAll">Collapse all</button>
                </span>
            </div>
            @if (_visibleTree.Count == 0)
            {
                <div class="card-body text-muted small">No pages match "@_searchText".</div>
            }
            else
            {
                <ul class="perm-tree" id="permissionTree">
                    @foreach (var root in _visibleTree)
                    {
                        <PermissionTreeNode @key="root.Id" Node="root" Depth="0" Selected="_selectedPageKeys"
                                            Collapsed="_collapsed" OnToggle="OnToggle" OnExpandToggle="OnExpandToggle" />
                    }
                </ul>
            }
        </div>

        @* =========================================================================
           SUMMARY FOOTER
           ========================================================================= *@
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <span>
                        <i class="bi bi-check-circle-fill text-success me-1"></i> @SelectedCatalogueCount of @_allPages.Count pages selected for <strong>@_selectedRole</strong>
                    </span>
                    <div>
                        <button type="button" class="btn btn-outline-primary btn-sm me-2"
                                @onclick="SelectAllPages">
                            Select All
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm"
                                @onclick="DeselectAllPages">
                            Clear All
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@* =========================================================================
   TOAST NOTIFICATION
   ========================================================================= *@
@if (_toastMessage != null)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        <div class="toast show align-items-center @(_toastIsError ? "text-bg-danger" : "text-bg-success") border-0"
             role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    @_toastMessage
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        @onclick="DismissToast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private string? _error;

    // Available roles (from Identity)
    private List<string> _roles = new();

    // The flat catalogue from the API, and the hierarchy built from it
    private List<PageDefinitionDto> _allPages = new();
    private List<PermissionNode> _tree = new();

    // What the search currently shows (the whole tree when there is no search)
    private List<PermissionNode> _visibleTree = new();

    // Branch ids the admin has collapsed
    private readonly HashSet<string> _collapsed = new();

    // Currently selected role
    private string? _selectedRole;

    // Currently selected page keys for the selected role. Stored permissions stay a flat set of keys;
    // parents are derived from it.
    private HashSet<string> _selectedPageKeys = new(StringComparer.OrdinalIgnoreCase);

    // Search text
    private string _searchText = string.Empty;

    // Toast state
    private string? _toastMessage;
    private bool _toastIsError;

    private int SelectedCatalogueCount => _allPages.Count(p => _selectedPageKeys.Contains(p.PageKey));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load roles
            var roleDtos = await AdminService.GetRolesAsync();
            if (roleDtos != null)
            {
                _roles = roleDtos.Select(r => r.Name).OrderBy(n => n).ToList();
            }

            // Load page definitions and lay them out as a tree
            _allPages = await AdminService.GetPageDefinitionsAsync() ?? new();
            _tree = PermissionTree.Build(_allPages);
            ApplySearch();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // A parent's "partly ticked" state is a DOM property with no HTML attribute, so mirror it after
    // every render (see wwwroot/js/tri-state.js).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_selectedRole != null)
        {
            await JS.InvokeVoidAsync("IntelliMedTri.sync");
        }
    }

    private async Task OnRoleChanged(ChangeEventArgs e)
    {
        var roleName = e.Value?.ToString() ?? string.Empty;
        _selectedRole = string.IsNullOrEmpty(roleName) ? null : roleName;
        _selectedPageKeys.Clear();

        if (!string.IsNullOrEmpty(roleName))
        {
            try
            {
                var perms = await AdminService.GetRolePermissionsAsync(roleName);
                if (perms?.PageKeys != null)
                {
                    foreach (var pk in perms.PageKeys)
                    {
                        _selectedPageKeys.Add(pk);
                    }
                }
            }
            catch (Exception ex)
            {
                ShowToast($"Failed to load permissions for {roleName}: {ex.Message}", true);
            }
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;
        ApplySearch();
    }

    private void ApplySearch()
    {
        _visibleTree = PermissionTree.Filter(_tree, _searchText);
    }

    private void OnToggle(PermissionTreeNode.PermissionToggle toggle)
    {
        PermissionTree.Toggle(toggle.Node, _selectedPageKeys, toggle.IsChecked);
    }

    private void OnExpandToggle(string nodeId)
    {
        if (!_collapsed.Remove(nodeId))
            _collapsed.Add(nodeId);
    }

    private void ExpandAll() => _collapsed.Clear();

    private void CollapseAll()
    {
        // Collapse every branch, keeping the categories themselves open so the groups stay visible.
        _collapsed.Clear();
        foreach (var root in _tree)
            foreach (var child in root.Children.Where(c => !c.IsLeaf))
                _collapsed.Add(child.Id);
    }

    private void SelectAllPages()
    {
        foreach (var page in _allPages)
            _selectedPageKeys.Add(page.PageKey);
    }

    private void DeselectAllPages()
    {
        _selectedPageKeys.Clear();
    }

    private async Task SavePermissionsAsync()
    {
        if (string.IsNullOrEmpty(_selectedRole)) return;

        try
        {
            var request = new SaveRolePermissionsRequest
            {
                PageKeys = _selectedPageKeys.ToList()
            };

            var result = await AdminService.SaveRolePermissionsAsync(_selectedRole, request);
            if (result?.Success == true)
            {
                ShowToast($"Permissions saved for '{_selectedRole}' ({SelectedCatalogueCount} pages).");
            }
            else
            {
                ShowToast(result?.Message ?? "Failed to save permissions.", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error saving permissions: {ex.Message}", true);
        }
    }

    private void ShowToast(string message, bool isError = false)
    {
        _toastMessage = message;
        _toastIsError = isError;
        StateHasChanged();
    }

    private void DismissToast()
    {
        _toastMessage = null;
    }

    private void NavigateBackToUsers()
    {
        Navigation.NavigateTo("/admin/users");
    }
}
