@page "/appointments/calendar"
@layout MainLayout
@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Entities
@using IntelliMed.Web.Services
@inject IAppointmentService AppointmentService
@inject IPractitionerService PractitionerService
@inject IClinicSettingsService ClinicSettingsService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Appointment Calendar - IntelliMed</PageTitle>

<style>
    .imed-calendar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }
    .imed-calendar-header h4 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        color: var(--imed-neutral-900);
    }
    .imed-calendar-header h4 i {
        color: var(--imed-primary);
    }

    .imed-practitioner-bar {
        border: none;
        border-radius: var(--imed-card-radius);
        background: linear-gradient(135deg, var(--imed-primary-light) 0%, #fff 65%);
        box-shadow: var(--imed-card-shadow);
    }
    .imed-practitioner-bar .form-check-input:checked {
        background-color: var(--imed-primary);
        border-color: var(--imed-primary);
    }
    .imed-practitioner-bar .form-check-label {
        font-weight: 500;
    }

    .imed-calendar-card {
        border: none;
        border-radius: var(--imed-card-radius);
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.08);
        overflow: hidden;
        display: flex;
        flex-direction: column;

        /* Re-theme RadzenScheduler with the app's brand palette instead of stock Material blue/gray. */
        --rz-scheduler-border-radius: var(--imed-card-radius);
        --rz-scheduler-border-color: var(--imed-neutral-300);
        --rz-scheduler-minor-border-color: #eef1f6;
        --rz-scheduler-header-background-color: var(--imed-neutral-100);
        --rz-scheduler-header-color: var(--imed-neutral-700);
        --rz-scheduler-header-font-size: 0.7rem;
        --rz-scheduler-toolbar-background-color: #fff;
        --rz-scheduler-toolbar-title-color: var(--imed-neutral-900);
        --rz-scheduler-toolbar-title-font-size: 1.15rem;
        --rz-scheduler-prev-next-button-color: var(--imed-primary);
        --rz-scheduler-today-button-padding: 0.4rem 0.9rem;
        --rz-scheduler-slot-title-font-size: 0.75rem;
        --rz-scheduler-other-month-background-color: #fafbfc;
        --rz-scheduler-highlight-background-color: rgba(66, 114, 215, 0.08);
        --rz-scheduler-event-content-padding: 0.3rem 0.5rem;
        --rz-scheduler-event-font-size: 0.78rem;
        --rz-scheduler-event-line-height: 1.2rem;
    }

    /* Appointment chips: rounded, gently shadowed, lift a bit on hover to feel clickable. */
    .imed-calendar-card .rz-event {
        border: none !important;
        border-radius: 8px !important;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.18);
        font-weight: 500;
        letter-spacing: 0.1px;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
    }
    .imed-calendar-card .rz-event:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(15, 23, 42, 0.28);
        cursor: pointer;
    }

    /* The card is a flex column reaching the bottom of the viewport; let the scheduler (and its
       own internal time-grid scroll area) fill that instead of capping at a small default height. */
    .imed-calendar-card .card-body {
        flex: 1;
        display: flex;
        min-height: 0;
    }
    .imed-calendar-card .rz-scheduler {
        flex: 1;
        min-height: 0;
    }

    /* Today / view-switch buttons pick up the brand color instead of stock Material outline. */
    .imed-calendar-card .rz-scheduler-today-button {
        background: var(--imed-primary) !important;
        color: #fff !important;
        border: none !important;
        font-weight: 600;
    }
    .imed-calendar-card .rz-selectbutton .rz-button.rz-state-active {
        background: var(--imed-primary) !important;
        border-color: var(--imed-primary) !important;
    }
</style>

<div class="imed-calendar-header">
    <h4><i class="bi bi-calendar3"></i> Appointment Calendar</h4>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => Navigation.NavigateTo($"/appointments/print?date={_lastLoadStart:yyyy-MM-dd}"))">
            <i class="bi bi-printer"></i> Print Day List
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => Navigation.NavigateTo("/appointments"))">
            <i class="bi bi-list-ul"></i> List View
        </button>
        <button class="btn btn-sm btn-primary" @onclick="@(() => Navigation.NavigateTo("/appointments/new"))">
            <i class="bi bi-plus-lg"></i> New Appointment
        </button>
    </div>
</div>

<div class="card imed-practitioner-bar mb-3">
    <div class="card-body py-2">
        <span class="small text-muted me-2"><i class="bi bi-people-fill me-1"></i>Practitioners:</span>
        @foreach (var p in _practitioners)
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="@("prac" + p.Id)" checked="@_selectedPractitionerIds.Contains(p.Id)" @onchange="@(e => TogglePractitioner(p.Id, (bool)e.Value!))" />
                <label class="form-check-label small" for="@("prac" + p.Id)">@p.FullName</label>
            </div>
        }
    </div>
</div>

<div class="card imed-calendar-card">
    <div class="card-body p-0">
        <RadzenScheduler @ref="_scheduler" TItem="SchedulerAppointmentVm" Data="@_events"
                          Style="height: calc(100vh - 280px); width: 100%;"
                          StartProperty="Start" EndProperty="End" TextProperty="Text"
                          SelectedIndex="1"
                          LoadData="@OnLoadDataAsync"
                          SlotSelect="@OnSlotSelect"
                          AppointmentSelect="@OnAppointmentSelect"
                          AppointmentMove="@OnAppointmentMoveAsync"
                          AppointmentRender="@OnAppointmentRender">
            <RadzenDayView StartTime="@_dayStart" EndTime="@_dayEnd" MinutesPerSlot="@_slotMinutes" />
            <RadzenWeekView StartTime="@_dayStart" EndTime="@_dayEnd" MinutesPerSlot="@_slotMinutes" />
            <RadzenMonthView />
        </RadzenScheduler>
    </div>
</div>

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="alert @(_statusIsError ? "alert-danger" : "alert-success") mt-2 py-2 small">@_statusMessage</div>
}

<AppointmentDetailsModal AppointmentId="_selectedAppointmentId" OnClose="CloseDetails" OnChanged="HandleAppointmentChanged" />

@code {
    private RadzenScheduler<SchedulerAppointmentVm>? _scheduler;
    private List<PractitionerDto> _practitioners = new();
    private HashSet<int> _selectedPractitionerIds = new();

    private List<AppointmentDto> _allAppointments = new();
    private List<SchedulerAppointmentVm> _events = new();
    private DateTime _lastLoadStart = DateTime.Today;
    private DateTime _lastLoadEnd = DateTime.Today;

    private readonly TimeSpan _dayStart = new(7, 0, 0);
    private readonly TimeSpan _dayEnd = new(19, 0, 0);

    // The user's own override wins; otherwise the clinic-wide default; otherwise a hardcoded fallback
    // (also what a role without clinic-settings access falls back to, since that endpoint is gated).
    private int _slotMinutes = 15;

    private string? _statusMessage;
    private bool _statusIsError;

    protected override async Task OnInitializedAsync()
    {
        _practitioners = await PractitionerService.GetAllActiveAsync();
        _selectedPractitionerIds = _practitioners.Select(p => p.Id).ToHashSet();

        var profile = await AuthService.GetMyProfileAsync();
        var clinicSettings = await ClinicSettingsService.GetAsync();
        _slotMinutes = profile?.DefaultAppointmentTimeslotMinutes ?? clinicSettings?.MinimumTimeslotMinutes ?? 15;
    }

    private async Task OnLoadDataAsync(SchedulerLoadDataEventArgs args)
    {
        _lastLoadStart = args.Start;
        _lastLoadEnd = args.End;

        var result = await AppointmentService.SearchAppointmentsAsync(new AppointmentSearchDto
        {
            FromDate = args.Start,
            ToDate = args.End,
            PageSize = 500
        });

        _allAppointments = result.Items.ToList();
        RebuildEvents();
    }

    private void TogglePractitioner(int practitionerId, bool isChecked)
    {
        if (isChecked) _selectedPractitionerIds.Add(practitionerId);
        else _selectedPractitionerIds.Remove(practitionerId);
        RebuildEvents();
    }

    private void RebuildEvents()
    {
        _events = _allAppointments
            .Where(a => _selectedPractitionerIds.Contains(a.PractitionerId))
            .Select(a => new SchedulerAppointmentVm
            {
                Start = a.AppointmentDate.Date + a.StartTime,
                End = a.AppointmentDate.Date + a.EndTime,
                Text = $"{a.StartTimeFormatted} {a.ClientName} ({a.PractitionerName})",
                Appointment = a
            }).ToList();
        StateHasChanged();
    }

    private void OnSlotSelect(SchedulerSlotSelectEventArgs args)
    {
        var practitionerId = _selectedPractitionerIds.Count == 1 ? _selectedPractitionerIds.First() : (int?)null;
        var url = $"/appointments/new?date={args.Start:yyyy-MM-dd}" + (practitionerId.HasValue ? $"&practitionerId={practitionerId}" : "");
        Navigation.NavigateTo(url);
    }

    private int? _selectedAppointmentId;

    private void OnAppointmentSelect(SchedulerAppointmentSelectEventArgs<SchedulerAppointmentVm> args)
    {
        _selectedAppointmentId = args.Data.Appointment.Id;
    }

    private void CloseDetails()
    {
        _selectedAppointmentId = null;
    }

    private async Task HandleAppointmentChanged()
    {
        if (_scheduler != null) await _scheduler.Reload();
    }

    private async Task OnAppointmentMoveAsync(SchedulerAppointmentMoveEventArgs args)
    {
        if (args.Appointment.Data is not SchedulerAppointmentVm vm) return;

        // Snap to the dropped slot and preserve the original duration, rather than trying to
        // interpret AppointmentMove's sub-slot TimeSpan offset (undocumented sign/direction).
        var duration = vm.Appointment.EndTime - vm.Appointment.StartTime;
        var newStart = args.SlotDate;

        var (success, error) = await AppointmentService.RescheduleAsync(vm.Appointment.Id, new RescheduleAppointmentDto
        {
            AppointmentDate = newStart.Date,
            StartTime = newStart.TimeOfDay,
            EndTime = newStart.TimeOfDay + duration
        });

        if (success)
        {
            _statusMessage = "Appointment rescheduled.";
            _statusIsError = false;
            if (_scheduler != null) await _scheduler.Reload();
        }
        else
        {
            _statusMessage = error ?? "Failed to reschedule.";
            _statusIsError = true;
        }
    }

    private void OnAppointmentRender(SchedulerAppointmentRenderEventArgs<SchedulerAppointmentVm> args)
    {
        // (background, text) pairs chosen for contrast — status color-coding doubles as an at-a-glance legend.
        var (bg, text) = args.Data.Appointment.Status switch
        {
            AppointmentStatus.Scheduled => ("#8b95a5", "#fff"),
            AppointmentStatus.Confirmed => ("#3aa8c1", "#fff"),
            AppointmentStatus.Arrived => ("#f5b400", "#1a1a1a"),
            AppointmentStatus.InProgress => ("#4272d7", "#fff"),
            AppointmentStatus.Completed => ("#0f9d6e", "#fff"),
            AppointmentStatus.Cancelled => ("#4b5563", "#e5e7eb"),
            AppointmentStatus.NoShow => ("#c2434f", "#fff"),
            _ => ("#8b95a5", "#fff")
        };
        args.Attributes["style"] = $"background-color: {bg}; border-color: {bg}; color: {text};";
    }

    /// <summary>Flattens an AppointmentDto into the Start/End/Text shape RadzenScheduler binds via StartProperty/EndProperty/TextProperty.</summary>
    public class SchedulerAppointmentVm
    {
        public DateTime Start { get; set; }
        public DateTime End { get; set; }
        public string Text { get; set; } = string.Empty;
        public AppointmentDto Appointment { get; set; } = null!;
    }
}
