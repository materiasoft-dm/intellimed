@page "/appointments/edit/{Id:int}"
@layout MainLayout
@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Entities
@using IntelliMed.Web.Services
@inject IAppointmentService AppointmentService
@inject NavigationManager NavManager

<PageTitle>Appointment - IntelliMed</PageTitle>

@if (_isLoading)
{
    <div class="card text-center py-3">
        <div class="card-body py-2">
            <span class="spinner-border spinner-border-sm text-primary me-2"></span>
            Loading appointment...
        </div>
    </div>
}
else if (_appointment == null)
{
    <div class="alert alert-danger">Appointment not found.</div>
}
else
{
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="mb-0">Appointment — @_appointment.ClientName</h5>
        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <span class="small @(_statusIsError ? "text-danger" : "text-success")">@_statusMessage</span>
        }
    </div>

    <div class="row g-2 mb-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header py-1"><strong>Details</strong></div>
                <div class="card-body py-2">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small mb-0">Status</label>
                            <div><span class="badge @StatusBadgeClass(_appointment.Status)">@_appointment.StatusName</span></div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Practitioner</label>
                            <div>@_appointment.PractitionerName</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Date</label>
                            <input type="date" class="form-control form-control-sm" @bind="_edit.AppointmentDate" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-0">Start</label>
                            <input type="time" class="form-control form-control-sm" value="@_edit.StartTime.ToString(@"hh\:mm")" @onchange="@(e => OnTimeChanged(e, true))" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-0">End</label>
                            <input type="time" class="form-control form-control-sm" value="@_edit.EndTime.ToString(@"hh\:mm")" @onchange="@(e => OnTimeChanged(e, false))" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-0">Notes</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="_edit.Notes"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkEditBulkBill" @bind="_edit.IsBulkBill" />
                                <label class="form-check-label small" for="chkEditBulkBill">Bulk Bill</label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-2">
                        <button type="button" class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Save Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header py-1"><strong>Visit Status</strong></div>
                <div class="card-body py-2">
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-info" disabled="@(_appointment.Status != AppointmentStatus.Scheduled)" @onclick="@(() => SetStatusAsync(AppointmentStatus.Confirmed))">Confirm</button>
                        <button type="button" class="btn btn-sm btn-outline-warning" disabled="@(_appointment.Status is AppointmentStatus.Arrived or AppointmentStatus.InProgress or AppointmentStatus.Completed or AppointmentStatus.Cancelled or AppointmentStatus.NoShow)" @onclick="@(() => SetStatusAsync(AppointmentStatus.Arrived))">Mark Arrived</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(_appointment.Status != AppointmentStatus.Arrived)" @onclick="@(() => SetStatusAsync(AppointmentStatus.InProgress))">Start</button>
                        <button type="button" class="btn btn-sm btn-outline-success" disabled="@(_appointment.Status != AppointmentStatus.InProgress)" @onclick="@(() => SetStatusAsync(AppointmentStatus.Completed))">Complete</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" disabled="@(_appointment.Status is AppointmentStatus.Completed or AppointmentStatus.Cancelled)" @onclick="@(() => SetStatusAsync(AppointmentStatus.Cancelled))">Cancel</button>
                        <button type="button" class="btn btn-sm btn-outline-dark" disabled="@(_appointment.Status is AppointmentStatus.Completed or AppointmentStatus.Cancelled or AppointmentStatus.NoShow)" @onclick="@(() => SetStatusAsync(AppointmentStatus.NoShow))">No-show</button>
                    </div>
                    <div class="row g-1 small text-muted">
                        @if (_appointment.ArrivedAt.HasValue)
                        {
                            <div class="col-6">Arrived</div>
                            <div class="col-6">@_appointment.ArrivedAt.Value.ToLocalTime().ToString("h:mm tt")</div>
                        }
                        @if (_appointment.SeenAt.HasValue)
                        {
                            <div class="col-6">Seen</div>
                            <div class="col-6">@_appointment.SeenAt.Value.ToLocalTime().ToString("h:mm tt")</div>
                        }
                        @if (_appointment.CompletedAt.HasValue)
                        {
                            <div class="col-6">Completed</div>
                            <div class="col-6">@_appointment.CompletedAt.Value.ToLocalTime().ToString("h:mm tt")</div>
                        }
                    </div>
                    @if (_appointment.Status == AppointmentStatus.Completed)
                    {
                        <div class="mt-2">
                            <button type="button" class="btn btn-sm btn-success" @onclick="StartInvoice">
                                <i class="bi bi-receipt"></i> Start Invoice
                            </button>
                        </div>
                    }
                    @if (_appointment.RecurrenceSeriesId.HasValue)
                    {
                        <div class="mt-2 small text-muted">
                            <i class="bi bi-arrow-repeat"></i> Part of a recurring series.
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="CancelSeriesAsync">Cancel this and following</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <button type="button" class="btn btn-secondary" @onclick="@(() => NavManager.NavigateTo("/appointments"))">Back to List</button>
}

@code {
    [Parameter] public int Id { get; set; }

    private AppointmentDto? _appointment;
    private UpdateAppointmentDto _edit = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _statusMessage;
    private bool _statusIsError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _appointment = await AppointmentService.GetAppointmentByIdAsync(Id);
        if (_appointment != null)
        {
            _edit = new UpdateAppointmentDto
            {
                ClientId = _appointment.ClientId,
                PractitionerId = _appointment.PractitionerId,
                AppointmentDate = _appointment.AppointmentDate,
                StartTime = _appointment.StartTime,
                EndTime = _appointment.EndTime,
                Status = _appointment.Status,
                Type = _appointment.Type,
                AppointmentTypeSettingId = _appointment.AppointmentTypeSettingId,
                Notes = _appointment.Notes,
                IsBulkBill = _appointment.IsBulkBill,
                Fee = _appointment.Fee
            };
        }
        _isLoading = false;
    }

    private void OnTimeChanged(ChangeEventArgs e, bool isStart)
    {
        if (TimeSpan.TryParse(e.Value?.ToString(), out var t))
        {
            if (isStart) _edit.StartTime = t; else _edit.EndTime = t;
        }
    }

    private void ShowStatus(string message, bool isError)
    {
        _statusMessage = message;
        _statusIsError = isError;
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        var success = await AppointmentService.UpdateAppointmentAsync(Id, _edit);
        _isSaving = false;
        if (success)
        {
            ShowStatus("Saved.", false);
            await LoadAsync();
        }
        else
        {
            ShowStatus("Failed to save changes.", true);
        }
    }

    private async Task SetStatusAsync(AppointmentStatus status)
    {
        var success = await AppointmentService.UpdateStatusAsync(Id, status);
        if (success)
        {
            ShowStatus($"Status updated to {status}.", false);
            await LoadAsync();
        }
        else
        {
            ShowStatus("Failed to update status.", true);
        }
    }

    private void StartInvoice()
    {
        if (_appointment == null) return;
        NavManager.NavigateTo($"/invoices/new?clientId={_appointment.ClientId}&appointmentId={Id}");
    }

    private async Task CancelSeriesAsync()
    {
        if (_appointment?.RecurrenceSeriesId == null) return;
        var count = await AppointmentService.DeleteSeriesAsync(_appointment.RecurrenceSeriesId.Value, _appointment.AppointmentDate);
        ShowStatus($"Cancelled {count} upcoming appointment(s) in the series.", false);
        NavManager.NavigateTo("/appointments");
    }

    private static string StatusBadgeClass(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Scheduled => "bg-secondary",
        AppointmentStatus.Confirmed => "bg-info text-dark",
        AppointmentStatus.Arrived => "bg-warning text-dark",
        AppointmentStatus.InProgress => "bg-primary",
        AppointmentStatus.Completed => "bg-success",
        AppointmentStatus.Cancelled => "bg-dark",
        AppointmentStatus.NoShow => "bg-danger",
        _ => "bg-secondary"
    };
}
