@page "/appointments/edit/{Id:int}"
@layout MainLayout
@inject NavigationManager NavManager

<PageTitle>Appointment - IntelliMed</PageTitle>

<h5 class="mb-3">Appointment Details</h5>

<AppointmentDetailsPanel AppointmentId="Id" OnClosed="@(() => NavManager.NavigateTo("/appointments"))" />

<button type="button" class="btn btn-secondary" @onclick="@(() => NavManager.NavigateTo("/appointments"))">Back to List</button>

@code {
    [Parameter] public int Id { get; set; }
}
