@page "/fee-schedules"
@layout MainLayout
@using System.ComponentModel.DataAnnotations
@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Entities
@using IntelliMed.Web.Services
@inject IFeeScheduleService FeeScheduleService
@inject IHealthFundService HealthFundService
@inject IJSRuntime JS

<PageTitle>Fee Schedules - IntelliMed</PageTitle>

<h4 class="mb-4">Fee Schedules</h4>

<div class="row">
    <div class="col-12 col-md-3">
        <div class="card mb-4">
            <div class="card-header"><strong>Filters</strong></div>
            <div class="card-body" @onkeydown="HandleFilterKeyDown">
                <div class="mb-2">
                    <label class="form-label small mb-0">Code</label>
                    <input class="form-control form-control-sm" @bind="_filter.Code" @bind:event="oninput" />
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-0">Description</label>
                    <input class="form-control form-control-sm" @bind="_filter.Description" @bind:event="oninput" />
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkIncludeArchived" @bind="_filter.IncludeArchived" />
                    <label class="form-check-label small" for="chkIncludeArchived">Include archived</label>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <button type="button" class="btn btn-primary" @onclick="FindAsync">Find</button>
                <button type="button" class="btn btn-secondary" @onclick="ClearFilters">Clear</button>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-9 mt-3 mt-md-0">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between py-2">
                <span class="small text-muted"><i class="bi bi-cash-stack me-1"></i> Total: <strong>@_totalCount</strong></span>
                <button class="btn btn-sm btn-outline-primary" @onclick="RefreshAsync">
                    <i class="bi bi-arrow-clockwise me-1"></i> Refresh
                </button>
            </div>

            <RadzenDataGrid @ref="_grid" TItem="FeeScheduleDto" Data="@_schedules" Count="@_totalCount"
                             LoadData="@LoadDataAsync" IsLoading="@_isLoading"
                             AllowPaging="true" PageSize="@_pageSize" PagerHorizontalAlign="HorizontalAlign.Center"
                             SelectionMode="DataGridSelectionMode.Single"
                             RowSelect="@(s => _selectedSchedule = s)"
                             EmptyText="No fee schedules found.">
                <Columns>
                    <RadzenDataGridColumn TItem="FeeScheduleDto" Property="Code" Title="Code" Width="100px" />
                    <RadzenDataGridColumn TItem="FeeScheduleDto" Property="Description" Title="Description" Width="220px" />
                    <RadzenDataGridColumn TItem="FeeScheduleDto" Property="Note" Title="Note" Width="160px" />
                    <RadzenDataGridColumn TItem="FeeScheduleDto" Property="HealthFundCode" Title="Health Fund" Width="110px" />
                    <RadzenDataGridColumn TItem="FeeScheduleDto" Property="FeeTableCode" Title="Fee Table" Width="100px" />
                    <RadzenDataGridColumn TItem="FeeScheduleDto" Property="RoundingTypeName" Title="Round Type" Width="120px" />
                    <RadzenDataGridColumn TItem="FeeScheduleDto" Title="Status" Width="100px">
                        <Template Context="s">
                            @if (s.IsArchived)
                            {
                                <span class="badge bg-secondary">Archived</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button class="btn btn-sm btn-primary" @onclick="OpenCreateDialog">
                <i class="bi bi-plus-lg"></i> New
            </button>
            <button class="btn btn-sm btn-outline-primary" @onclick="OpenEditDialog" disabled="@(_selectedSchedule == null)">
                <i class="bi bi-pencil"></i> Edit
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ArchiveSelectedAsync" disabled="@(_selectedSchedule == null || _selectedSchedule.IsArchived)">
                <i class="bi bi-archive"></i> Archive
            </button>
            <button class="btn btn-sm btn-outline-danger" @onclick="DeleteSelectedAsync" disabled="@(_selectedSchedule == null)">
                <i class="bi bi-trash"></i> Delete
            </button>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" aria-live="polite" aria-atomic="true">
    @if (_toastMessage != null)
    {
        <div class="toast show align-items-center @(_toastIsError ? "text-bg-danger" : "text-bg-success") border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">@_toastMessage</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="() => _toastMessage = null" aria-label="Close"></button>
            </div>
        </div>
    }
</div>

@if (_dialogVisible)
{
    <div class="modal-backdrop fade show" style="display:block;"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_isEditing ? "Edit Fee Schedule" : "New Fee Schedule")</h5>
                    <button type="button" class="btn-close" @onclick="CloseDialog" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@_dialogModel" OnValidSubmit="SaveAsync" FormName="feeScheduleDialogForm">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger small mb-3" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Code <span class="text-danger">*</span></label>
                                <InputText @bind-Value="_dialogModel.Code" class="form-control" />
                                <ValidationMessage For="() => _dialogModel.Code" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Description <span class="text-danger">*</span></label>
                                <InputText @bind-Value="_dialogModel.Description" class="form-control" />
                                <ValidationMessage For="() => _dialogModel.Description" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-12">
                                <label class="form-label">Note</label>
                                <InputText @bind-Value="_dialogModel.Note" class="form-control" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Health Fund</label>
                                <InputSelect @bind-Value="_dialogModel.HealthFundId" class="form-select">
                                    <option value="">-- None --</option>
                                    @foreach (var fund in _healthFunds)
                                    {
                                        <option value="@fund.Id">@fund.Code - @fund.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fee Table</label>
                                <InputSelect @bind-Value="_dialogModel.FeeTableId" class="form-select">
                                    <option value="">-- None --</option>
                                    @foreach (var schedule in _feeTableOptions)
                                    {
                                        <option value="@schedule.Id">@schedule.Code - @schedule.Description</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Round Type</label>
                                <InputSelect @bind-Value="_dialogModel.RoundingType" class="form-select">
                                    <option value="@RoundingTypeEnum.Exact">Exact</option>
                                    <option value="@RoundingTypeEnum.ToNearest1c">To Nearest 1c</option>
                                    <option value="@RoundingTypeEnum.ToNearest5c">To Nearest 5c</option>
                                </InputSelect>
                            </div>
                        </div>

                        @if (_isEditing)
                        {
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       checked="@(!_dialogModel.IsArchived)"
                                       @onchange="(ChangeEventArgs e) => _dialogModel.IsArchived = !(bool)e.Value!"
                                       id="feeScheduleActiveSwitch" />
                                <label class="form-check-label" for="feeScheduleActiveSwitch">Active</label>
                            </div>
                        }

                        <div class="modal-footer px-0 pb-0">
                            <button type="button" class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@_dialogSaving">
                                @if (_dialogSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span>@(_isEditing ? "Save Changes" : "Create")</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private RadzenDataGrid<FeeScheduleDto>? _grid;
    private List<FeeScheduleDto> _schedules = new();
    private FeeScheduleDto? _selectedSchedule;
    private int _totalCount;
    private bool _isLoading;
    private int _pageSize = 10;

    private FeeScheduleSearchDto _filter = new();
    private List<HealthFundDto> _healthFunds = new();
    private List<FeeScheduleDto> _feeTableOptions = new();

    private bool _dialogVisible;
    private bool _isEditing;
    private bool _dialogSaving;
    private int _editingId;
    private FeeScheduleDialogModel _dialogModel = new();

    private string? _toastMessage;
    private bool _toastIsError;

    protected override async Task OnInitializedAsync()
    {
        _healthFunds = (await HealthFundService.GetAllActiveAsync()).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _grid != null)
        {
            await _grid.Reload();
        }
    }

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        _isLoading = true;
        try
        {
            _filter.Page = (args.Skip ?? 0) / _pageSize + 1;
            _filter.PageSize = _pageSize;

            var result = await FeeScheduleService.SearchFeeSchedulesAsync(_filter);
            _schedules = result.Items.ToList();
            _totalCount = result.TotalCount;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task FindAsync()
    {
        await LoadDataAsync(new LoadDataArgs { Skip = 0, Top = _pageSize });
        if (_grid != null)
        {
            await _grid.GoToPage(0);
        }
    }

    private async Task HandleFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await FindAsync();
        }
    }

    private async Task RefreshAsync()
    {
        if (_grid != null)
        {
            await _grid.Reload();
        }
    }

    private void ClearFilters()
    {
        _filter = new FeeScheduleSearchDto();
    }

    private async Task OpenCreateDialog()
    {
        _isEditing = false;
        _dialogModel = new FeeScheduleDialogModel();
        _dialogSaving = false;
        _feeTableOptions = (await FeeScheduleService.GetAllActiveAsync());
        _dialogVisible = true;
    }

    private async Task OpenEditDialog()
    {
        if (_selectedSchedule == null) return;

        _isEditing = true;
        _editingId = _selectedSchedule.Id;
        _dialogModel = new FeeScheduleDialogModel
        {
            Code = _selectedSchedule.Code,
            Description = _selectedSchedule.Description,
            Note = _selectedSchedule.Note,
            HealthFundId = _selectedSchedule.HealthFundId,
            FeeTableId = _selectedSchedule.FeeTableId,
            RoundingType = _selectedSchedule.RoundingType,
            IsArchived = _selectedSchedule.IsArchived
        };
        _dialogSaving = false;
        // Exclude self from the Fee Table options — a schedule can't borrow rates from itself.
        _feeTableOptions = (await FeeScheduleService.GetAllActiveAsync())
            .Where(s => s.Id != _editingId)
            .ToList();
        _dialogVisible = true;
    }

    private void CloseDialog()
    {
        _dialogVisible = false;
    }

    private async Task SaveAsync()
    {
        _dialogSaving = true;
        try
        {
            bool success;
            if (_isEditing)
            {
                success = await FeeScheduleService.UpdateFeeScheduleAsync(_editingId, new UpdateFeeScheduleDto
                {
                    Code = _dialogModel.Code,
                    Description = _dialogModel.Description,
                    Note = _dialogModel.Note,
                    HealthFundId = _dialogModel.HealthFundId,
                    FeeTableId = _dialogModel.FeeTableId,
                    RoundingType = _dialogModel.RoundingType,
                    IsArchived = _dialogModel.IsArchived
                });
            }
            else
            {
                success = await FeeScheduleService.CreateFeeScheduleAsync(new CreateFeeScheduleDto
                {
                    Code = _dialogModel.Code,
                    Description = _dialogModel.Description,
                    Note = _dialogModel.Note,
                    HealthFundId = _dialogModel.HealthFundId,
                    FeeTableId = _dialogModel.FeeTableId,
                    RoundingType = _dialogModel.RoundingType
                }) != null;
            }

            if (success)
            {
                ShowToast(_isEditing ? "Fee schedule updated." : "Fee schedule created.", false);
                _dialogVisible = false;
                _selectedSchedule = null;
                await RefreshAsync();
            }
            else
            {
                ShowToast("Failed to save fee schedule.", true);
            }
        }
        finally
        {
            _dialogSaving = false;
        }
    }

    private async Task ArchiveSelectedAsync()
    {
        if (_selectedSchedule == null) return;

        var success = await FeeScheduleService.ArchiveFeeScheduleAsync(_selectedSchedule.Id);
        ShowToast(success ? "Fee schedule archived." : "Failed to archive fee schedule.", !success);
        if (success)
        {
            _selectedSchedule = null;
            await RefreshAsync();
        }
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selectedSchedule == null) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete fee schedule '{_selectedSchedule.Code}'? This cannot be undone.");
        if (!confirmed) return;

        var success = await FeeScheduleService.DeleteFeeScheduleAsync(_selectedSchedule.Id);
        ShowToast(success ? "Fee schedule deleted." : "Failed to delete fee schedule.", !success);
        if (success)
        {
            _selectedSchedule = null;
            await RefreshAsync();
        }
    }

    private void ShowToast(string message, bool isError)
    {
        _toastMessage = message;
        _toastIsError = isError;
    }

    private class FeeScheduleDialogModel
    {
        [Required]
        public string Code { get; set; } = string.Empty;
        [Required]
        public string Description { get; set; } = string.Empty;
        public string? Note { get; set; }
        public int? HealthFundId { get; set; }
        public int? FeeTableId { get; set; }
        public RoundingTypeEnum RoundingType { get; set; } = RoundingTypeEnum.Exact;
        public bool IsArchived { get; set; }
    }
}
