@page "/forgot-password"
@layout PublicLayout

@using System.ComponentModel.DataAnnotations
@using IntelliMed.Web.Services
@inject IAuthService AuthService

<div class="public-auth-container">
    <div class="public-auth-card">
        <div class="text-center mb-4">
            <i class="bi bi-hospital brand-icon-sm"></i>
            <h4 class="mt-2 mb-1">Forgot Password</h4>
            <p class="text-muted small">Enter your email and we'll send you a link to reset your password.</p>
        </div>

        @if (_submitted)
        {
            <div class="alert alert-success d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-2"></i>
                <div>If that account exists, a password reset email has been sent.</div>
            </div>
            <a href="/login" class="btn btn-primary w-100">Back to Sign In</a>
        }
        else
        {
            <EditForm Model="@_model" OnValidSubmit="HandleSubmit" FormName="forgotPasswordForm">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger small mb-3" />

                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <InputText @bind-Value="_model.Email" class="form-control" placeholder="name@clinic.com" />
                    <ValidationMessage For="() => _model.Email" />
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send Reset Link</span>
                    }
                </button>

                <div class="text-center mt-3">
                    <a href="/login" class="small">Back to Sign In</a>
                </div>
            </EditForm>
        }
    </div>
</div>

<style>
    .public-auth-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(180deg, var(--imed-neutral-100) 0%, #ffffff 100%);
        padding: 2rem;
    }

    .public-auth-card {
        width: 100%;
        max-width: 420px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 2rem;
    }

    .brand-icon-sm {
        font-size: 2rem;
        color: var(--imed-primary);
    }
</style>

@code {
    private ForgotPasswordModel _model = new();
    private bool _isSubmitting;
    private bool _submitted;

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        try
        {
            await AuthService.ForgotPasswordAsync(_model.Email);
            _submitted = true;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private class ForgotPasswordModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
