@page "/invoices/new"
@layout MainLayout
@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Entities
@using IntelliMed.Web.Services
@inject IInvoiceService InvoiceService
@inject IClientService ClientService
@inject IPractitionerService PractitionerService
@inject IBillingItemService BillingItemService
@inject IFeeScheduleService FeeScheduleService
@inject NavigationManager NavManager

<PageTitle>New Invoice - IntelliMed</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-1">
    <h5 class="mb-0 small">🧾 New Invoice</h5>
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <span class="small @(_statusIsError ? "text-danger" : "text-success")">@_statusMessage</span>
    }
</div>

<div class="card mb-2">
    <div class="card-header py-1"><strong>Account Type</strong></div>
    <div class="card-body py-2">
        <ul class="nav nav-pills gap-1">
            @foreach (var type in Enum.GetValues<AccountTypeEnum>())
            {
                <li class="nav-item">
                    <a class="nav-link py-1 px-2 small @(_model.AccountType == type ? "active" : "")" href="javascript:void(0)" @onclick="@(() => SelectAccountTypeAsync(type))">@AccountTypeLabel(type)</a>
                </li>
            }
        </ul>
        <div class="small text-muted mt-2">Fees and the Medicare rebate are resolved from the account type's mapped fee schedule (configure in Clinic Settings). Fee is editable inline.</div>
    </div>
</div>

<div class="row g-2 mb-2">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header py-1"><strong>Details</strong></div>
            <div class="card-body py-2">
                <div class="row g-2">
                    <div class="col-12">
                        <label class="form-label small mb-0">Client</label>
                        <div class="input-group input-group-sm">
                            <input class="form-control form-control-sm" value="@_clientDisplayName" readonly placeholder="No client selected" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="OpenClientPicker">Find</button>
                        </div>
                    </div>
                    <div class="col-3">
                        <label class="form-label small mb-0">Provider</label>
                        <select class="form-select form-select-sm" @bind="_model.PractitionerId" @bind:after="RecalculateAllLinesAsync">
                            <option value="">-- None --</option>
                            @foreach (var p in _practitioners)
                            {
                                <option value="@p.Id">@p.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="col-3">
                        <label class="form-label small mb-0" title="Who receives the Medicare/DVA/fund payment, if different from the servicing Provider">Payee</label>
                        <select class="form-select form-select-sm" @bind="_model.PayeePractitionerId">
                            <option value="">-- Same as Provider --</option>
                            @foreach (var p in _practitioners)
                            {
                                <option value="@p.Id">@p.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="col-3">
                        <label class="form-label small mb-0">Place of Service</label>
                        <select class="form-select form-select-sm" @bind="_model.PlaceOfService" @bind:after="RecalculateAllLinesAsync">
                            @foreach (var place in Enum.GetValues<PlaceOfServiceEnum>())
                            {
                                <option value="@place">@place</option>
                            }
                        </select>
                    </div>
                    <div class="col-3">
                        <label class="form-label small mb-0">Due Date</label>
                        <input type="date" class="form-control form-control-sm" @bind="_model.DueDate" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small mb-0">Notes</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="_model.Notes"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header py-1"><strong>Payment</strong></div>
            <div class="card-body py-2">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="chkPayNow" @bind="_recordPaymentNow" />
                    <label class="form-check-label small" for="chkPayNow">Record full payment now</label>
                </div>
                @if (_recordPaymentNow)
                {
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small mb-0">Method</label>
                            <select class="form-select form-select-sm" @bind="_paymentMethod">
                                @foreach (var method in Enum.GetValues<PaymentMethod>())
                                {
                                    <option value="@method">@method</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Amount</label>
                            <input class="form-control form-control-sm" value="@_total.ToString("C")" readonly />
                        </div>
                    </div>
                }
                else
                {
                    <div class="small text-muted">Invoice will be saved as Draft with no payment recorded.</div>
                }
            </div>
        </div>
    </div>
</div>

@if (AnyConsentFieldsApplicable(_model.AccountType))
{
    <div class="card mb-2">
        <div class="card-header py-1"><strong>Consent &amp; Claiming</strong></div>
        <div class="card-body py-2">
            <div class="row g-2">
                @if (_model.AccountType is not (AccountTypeEnum.WorkCover or AccountTypeEnum.Tac or AccountTypeEnum.Other))
                {
                    <div class="col-auto form-check">
                        <input class="form-check-input" type="checkbox" id="chkClaimSubmissionAuthorised" @bind="_model.ClaimSubmissionAuthorised" />
                        <label class="form-check-label small" for="chkClaimSubmissionAuthorised">Online Submission Authorised</label>
                    </div>
                }
                @if (_model.AccountType is AccountTypeEnum.Imc or AccountTypeEnum.Ovs)
                {
                    <div class="col-auto form-check">
                        <input class="form-check-input" type="checkbox" id="chkFinancialInterestDisclosed" @bind="_model.FinancialInterestDisclosed" />
                        <label class="form-check-label small" for="chkFinancialInterestDisclosed">Financial Interest Disclosed</label>
                    </div>
                    <div class="col-auto form-check">
                        <input class="form-check-input" type="checkbox" id="chkCompensationClaim" @bind="_model.CompensationClaim" />
                        <label class="form-check-label small" for="chkCompensationClaim">Compensation Claim</label>
                    </div>
                }
                @if (_model.AccountType == AccountTypeEnum.BulkBill)
                {
                    <div class="col-auto form-check">
                        <input class="form-check-input" type="checkbox" id="chkSubmissionAuthorityReceived" @bind="_model.SubmissionAuthorityReceived" />
                        <label class="form-check-label small" for="chkSubmissionAuthorityReceived">Submission Authority Form Received (DB4)</label>
                    </div>
                }
                @if (_model.AccountType == AccountTypeEnum.Imc)
                {
                    <div class="col-auto form-check">
                        <input class="form-check-input" type="checkbox" id="chkBenefitAssignmentRequested" @bind="_model.BenefitAssignmentRequested" />
                        <label class="form-check-label small" for="chkBenefitAssignmentRequested" title="Unticked = implied assignment (default). Ticked = requested assignment.">Assignment Requested</label>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="card mb-2">
    <div class="card-header py-1 d-flex justify-content-between align-items-center">
        <strong>Line Items</strong>
        <div>
            <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="@(() => OpenBillingItemPicker())">+ Add Item</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddCustomLine">+ Add Custom Line</button>
        </div>
    </div>
    <div class="card-body py-2">
        @if (_items.Count == 0)
        {
            <div class="text-muted small">No line items yet. Use "Add Item" to pick from the billing catalog, or "Add Custom Line" for a free-text charge.</div>
        }
        else
        {
            <table class="table table-sm mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width:60px">Item#</th>
                        <th>Description</th>
                        <th style="width:120px">Service Date</th>
                        <th style="width:140px" title="Overrides the invoice's account-type-mapped schedule for this line only">Schedule</th>
                        <th style="width:55px">Qty</th>
                        <th style="width:95px">Fee</th>
                        <th style="width:90px" class="text-end">Rebate</th>
                        <th style="width:90px">Discount</th>
                        <th style="width:80px" title="For derived-item rules (patients seen, minutes, fields, units) — see Derived Item Rules">D.Qty</th>
                        <th style="width:90px" class="text-end">Gap</th>
                        <th style="width:95px" class="text-end">Total</th>
                        <th style="width:36px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td>
                                <a href="javascript:void(0)" class="link-primary" title="Change billing item" @onclick="() => OpenBillingItemPicker(item)">@item.ItemNumberDisplay</a>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <input class="form-control form-control-sm" @bind="item.Description" />
                                    <button type="button" class="btn btn-sm p-0 border-0 @(string.IsNullOrWhiteSpace(item.Note) ? "text-muted" : "text-primary")"
                                            title="@(string.IsNullOrWhiteSpace(item.Note) ? "No note" : item.Note)"
                                            @onclick="() => OpenNoteEditor(item)">
                                        <i class="bi bi-info-circle"></i>
                                    </button>
                                </div>
                            </td>
                            <td><input type="date" class="form-control form-control-sm" @bind="item.ServiceDate" /></td>
                            <td>
                                <select class="form-select form-select-sm" @bind="item.FeeScheduleId" @bind:after="() => ResolveLineAsync(item)">
                                    <option value="">-- Default --</option>
                                    @foreach (var schedule in _feeSchedules)
                                    {
                                        <option value="@schedule.Id">@schedule.Code - @schedule.Description</option>
                                    }
                                </select>
                            </td>
                            <td><input type="number" min="1" class="form-control form-control-sm" @bind="item.Quantity" /></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm" @bind="item.UnitPrice" /></td>
                            <td class="text-end">@item.LineRebate.ToString("C")</td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm" @bind="item.Discount" /></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm" @bind="item.DerivedQuantity" /></td>
                            <td class="text-end @(item.Gap > 0 ? "text-danger" : "")">@item.Gap.ToString("C")</td>
                            <td class="text-end">@item.LineTotal.ToString("C")</td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => _items.Remove(item)">x</button></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="5" class="text-end">Totals</td>
                        <td class="text-end">@_totalRebate.ToString("C")</td>
                        <td></td>
                        <td></td>
                        <td class="text-end">@_totalGap.ToString("C")</td>
                        <td class="text-end">@_total.ToString("C")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
</div>

<div class="d-flex justify-content-end gap-2">
    <button type="button" class="btn btn-secondary" @onclick="@(() => NavManager.NavigateTo("/invoices"))">Cancel</button>
    <button type="button" class="btn btn-primary" disabled="@_isSaving" @onclick="SaveAsync">
        @if (_isSaving)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
        }
        💾 Save
    </button>
</div>

<FindClientModal @bind-Visible="_showClientPickerModal" OnSelected="OnClientSelected" />

@if (_showBillingItemPickerModal)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">Find Billing Item</h6>
                    <button type="button" class="btn-close" @onclick="@(() => _showBillingItemPickerModal = false)"></button>
                </div>
                <div class="modal-body">
                    <input class="form-control form-control-sm mb-2" placeholder="Search by item number or description..."
                           @bind="_billingItemSearchTerm" @bind:event="oninput" @bind:after="SearchBillingItemCandidatesAsync" />
                    <div style="max-height: 300px; overflow-y: auto;">
                        @if (_billingItemSearchResults.Count == 0)
                        {
                            <div class="text-muted small">No matches. Try "Update Fees &amp; Bill Items" on Clinic Settings if the catalog hasn't been synced yet.</div>
                        }
                        else
                        {
                            <ul class="list-group">
                                @foreach (var candidate in _billingItemSearchResults)
                                {
                                    <li class="list-group-item list-group-item-action" style="cursor:pointer" @onclick="@(() => SelectBillingItem(candidate))">
                                        <strong>@candidate.ItemNumber</strong> — @candidate.Description
                                        <span class="text-muted small">(@FeeHint(candidate))</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="@(() => _showBillingItemPickerModal = false)">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showNoteModal)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">Line Note</h6>
                    <button type="button" class="btn-close" @onclick="@(() => _showNoteModal = false)"></button>
                </div>
                <div class="modal-body">
                    <textarea class="form-control form-control-sm" rows="4" placeholder="Add a note for this line item..." @bind="_noteDraft"></textarea>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="@(() => _showNoteModal = false)">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="SaveNote">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] public int? ClientId { get; set; }
    [SupplyParameterFromQuery] public int? AppointmentId { get; set; }

    private CreateInvoiceDto _model = new() { DueDate = DateTime.Today.AddDays(14) };
    private List<LineItemRow> _items = new();
    private decimal _total => _items.Sum(i => i.LineTotal);
    private decimal _totalRebate => _items.Sum(i => i.LineRebate);
    private decimal _totalGap => _items.Sum(i => i.Gap);

    private string? _clientDisplayName;
    private int? _selectedHealthFundId;
    private bool _accountTypeManuallySet;
    private bool _showClientPickerModal;

    private List<PractitionerDto> _practitioners = new();
    private List<FeeScheduleDto> _feeSchedules = new();

    private bool _showBillingItemPickerModal;
    private LineItemRow? _editingRow;
    private string _billingItemSearchTerm = string.Empty;
    private List<BillingItemDto> _billingItemSearchResults = new();

    private bool _showNoteModal;
    private LineItemRow? _noteEditingRow;
    private string _noteDraft = string.Empty;

    private bool _recordPaymentNow;
    private PaymentMethod _paymentMethod = PaymentMethod.Cash;

    private bool _isSaving;
    private string? _statusMessage;
    private bool _statusIsError;

    protected override async Task OnInitializedAsync()
    {
        _practitioners = await PractitionerService.GetAllActiveAsync();
        _feeSchedules = await FeeScheduleService.GetAllActiveAsync();

        if (AppointmentId.HasValue) _model.AppointmentId = AppointmentId.Value;
        if (ClientId.HasValue)
        {
            var client = await ClientService.GetClientByIdAsync(ClientId.Value);
            if (client != null)
            {
                _model.ClientId = client.Id;
                _model.AccountType = client.AccountType;
                _accountTypeManuallySet = true;
                _clientDisplayName = client.FullName;
                _selectedHealthFundId = client.HealthFundId;
                await RecalculateAllLinesAsync();
            }
        }
    }

    private static string AccountTypeLabel(AccountTypeEnum type) => type switch
    {
        AccountTypeEnum.BulkBill => "BB",
        AccountTypeEnum.PrivatePatient => "Private Patient",
        AccountTypeEnum.Veteran => "DVA",
        AccountTypeEnum.WorkCover => "WorkCover",
        AccountTypeEnum.Tac => "TAC",
        AccountTypeEnum.Imc => "IMC",
        AccountTypeEnum.Ovs => "OVS",
        AccountTypeEnum.ChildImm => "Immunisation",
        _ => type.ToString()
    };

    /// <summary>WorkCover/Tac/Other are the only account types where none of the five consent
    /// checkboxes apply (see each checkbox's own @if gate below) — hide the whole card for those
    /// rather than render an empty one.</summary>
    private static bool AnyConsentFieldsApplicable(AccountTypeEnum type) =>
        type is not (AccountTypeEnum.WorkCover or AccountTypeEnum.Tac or AccountTypeEnum.Other);

    private void OpenClientPicker()
    {
        _showClientPickerModal = true;
    }

    private async Task OnClientSelected(ClientDto candidate)
    {
        _model.ClientId = candidate.Id;
        // Prefill the account type from the client's stored default, but only if the user
        // hasn't already made an explicit choice — otherwise this would silently override it.
        if (!_accountTypeManuallySet)
            _model.AccountType = candidate.AccountType;
        _clientDisplayName = candidate.FullName;
        _selectedHealthFundId = candidate.HealthFundId;
        await RecalculateAllLinesAsync();
    }

    private async Task SelectAccountTypeAsync(AccountTypeEnum type)
    {
        _model.AccountType = type;
        _accountTypeManuallySet = true;
        await RecalculateAllLinesAsync();
    }

    /// <summary>Opens the picker to add a new line. Pass an existing row to instead change that row's billing item in place.</summary>
    private void OpenBillingItemPicker(LineItemRow? editingRow = null)
    {
        _editingRow = editingRow;
        _billingItemSearchTerm = string.Empty;
        _billingItemSearchResults = new();
        _showBillingItemPickerModal = true;
    }

    private async Task SearchBillingItemCandidatesAsync()
    {
        _billingItemSearchResults = await BillingItemService.SearchAsync(_billingItemSearchTerm);
    }

    private async Task SelectBillingItem(BillingItemDto candidate)
    {
        LineItemRow row;
        if (_editingRow != null)
        {
            row = _editingRow;
            row.BillingItemId = candidate.Id;
            row.ItemNumberDisplay = candidate.ItemNumber;
            row.Description = candidate.Description;
            row.UnitPrice = candidate.ScheduleFee;
        }
        else
        {
            row = new LineItemRow
            {
                BillingItemId = candidate.Id,
                ItemNumberDisplay = candidate.ItemNumber,
                Description = candidate.Description,
                ServiceDate = DateTime.Today,
                Quantity = 1,
                UnitPrice = candidate.ScheduleFee
            };
            _items.Add(row);
        }

        _editingRow = null;
        _showBillingItemPickerModal = false;
        await ResolveLineAsync(row);
    }

    private string FeeHint(BillingItemDto candidate) => $"Schedule: {candidate.ScheduleFee:C}";

    /// <summary>Resolve a catalog line's fee + rebate from the server for the current billing context.</summary>
    private async Task ResolveLineAsync(LineItemRow row)
    {
        if (row.BillingItemId == null) return;

        var result = await InvoiceService.ResolveLineAsync(new ResolveLineRequest
        {
            AccountType = _model.AccountType,
            PractitionerId = _model.PractitionerId,
            PlaceOfService = _model.PlaceOfService,
            BillingItemId = row.BillingItemId.Value,
            ServiceDate = row.ServiceDate,
            HealthFundId = _selectedHealthFundId,
            FeeScheduleId = row.FeeScheduleId
        });

        if (result != null)
        {
            row.UnitPrice = result.Fee;
            row.RebatePerUnit = result.RebatePerUnit;
            if (string.IsNullOrWhiteSpace(row.Description))
                row.Description = result.Description;
        }
    }

    /// <summary>Re-resolve every catalog line when the account type, provider or place of service changes.</summary>
    private async Task RecalculateAllLinesAsync()
    {
        foreach (var row in _items.Where(i => i.BillingItemId.HasValue))
            await ResolveLineAsync(row);
    }

    private void AddCustomLine()
    {
        _items.Add(new LineItemRow
        {
            ItemNumberDisplay = "-",
            Description = string.Empty,
            ServiceDate = DateTime.Today,
            Quantity = 1,
            UnitPrice = 0
        });
    }

    private async Task SaveAsync()
    {
        if (_model.ClientId == 0)
        {
            ShowStatus("Select a client first.", true);
            return;
        }
        if (_items.Count == 0)
        {
            ShowStatus("Add at least one line item.", true);
            return;
        }

        _isSaving = true;
        try
        {
            _model.Items = _items.Select(i => new CreateInvoiceItemDto
            {
                BillingItemId = i.BillingItemId,
                FeeScheduleId = i.FeeScheduleId,
                Description = i.Description,
                ServiceDate = i.ServiceDate,
                Quantity = i.Quantity,
                UnitPrice = i.UnitPrice,
                Discount = i.Discount,
                DerivedQuantity = i.DerivedQuantity,
                Note = i.Note
            }).ToList();

            var id = await InvoiceService.CreateInvoiceAsync(_model);
            if (id == null)
            {
                ShowStatus("Failed to save invoice.", true);
                return;
            }

            if (_recordPaymentNow)
            {
                await InvoiceService.AddPaymentAsync(id.Value, new CreatePaymentDto
                {
                    Amount = _total,
                    Method = _paymentMethod,
                    PaymentDate = DateTime.Today
                });
            }

            NavManager.NavigateTo($"/invoices/edit/{id.Value}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ShowStatus(string message, bool isError)
    {
        _statusMessage = message;
        _statusIsError = isError;
    }

    private void OpenNoteEditor(LineItemRow row)
    {
        _noteEditingRow = row;
        _noteDraft = row.Note ?? string.Empty;
        _showNoteModal = true;
    }

    private void SaveNote()
    {
        if (_noteEditingRow != null)
        {
            _noteEditingRow.Note = string.IsNullOrWhiteSpace(_noteDraft) ? null : _noteDraft;
        }
        _showNoteModal = false;
    }

    private class LineItemRow
    {
        public int? BillingItemId { get; set; }

        /// <summary>Per-line fee schedule override — null uses the invoice-level default (account type mapping).</summary>
        public int? FeeScheduleId { get; set; }

        public string ItemNumberDisplay { get; set; } = "-";
        public string Description { get; set; } = string.Empty;
        public DateTime? ServiceDate { get; set; }
        public int Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal RebatePerUnit { get; set; }
        public decimal Discount { get; set; }
        public decimal? DerivedQuantity { get; set; }
        public string? Note { get; set; }

        public decimal LineRebate => RebatePerUnit * Quantity;
        public decimal LineTotal => UnitPrice * Quantity - Discount;
        public decimal Gap => LineTotal - LineRebate;
    }
}
