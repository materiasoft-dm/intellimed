@page "/address-book"
@layout MainLayout
@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Entities
@using IntelliMed.Web.Services
@inject IAddressBookService AddressBookService
@inject IClinicService ClinicService

<PageTitle>Address Book - IntelliMed</PageTitle>

<h4 class="mb-1">Address Book</h4>
<p class="text-muted small mb-3">
    GPs, specialists and other providers the practice refers to and receives referrals from. Organisations
    (employers, companies that pay for their staff) are clients of type Organisation; a contact's workplace is
    a clinic or hospital from Clinic Manager.
</p>

<div class="card">
    <div class="card-header d-flex flex-wrap align-items-center gap-2 py-2">
        <div class="input-group input-group-sm" style="max-width: 360px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input class="form-control" placeholder="Search name, provider number, speciality..."
                   @bind="_query" @bind:event="oninput" @bind:after="SearchAsync" />
        </div>
        <div class="form-check form-check-inline small mb-0">
            <input class="form-check-input" type="checkbox" id="chkShowArchived" @bind="_includeArchived" @bind:after="SearchAsync" />
            <label class="form-check-label" for="chkShowArchived">Show archived</label>
        </div>
        <span class="small text-muted ms-auto">@_totalCount contact@(_totalCount == 1 ? "" : "s")</span>
        <button class="btn btn-sm btn-primary" @onclick="OpenNew"><i class="bi bi-plus-lg me-1"></i> New Contact</button>
    </div>
    @if (_loading)
    {
        <div class="card-body text-muted small">Loading...</div>
    }
    else if (_contacts.Count == 0)
    {
        <div class="card-body text-muted small">No contacts found.</div>
    }
    else
    {
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Profession / Speciality</th>
                    <th>Provider#</th>
                    <th>Workplace</th>
                    <th>Phone</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _contacts)
                {
                    <tr class="@(c.IsArchived ? "text-muted" : "")">
                        <td><a href="javascript:void(0)" class="link-primary" @onclick="() => OpenEdit(c)">@c.FullName</a></td>
                        <td>@(string.Join(" · ", new[] { c.Profession, c.Speciality }.Where(s => !string.IsNullOrWhiteSpace(s))))</td>
                        <td>@c.ProviderNumber</td>
                        <td>
                            @c.ClinicName
                            @if (c.ClinicType == ClinicType.Hospital)
                            {
                                <span class="badge bg-secondary ms-1">Hospital</span>
                            }
                        </td>
                        <td>@c.Phone</td>
                        <td class="text-end">
                            @if (c.IsArchived)
                            {
                                <span class="badge bg-secondary">Archived</span>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" title="Archive" @onclick="() => ArchiveAsync(c)"><i class="bi bi-archive"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (!string.IsNullOrEmpty(_toastMessage))
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
        <div class="toast show align-items-center @(_toastIsError ? "text-bg-danger" : "text-bg-success") border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">@_toastMessage</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="() => _toastMessage = null" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

@if (_showDialog)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">@(_editingId.HasValue ? "Edit Contact" : "New Contact")</h6>
                    <button type="button" class="btn-close" @onclick="@(() => _showDialog = false)"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Title</label>
                            <input class="form-control form-control-sm" @bind="_form.Title" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small mb-0">First Name</label>
                            <input class="form-control form-control-sm" @bind="_form.FirstName" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small mb-0">Last Name</label>
                            <input class="form-control form-control-sm" @bind="_form.LastName" @bind:event="oninput" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-0">Profession</label>
                            <input class="form-control form-control-sm" placeholder="e.g. GP, Specialist" @bind="_form.Profession" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-0">Speciality</label>
                            <input class="form-control form-control-sm" @bind="_form.Speciality" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-0">Provider Number</label>
                            <input class="form-control form-control-sm" @bind="_form.ProviderNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-0">Workplace</label>
                            <select class="form-select form-select-sm" @bind="_form.ClinicId">
                                <option value="">— None —</option>
                                @foreach (var clinic in _clinics)
                                {
                                    <option value="@clinic.Id">@clinic.Name@(clinic.Type == ClinicType.Hospital ? " (Hospital)" : "")</option>
                                }
                            </select>
                            <div class="form-text small">Add a clinic or hospital in Clinic Manager first if it isn't listed.</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small mb-0">Phone</label>
                            <input class="form-control form-control-sm" @bind="_form.Phone" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small mb-0">Mobile</label>
                            <input class="form-control form-control-sm" @bind="_form.Mobile" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small mb-0">Fax</label>
                            <input class="form-control form-control-sm" @bind="_form.Fax" />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label small mb-0">Email</label>
                            <input class="form-control form-control-sm" @bind="_form.Email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-0">Address</label>
                            <input class="form-control form-control-sm" @bind="_form.Address" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small mb-0">Suburb</label>
                            <input class="form-control form-control-sm" @bind="_form.Suburb" />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small mb-0">State</label>
                            <input class="form-control form-control-sm" @bind="_form.State" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Postcode</label>
                            <input class="form-control form-control-sm" @bind="_form.Postcode" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-0">Notes</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="_form.Notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="@(() => _showDialog = false)">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" disabled="@(_saving || string.IsNullOrWhiteSpace(_form.LastName))" @onclick="SaveAsync">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AddressBookContactDto> _contacts = new();
    private List<MyClinicDto> _clinics = new();
    private int _totalCount;
    private string _query = string.Empty;
    private bool _includeArchived;
    private bool _loading = true;

    private bool _showDialog;
    private bool _saving;
    private int? _editingId;
    private SaveAddressBookContactDto _form = new();

    private string? _toastMessage;
    private bool _toastIsError;

    protected override async Task OnInitializedAsync()
    {
        _clinics = await ClinicService.GetLookupAsync() ?? new();
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _loading = true;
        var result = await AddressBookService.SearchAsync(new AddressBookSearchDto
        {
            Query = _query,
            IncludeArchived = _includeArchived,
            PageSize = 100
        });
        _contacts = result.Items.ToList();
        _totalCount = result.TotalCount;
        _loading = false;
    }

    private void OpenNew()
    {
        _form = new SaveAddressBookContactDto();
        _editingId = null;
        _showDialog = true;
    }

    private void OpenEdit(AddressBookContactDto c)
    {
        _form = new SaveAddressBookContactDto
        {
            Title = c.Title, FirstName = c.FirstName, LastName = c.LastName,
            Profession = c.Profession, Speciality = c.Speciality, ProviderNumber = c.ProviderNumber,
            Phone = c.Phone, Mobile = c.Mobile, Fax = c.Fax, Email = c.Email,
            Address = c.Address, Suburb = c.Suburb, Postcode = c.Postcode, State = c.State,
            ClinicId = c.ClinicId, Notes = c.Notes
        };
        _editingId = c.Id;
        _showDialog = true;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        bool ok;
        if (_editingId.HasValue)
        {
            ok = await AddressBookService.UpdateAsync(_editingId.Value, _form);
        }
        else
        {
            ok = await AddressBookService.CreateAsync(_form) != null;
        }
        _saving = false;

        ShowToast(ok ? (_editingId.HasValue ? "Contact updated." : "Contact added.") : "Failed to save contact.", !ok);
        if (ok)
        {
            _showDialog = false;
            await SearchAsync();
        }
    }

    private async Task ArchiveAsync(AddressBookContactDto c)
    {
        var ok = await AddressBookService.ArchiveAsync(c.Id);
        ShowToast(ok ? $"'{c.FullName}' archived." : "Failed to archive contact.", !ok);
        if (ok) await SearchAsync();
    }

    private void ShowToast(string message, bool isError = false)
    {
        _toastMessage = message;
        _toastIsError = isError;
    }
}
