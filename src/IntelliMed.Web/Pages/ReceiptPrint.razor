@page "/invoices/receipt/{ReceiptId:int}"
@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Entities
@using IntelliMed.Web.Services
@inject IInvoiceService InvoiceService
@inject IJSRuntime JS

<PageTitle>Receipt - IntelliMed</PageTitle>

<style>
    .no-print { }
    @@media print {
        .no-print { display: none !important; }
        body { margin: 0; }
    }
</style>

<div class="no-print p-3 d-flex justify-content-end">
    <button class="btn btn-primary" @onclick="Print"><i class="bi bi-printer"></i> Print</button>
</div>

@if (_isLoading)
{
    <div class="p-4 text-center">
        <span class="spinner-border spinner-border-sm text-primary me-2"></span>
        Loading receipt...
    </div>
}
else if (_receipt == null)
{
    <div class="p-4"><div class="alert alert-danger">Receipt not found.</div></div>
}
else
{
    <div class="p-4" style="max-width: 700px; margin: 0 auto;">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h4 class="mb-1">@(_receipt.ClinicName ?? "Clinic")</h4>
                @if (!string.IsNullOrWhiteSpace(_receipt.ClinicAddress))
                {
                    <div>@_receipt.ClinicAddress</div>
                }
                @if (!string.IsNullOrWhiteSpace(_receipt.ClinicSuburb) || !string.IsNullOrWhiteSpace(_receipt.ClinicState) || !string.IsNullOrWhiteSpace(_receipt.ClinicPostcode))
                {
                    <div>@_receipt.ClinicSuburb @_receipt.ClinicState @_receipt.ClinicPostcode</div>
                }
                @if (!string.IsNullOrWhiteSpace(_receipt.ClinicPhone) || !string.IsNullOrWhiteSpace(_receipt.ClinicEmail))
                {
                    <div>@_receipt.ClinicPhone@(!string.IsNullOrWhiteSpace(_receipt.ClinicPhone) && !string.IsNullOrWhiteSpace(_receipt.ClinicEmail) ? " · " : "")@_receipt.ClinicEmail</div>
                }
                @if (!string.IsNullOrWhiteSpace(_receipt.ClinicAbn))
                {
                    <div>ABN: @_receipt.ClinicAbn</div>
                }
            </div>
            <div class="text-end">
                <h3 class="mb-1">RECEIPT</h3>
                <div><strong>Receipt No. @_receipt.Id</strong></div>
            </div>
        </div>

        <div class="row g-1 small mb-4">
            <div class="col-6 text-muted">Received From</div>
            <div class="col-6">@_receipt.PayerName</div>
            <div class="col-6 text-muted">Receipt Date</div>
            <div class="col-6">@_receipt.ReceiptDate.ToString("dd/MM/yyyy")</div>
            @if (!string.IsNullOrWhiteSpace(_receipt.Notes))
            {
                <div class="col-6 text-muted">Notes</div>
                <div class="col-6">@_receipt.Notes</div>
            }
        </div>

        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Payment Method</th>
                    <th>Reference</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tender in _receipt.Payments)
                {
                    <tr>
                        <td>@tender.MethodName</td>
                        <td>@(tender.Reference ?? "-")</td>
                        <td class="text-end">@tender.Amount.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="2" class="text-end">Total Received</td>
                    <td class="text-end">@_receipt.TotalTendered.ToString("C")</td>
                </tr>
            </tfoot>
        </table>

        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>Applied To</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var allocation in _receipt.Allocations)
                {
                    <tr>
                        <td>@AllocationLabel(allocation)</td>
                        <td class="text-end">@allocation.Amount.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public int ReceiptId { get; set; }

    private ReceiptDto? _receipt;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _receipt = await InvoiceService.GetReceiptByIdAsync(ReceiptId);
        _isLoading = false;
    }

    private async Task Print()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private static string AllocationLabel(ReceiptAllocationDto allocation) => allocation.AllocationType switch
    {
        AllocationType.Credit => "Held as credit",
        AllocationType.Refund when allocation.InvoiceId == null => "Refunded from account credit",
        AllocationType.Refund => $"Refund — Invoice {allocation.InvoiceNumber}",
        _ => $"Invoice {allocation.InvoiceNumber}"
    };
}
