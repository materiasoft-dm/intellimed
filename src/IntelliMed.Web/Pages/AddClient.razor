    /// <summary>
    /// The message for an empty tab grid. When the list is only empty because archived rows are hidden, say so
    /// and how to see them, rather than implying nothing was ever recorded.
    /// </summary>
    private static string NoneMessage(string noun, int total, bool includeArchived) =>
        total > 0 && !includeArchived
            ? $"No active {noun}. Tick \"Include archived\" to see archived ones."
            : $"No {noun} recorded.";

    private async Task CeasePrescriptionAsync(int id)
    {
        if (!Id.HasValue) return;
        _prescriptionActionError = null;
        var ok = await PrescriptionService.CeaseAsync(Id.Value, id);
        if (!ok)
        {
            _prescriptionActionError = "Cease failed — check your permissions.";
            return;
        }
        _prescriptions = await PrescriptionService.GetByClientIdAsync(Id.Value, _includeInactivePrescriptions);
    }

    /// <summary>Issues a not-yet-issued Prescription for the first time — uses the same practitioner
    /// it was written under, matching PrescribeNew.razor's own "don't re-ask for the same info twice
    /// in one flow" simplification.</summary>
    private async Task IssueAndPrintPrescriptionAsync(PrescriptionDto prescription)
    {
        if (!Id.HasValue) return;
        _prescriptionActionError = null;
        var issueId = await PrescriptionService.IssueAsync(Id.Value, prescription.Id, new IssuePrescriptionDto
        {
            IssuedByPractitionerId = prescription.PrescribedByPractitionerId
        });
        if (issueId == null)
        {
            _prescriptionActionError = "Issue failed — check your permissions.";
            return;
        }
        NavManager.NavigateTo($"/prescriptions/print/{issueId}");
    }

    private async Task ReprintPrescriptionAsync(int prescriptionId)
    {
        if (!Id.HasValue) return;
        _prescriptionActionError = null;
        var issues = await PrescriptionService.GetIssuesAsync(Id.Value, prescriptionId);
        var latest = issues.OrderByDescending(i => i.IssuedAt).FirstOrDefault();
        if (latest == null)
        {
            _prescriptionActionError = "No issue history found for this prescription.";
            return;
        }
        NavManager.NavigateTo($"/prescriptions/print/{latest.Id}");
    }

