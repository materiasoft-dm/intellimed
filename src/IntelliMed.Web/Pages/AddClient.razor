                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="@(() => ArchiveClaimAsync(c.Id))">Archive</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        }
        @if (_showClaimModal)
        {
            <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header py-2">
                            <h6 class="modal-title">@(_editingClaimId.HasValue ? "Edit Claim" : "New Claim")</h6>
                            <button type="button" class="btn-close" @onclick="@(() => _showClaimModal = false)"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small mb-0">Claim#</label>
                                    <input class="form-control form-control-sm" maxlength="30" @bind="_claimForm.ClaimNum" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-0">Date of Injury</label>
                                    <input type="date" class="form-control form-control-sm" @bind="_claimForm.DateOfInjury" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-0">Employer</label>
                                    <div class="input-group input-group-sm">
                                        <input class="form-control form-control-sm" value="@_claimEmployerName" readonly placeholder="No employer" />
                                        <button type="button" class="btn btn-outline-secondary" @onclick="@(() => _employerPickerFor = "claim")">Find</button>
                                        @if (_claimForm.EmployerClientId.HasValue)
                                        {
                                            <button type="button" class="btn btn-outline-secondary" title="Clear employer"
                                                    @onclick="@(() => { _claimForm.EmployerClientId = null; _claimEmployerName = null; })">x</button>
                                        }
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-0">Case Manager</label>
                                    <input class="form-control form-control-sm" @bind="_claimForm.CaseManagerName" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-0">Payer</label>
                                    <input class="form-control form-control-sm" @bind="_claimForm.PayerName" />
                                </div>
                                <div class="col-6 d-flex align-items-end">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="chkClaimDefault" @bind="_claimForm.IsDefault" />
                                        <label class="form-check-label small" for="chkClaimDefault">Default</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-0">Public Note (printed)</label>
                                    <textarea class="form-control form-control-sm" rows="2" @bind="_claimForm.PublicNote"></textarea>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-0">Private Note (not printed)</label>
                                    <textarea class="form-control form-control-sm" rows="2" @bind="_claimForm.PrivateNote"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer py-2">
                            <button type="button" class="btn btn-sm btn-secondary" @onclick="@(() => _showClaimModal = false)">Cancel</button>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="SaveClaimAsync">Save</button>
                        </div>
                    </div>
                </div>
            </div>
            <OrganisationPicker Visible="@(_employerPickerFor == "claim")" Title="Find Employer"
                                OnSelected="SelectEmployer" OnClose="@(() => _employerPickerFor = null)" />
        }
    </div>;

