    private async Task RemoveFamilyRelationshipAsync(int id)
    {
        if (!Id.HasValue) return;
        await FamilyService.DeleteAsync(Id.Value, id);
        _familyRelationships = (await FamilyService.GetByClientIdAsync(Id.Value)).ToList();
    }

    private RenderFragment RenderFamilyTab() => @<div>
