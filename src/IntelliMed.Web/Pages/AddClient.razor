    }

    private async Task SaveHealthIssueAsync()
    {
        if (!Id.HasValue) return;
        if (string.IsNullOrWhiteSpace(_healthIssueForm.Condition))
        {
            _healthIssueError = "Condition is required.";
            return;
        }

        bool ok;
        if (_editingHealthIssueId.HasValue)
        {
            ok = await HealthIssueService.UpdateAsync(Id.Value, _editingHealthIssueId.Value, new UpdateClientHealthIssueDto
            {
                Condition = _healthIssueForm.Condition,
                Code = _healthIssueForm.Code,
                CodingSystem = _healthIssueForm.CodingSystem,
                Side = _healthIssueForm.Side,
                OnsetYear = _healthIssueForm.OnsetYear,
                OnsetMonth = _healthIssueForm.OnsetMonth,
                IsActive = _healthIssueForm.IsActive,
                IsSummary = _healthIssueForm.IsSummary,
                IsConfidential = _healthIssueForm.IsConfidential,
                Note = _healthIssueForm.Note,
                IsArchived = false
            });
        }
        else
        {
            _healthIssueForm.ClientId = Id.Value;
            ok = await HealthIssueService.CreateAsync(_healthIssueForm);
        }

        if (ok)
        {
            _showHealthIssueModal = false;
            _healthIssues = await HealthIssueService.GetByClientIdAsync(Id.Value, includeArchived: true);
        }
        else
        {
            _healthIssueError = "Save failed — check your permissions.";
        }
    }

    private async Task ArchiveHealthIssueAsync(int id)
    {
        if (!Id.HasValue) return;
        await HealthIssueService.ArchiveAsync(Id.Value, id);
        _healthIssues = await HealthIssueService.GetByClientIdAsync(Id.Value, includeArchived: true);
    }

