    // ===================== Occupations =====================
    private void OpenNewOccupationModal()
    {
        _occupationForm = new CreateClientOccupationDto { ClientId = Id ?? 0 };
        _occupationEmployerName = null;
        _editingOccupationId = null;
        _showOccupationModal = true;
    }

    private void OpenEditOccupationModal(ClientOccupationDto o)
    {
        _occupationForm = new CreateClientOccupationDto
        {
            ClientId = o.ClientId,
            Occupation = o.Occupation,
            EmployerClientId = o.EmployerClientId,
            StartedYear = o.StartedYear,
            StoppedYear = o.StoppedYear,
            HasAsbestos = o.HasAsbestos,
            HasDust = o.HasDust,
            HasRadiation = o.HasRadiation,
            HasAnimals = o.HasAnimals,
            Comment = o.Comment
        };
        _occupationEmployerName = o.EmployerName;
        _editingOccupationId = o.Id;
        _showOccupationModal = true;
    }

    private async Task SaveOccupationAsync()
    {
        if (!Id.HasValue) return;
        bool ok;
        if (_editingOccupationId.HasValue)
        {
            var update = new UpdateClientOccupationDto
            {
                Occupation = _occupationForm.Occupation,
                EmployerClientId = _occupationForm.EmployerClientId,
                StartedYear = _occupationForm.StartedYear,
                StoppedYear = _occupationForm.StoppedYear,
                HasAsbestos = _occupationForm.HasAsbestos,
                HasDust = _occupationForm.HasDust,
                HasRadiation = _occupationForm.HasRadiation,
                HasAnimals = _occupationForm.HasAnimals,
                Comment = _occupationForm.Comment,
                IsArchived = false
            };
            ok = await OccupationService.UpdateAsync(Id.Value, _editingOccupationId.Value, update);
        }
        else
        {
            ok = await OccupationService.CreateAsync(_occupationForm);
        }
        if (ok)
        {
            _showOccupationModal = false;
            _occupations = (await OccupationService.GetByClientIdAsync(Id.Value)).ToList();
        }
    }

    private async Task ArchiveOccupationAsync(int id)
    {
        if (!Id.HasValue) return;
        await OccupationService.ArchiveAsync(Id.Value, id);
        _occupations = (await OccupationService.GetByClientIdAsync(Id.Value)).ToList();
    }

    private RenderFragment RenderOccupationsTab() => @<div>
        <div class="d-flex justify-content-between mb-1">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="chkInclArchivedOcc" @bind="_includeArchivedOccupations" />
                <label class="form-check-label small" for="chkInclArchivedOcc">Include archived</label>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenNewOccupationModal">+ New</button>
        </div>
        @if (!(_occupations.Where(x => _includeArchivedOccupations || !x.IsArchived)).Any())
        {
            <EmptyState Message="@(NoneMessage("occupations", _occupations.Count, _includeArchivedOccupations))" Icon="bi-building" />
        }
        else
        {
        <table class="table table-sm table-hover">
            <thead><tr><th>Occupation</th><th>Employer</th><th>Started</th><th>Ended</th><th>Hazards</th><th>Comment</th><th></th></tr></thead>
            <tbody>
                @foreach (var o in _occupations.Where(x => _includeArchivedOccupations || !x.IsArchived))
                {
                    <tr class="@(o.IsArchived ? "text-muted" : "")">
                        <td><a href="javascript:void(0)" class="link-primary" @onclick="@(() => OpenEditOccupationModal(o))">@o.Occupation</a></td>
                        <td>@o.EmployerName</td>
                        <td>@o.StartedYear</td>
                        <td>@o.StoppedYear</td>
                        <td>@HazardSummary(o)</td>
                        <td>@o.Comment</td>
                        <td class="text-end text-nowrap">
                            @if (!o.IsArchived)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="@(() => ArchiveOccupationAsync(o.Id))">Archive</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        }
        @if (_showOccupationModal)
        {
            <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header py-2">
                            <h6 class="modal-title">@(_editingOccupationId.HasValue ? "Edit Occupation" : "New Occupation")</h6>
                            <button type="button" class="btn-close" @onclick="@(() => _showOccupationModal = false)"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small mb-0">Occupation</label>
                                    <input class="form-control form-control-sm" @bind="_occupationForm.Occupation" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-0">Employer</label>
                                    <div class="input-group input-group-sm">
                                        <input class="form-control form-control-sm" value="@_occupationEmployerName" readonly placeholder="No employer" />
                                        <button type="button" class="btn btn-outline-secondary" @onclick="@(() => _employerPickerFor = "occupation")">Find</button>
                                        @if (_occupationForm.EmployerClientId.HasValue)
                                        {
                                            <button type="button" class="btn btn-outline-secondary" title="Clear employer"
                                                    @onclick="@(() => { _occupationForm.EmployerClientId = null; _occupationEmployerName = null; })">x</button>
                                        }
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-0">Started (year)</label>
                                    <input type="number" class="form-control form-control-sm" @bind="_occupationForm.StartedYear" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-0">Ended (year)</label>
                                    <input type="number" class="form-control form-control-sm" @bind="_occupationForm.StoppedYear" />
                                </div>
                                <div class="col-12 d-flex gap-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="chkAsbestos" @bind="_occupationForm.HasAsbestos" />
                                        <label class="form-check-label small" for="chkAsbestos">Asbestos</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="chkDust" @bind="_occupationForm.HasDust" />
                                        <label class="form-check-label small" for="chkDust">Dust</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="chkRadiation" @bind="_occupationForm.HasRadiation" />
                                        <label class="form-check-label small" for="chkRadiation">Radiation</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="chkAnimals" @bind="_occupationForm.HasAnimals" />
                                        <label class="form-check-label small" for="chkAnimals">Animals</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-0">Comment</label>
                                    <textarea class="form-control form-control-sm" rows="2" @bind="_occupationForm.Comment"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer py-2">
                            <button type="button" class="btn btn-sm btn-secondary" @onclick="@(() => _showOccupationModal = false)">Cancel</button>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="SaveOccupationAsync">Save</button>
                        </div>
                    </div>
                </div>
            </div>
            <OrganisationPicker Visible="@(_employerPickerFor == "occupation")" Title="Find Employer"
                                OnSelected="SelectEmployer" OnClose="@(() => _employerPickerFor = null)" />
        }
    </div>;

    private static string HazardSummary(ClientOccupationDto o)
    {
        var hazards = new List<string>();
        if (o.HasAsbestos) hazards.Add("Asbestos");
        if (o.HasDust) hazards.Add("Dust");
        if (o.HasRadiation) hazards.Add("Radiation");
        if (o.HasAnimals) hazards.Add("Animals");
        return string.Join(", ", hazards);
    }

