    // ===================== Patient History (unified timeline) =====================
    // No own storage — merges the already-loaded _progressNotes (+ their Addenda), _episodes, and
    // _appointments client-side. All three are already fetched by LoadTabDataAsync() for their own
    // tabs, so this needs no new API endpoint.
    private record HistoryEntry(DateTime Date, string Kind, string Title, string? Detail, string BorderClass, string? LinkUrl);

    private List<HistoryEntry> BuildHistoryEntries()
    {
        var entries = new List<HistoryEntry>();

        foreach (var note in _progressNotes)
        {
            var noteUrl = $"/clients/{Id}/progress-notes/{note.Id}";
            entries.Add(new HistoryEntry(
                note.EncounterDate,
                "Progress Note",
                note.ReasonForVisit ?? "(no reason recorded)",
                note.EpisodeTitle != null ? $"{note.PractitionerName} — {note.EpisodeTitle}" : note.PractitionerName,
                note.Status == ProgressNoteStatus.Finalized ? "border-success" : "border-secondary",
                noteUrl));

            foreach (var addendum in note.Addenda)
            {
                entries.Add(new HistoryEntry(
                    addendum.CreatedAt,
                    addendum.Source == ProgressNoteAddendumSource.System ? "Auto-logged" : "Addendum",
                    addendum.Content,
                    addendum.CreatedByPractitionerName,
                    addendum.Source == ProgressNoteAddendumSource.System ? "border-secondary" : "border-primary",
                    noteUrl));
            }
        }

        foreach (var episode in _episodes)
        {
            entries.Add(new HistoryEntry(episode.OpenedDate, "Episode Opened", episode.Title, episode.Description, "border-info", null));
            if (episode.ClosedDate.HasValue)
            {
                entries.Add(new HistoryEntry(episode.ClosedDate.Value, "Episode Resolved", episode.Title, null, "border-success", null));
            }
        }

        foreach (var appt in _appointments)
        {
            entries.Add(new HistoryEntry(appt.AppointmentDate, "Appointment Completed", appt.TypeName, appt.PractitionerName, "border-success", null));
        }

        return entries.OrderByDescending(e => e.Date).ToList();
    }

    private RenderFragment RenderPatientHistoryTab() => @<div>
        @if (BuildHistoryEntries().Count == 0)
        {
            <p class="text-muted small mb-0">No recorded history yet.</p>
        }
        else
        {
            @foreach (var entry in BuildHistoryEntries())
            {
                <div class="border-start border-3 @entry.BorderClass ps-2 mb-2">
                    <div class="small text-muted">
                        @entry.Date.ToString("d MMM yyyy") — <strong>@entry.Kind</strong>@(entry.Detail != null ? $" · {entry.Detail}" : "")
                    </div>
                    <div>
                        @if (entry.LinkUrl != null)
                        {
                            <a href="@entry.LinkUrl">@entry.Title</a>
                        }
                        else
                        {
                            @entry.Title
                        }
                    </div>
                </div>
            }
        }
    </div>;

