    // ===================== UDF =====================
    private void OpenNewUdfModal()
    {
        _udfFieldTypeId = _udfDefinitions.FirstOrDefault()?.Id;
        _udfValueText = null;
        _udfNoteText = null;
        _editingUdfValueId = null;
        _showUdfModal = true;
    }

    private void OpenEditUdfModal(ClientUserDefinedFieldValueDto v)
    {
        _udfFieldTypeId = v.UserDefinedFieldTypeId;
        _udfValueText = v.Value;
        _udfNoteText = v.Note;
        _editingUdfValueId = v.Id;
        _showUdfModal = true;
    }

    private async Task SaveUdfValueAsync()
    {
        if (!Id.HasValue || !_udfFieldTypeId.HasValue) return;
        bool ok;
        if (_editingUdfValueId.HasValue)
        {
            var update = new UpdateClientUserDefinedFieldValueDto { Value = _udfValueText, Note = _udfNoteText };
            ok = await UdfValueService.UpdateAsync(Id.Value, _editingUdfValueId.Value, update);
        }
        else
        {
            var create = new CreateClientUserDefinedFieldValueDto
            {
                ClientId = Id.Value,
                UserDefinedFieldTypeId = _udfFieldTypeId.Value,
                Value = _udfValueText,
                Note = _udfNoteText
            };
            ok = await UdfValueService.CreateAsync(create);
        }
        if (ok)
        {
            _showUdfModal = false;
            _udfValues = (await UdfValueService.GetByClientIdAsync(Id.Value)).ToList();
        }
    }

    private async Task DeleteUdfValueAsync(int id)
    {
        if (!Id.HasValue) return;
        await UdfValueService.DeleteAsync(Id.Value, id);
        _udfValues = (await UdfValueService.GetByClientIdAsync(Id.Value)).ToList();
    }

    private RenderFragment RenderUdfTab() => @<div>
        <div class="d-flex justify-content-end mb-1">
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenNewUdfModal" disabled="@(!_udfDefinitions.Any())">+ New</button>
        </div>
        @if (!_udfDefinitions.Any())
        {
            <div class="text-muted small">No user-defined fields configured yet.</div>
        }
        @if (!(_udfValues).Any())
        {
            @if (_udfDefinitions.Any())
            {
                <EmptyState Message="@("No user-defined field values recorded.")" Icon="bi-sliders" />
            }
        }
        else
        {
        <table class="table table-sm table-hover">
            <thead><tr><th>Field Name</th><th>Value</th><th>Note</th><th></th></tr></thead>
            <tbody>
                @foreach (var v in _udfValues)
                {
                    <tr>
                        <td><a href="javascript:void(0)" class="link-primary" @onclick="@(() => OpenEditUdfModal(v))">@v.FieldName</a></td>
                        <td>@v.Value</td>
                        <td>@v.Note</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="@(() => DeleteUdfValueAsync(v.Id))">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        }
        @if (_showUdfModal)
        {
            <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header py-2">
                            <h6 class="modal-title">@(_editingUdfValueId.HasValue ? "Edit Field Value" : "New Field Value")</h6>
                            <button type="button" class="btn-close" @onclick="@(() => _showUdfModal = false)"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="form-label small mb-0">Field Name</label>
                                    <select class="form-select form-select-sm" @bind="_udfFieldTypeId" disabled="@_editingUdfValueId.HasValue">
                                        @foreach (var d in _udfDefinitions)
                                        {
                                            <option value="@d.Id">@d.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-0">Value</label>
                                    <input class="form-control form-control-sm" @bind="_udfValueText" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-0">Note</label>
                                    <textarea class="form-control form-control-sm" rows="2" @bind="_udfNoteText"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer py-2">
                            <button type="button" class="btn btn-sm btn-secondary" @onclick="@(() => _showUdfModal = false)">Cancel</button>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="SaveUdfValueAsync">Save</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>;
}
