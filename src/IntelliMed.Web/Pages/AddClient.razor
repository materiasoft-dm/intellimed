    private void OpenEditHealthIssueModal(ClientHealthIssueDto h)
    {
        _healthIssueForm = new CreateClientHealthIssueDto
        {
            ClientId = h.ClientId,
            Condition = h.Condition,
            Code = h.Code,
            CodingSystem = h.CodingSystem,
            Side = h.Side,
            OnsetYear = h.OnsetYear,
            OnsetMonth = h.OnsetMonth,
            IsActive = h.IsActive,
            IsSummary = h.IsSummary,
            IsConfidential = h.IsConfidential,
            Note = h.Note
        };
        _editingHealthIssueId = h.Id;
        _healthIssueError = null;
