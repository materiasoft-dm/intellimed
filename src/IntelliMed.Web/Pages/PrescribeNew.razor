@page "/clients/{ClientId:int}/prescriptions/new"
@layout MainLayout
@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Entities
@using IntelliMed.Web.Services
@inject IClientService ClientService
@inject IMedicineService MedicineService
@inject IPractitionerService PractitionerService
@inject IPrescriptionService PrescriptionService
@inject IEpisodeService EpisodeService
@inject IAuthService AuthService
@inject NavigationManager Nav

<PageTitle>New Prescription - IntelliMed</PageTitle>

<h4 class="mb-1">New Prescription</h4>
<p class="text-muted small mb-4">@(_client == null ? "" : $"for {_client.FirstName} {_client.LastName}")</p>

@if (_createdId == null)
{
    <ol class="d-flex flex-wrap gap-1 p-0 mb-4 small" style="list-style:none;">
        @foreach (var s in VisibleSteps)
        {
            <li class="px-2 py-1 rounded @(s == _step ? "bg-primary text-white" : (StepIndex(s) < StepIndex(_step) ? "bg-light text-muted" : "bg-light text-muted"))">
                @(StepIndex(s)).  @StepLabel(s)
            </li>
        }
    </ol>

    @if (_step == WizardStep.Medicine)
    {
        <div class="card mb-3">
            <div class="card-header"><strong>1. Medicine</strong></div>
            <div class="card-body">
                @if (string.IsNullOrEmpty(_form.MedicineName))
                {
                    <input class="form-control form-control-sm mb-2" placeholder="Search by name..." autofocus
                           @bind="_drugSearchTerm" @bind:event="oninput" @bind:after="SearchDrugCandidatesAsync" />
                    <div style="max-height: 320px; overflow-y: auto;">
                        @if (string.IsNullOrWhiteSpace(_drugSearchTerm))
                        {
                            <div class="text-muted small">Start typing a medicine name to search the catalog.</div>
                        }
                        else if (_searching)
                        {
                            <LoadingState Text="Searching..." />
                        }
                        else if (_drugSearchResults.Count == 0)
                        {
                            <div class="text-muted small">No matches.</div>
                        }
                        else
                        {
                            <ul class="list-group">
                                @foreach (var candidate in _drugSearchResults)
                                {
                                    <li class="list-group-item list-group-item-action" style="cursor:pointer" @onclick="@(() => SelectMedicineAsync(candidate))">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <strong>@candidate.Name</strong>
                                            <span class="text-nowrap ms-2">
                                                @if (candidate.Schedule != null)
                                                {
                                                    <span class="badge @ScheduleBadgeClass(candidate.Schedule.Value)">@candidate.Schedule</span>
                                                }
                                                @if (candidate.IsPbsListed)
                                                {
                                                    <span class="badge bg-info text-dark">PBS</span>
                                                }
                                                @if (candidate.IsRpbsListed)
                                                {
                                                    <span class="badge bg-info text-dark">RPBS</span>
                                                }
                                                @if (candidate.RestrictionLevel != null)
                                                {
                                                    <span class="badge @RestrictionBadgeClass(candidate.RestrictionLevel.Value)">@RestrictionLabel(candidate.RestrictionLevel.Value)</span>
                                                }
                                            </span>
                                        </div>
                                        <div class="small text-muted">
                                            @candidate.GenericName
                                            @candidate.Strength
                                            @candidate.Form
                                            @(string.IsNullOrWhiteSpace(candidate.PackSize) ? "" : $"— pack of {candidate.PackSize}")
                                            @(string.IsNullOrWhiteSpace(candidate.Manufacturer) ? "" : $"({candidate.Manufacturer})")
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_drugSearchTerm))
                    {
                        <button type="button" class="btn btn-sm btn-link px-0 mt-2" @onclick="UseFreeTextMedicineAsync">
                            Can't find it? Use "@_drugSearchTerm" as free text
                        </button>
                    }
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div>
                                <strong>@_form.MedicineName</strong>
                                @if (_form.MedicineId == null)
                                {
                                    <span class="badge bg-secondary ms-1">free text</span>
                                }
                                @if (_selectedMedicine?.Schedule != null)
                                {
                                    <span class="badge @ScheduleBadgeClass(_selectedMedicine.Schedule.Value) ms-1">@_selectedMedicine.Schedule</span>
                                }
                                @if (_selectedMedicine?.IsPbsListed == true)
                                {
                                    <span class="badge bg-info text-dark ms-1">PBS</span>
                                }
                                @if (_selectedMedicine?.IsRpbsListed == true)
                                {
                                    <span class="badge bg-info text-dark ms-1">RPBS</span>
                                }
                                @if (_selectedMedicine?.RestrictionLevel != null)
                                {
                                    <span class="badge @RestrictionBadgeClass(_selectedMedicine.RestrictionLevel.Value) ms-1">@RestrictionLabel(_selectedMedicine.RestrictionLevel.Value)</span>
                                }
                            </div>
                            @if (_selectedMedicine != null)
                            {
                                <div class="small text-muted">
                                    @_selectedMedicine.GenericName
                                    @_selectedMedicine.Strength
                                    @_selectedMedicine.Form
                                    @(string.IsNullOrWhiteSpace(_selectedMedicine.PackSize) ? "" : $"— pack of {_selectedMedicine.PackSize}")
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ChangeMedicine">Change</button>
                    </div>
                }
                @if (_stepError != null)
                {
                    <div class="small text-danger mt-2">@_stepError</div>
                }
            </div>
        </div>
        <button type="button" class="btn btn-primary" @onclick="GoNext">Continue</button>
        <a href="@($"/clients/edit/{ClientId}")" class="btn btn-outline-secondary ms-1">Cancel</a>
    }
    else if (_step == WizardStep.Dosage)
    {
        <div class="card mb-3">
            <div class="card-header"><strong>2. Dosage</strong></div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label small mb-0">Dose</label>
                        <input class="form-control form-control-sm" @bind="_form.Dose" placeholder="e.g. 500mg" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-0">Frequency</label>
                        <input class="form-control form-control-sm" @bind="_form.Frequency" placeholder="e.g. tds" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-0">Route</label>
                        <input class="form-control form-control-sm" @bind="_form.Route" placeholder="e.g. PO" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-0">Purpose</label>
                        <select class="form-select form-select-sm" @bind="_form.Purpose">
                            <option value="">Select...</option>
                            @foreach (var p in Enum.GetValues<PrescriptionSourceCode>())
                            {
                                <option value="@p">@PurposeLabel(p)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label small mb-0">Instruction (for patient)</label>
                        <input class="form-control form-control-sm" @bind="_form.Instruction" placeholder="e.g. Take with food" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-0">Start date</label>
                        <input type="date" class="form-control form-control-sm" @bind="_form.StartDate" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small mb-0 d-block">Duration</label>
                        <div class="btn-group btn-group-sm" role="group">
                            <input type="radio" class="btn-check" id="durLong" checked="@(!_form.IsLimitedDuration)" @onchange="@(() => _form.IsLimitedDuration = false)" />
                            <label class="btn btn-outline-secondary" for="durLong">Long term</label>
                            <input type="radio" class="btn-check" id="durLimited" checked="@_form.IsLimitedDuration" @onchange="@(() => _form.IsLimitedDuration = true)" />
                            <label class="btn btn-outline-secondary" for="durLimited">Limited</label>
                        </div>
                    </div>
                </div>
                @if (_stepError != null)
                {
                    <div class="small text-danger mt-2">@_stepError</div>
                }
            </div>
        </div>
        <button type="button" class="btn btn-primary" @onclick="GoNext">Continue</button>
        <button type="button" class="btn btn-outline-secondary ms-1" @onclick="GoBack">Back</button>
    }
    else if (_step == WizardStep.QuantityRepeats)
    {
        <div class="card mb-3">
            <div class="card-header"><strong>3. Quantity &amp; Repeats</strong></div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label small mb-0">Quantity</label>
                        <input class="form-control form-control-sm" @bind="_form.Quantity" placeholder="e.g. 20" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-0">Duration (days)</label>
                        <input type="number" class="form-control form-control-sm" @bind="_form.DurationDays" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-0">Repeats</label>
                        <input type="number" class="form-control form-control-sm" @bind="_form.Repeats" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-0">Repeat interval (days)</label>
                        <input type="number" class="form-control form-control-sm" @bind="_form.RepeatIntervalDays" />
                    </div>
                </div>
                @if (_stepError != null)
                {
                    <div class="small text-danger mt-2">@_stepError</div>
                }
            </div>
        </div>
        <button type="button" class="btn btn-primary" @onclick="GoNext">Continue</button>
        <button type="button" class="btn btn-outline-secondary ms-1" @onclick="GoBack">Back</button>
    }
    else if (_step == WizardStep.Authority)
    {
        <div class="card mb-3">
            <div class="card-header"><strong>4. @AuthorityStepTitle</strong></div>
            <div class="card-body">
                @* This step can be reached four ways, so say which one applies — otherwise a
                   prescriber who exceeded a quantity limit sees an unexplained Authority screen. *@
                @if (_selectedMedicine?.IsSection100 == true)
                {
                    <div class="alert alert-warning small py-2 mb-2">
                        <i class="bi bi-info-circle me-1"></i>
                        <strong>Section 100</strong> item — supplied through the Highly Specialised Drugs
                        or equivalent programme, and Authority-only regardless of quantity.
                    </div>
                }
                @if (ExceedsPbsLimits)
                {
                    <div class="alert alert-warning small py-2 mb-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        This prescription exceeds the PBS listing:
                        @if (_selectedMedicine?.MaxRepeats is > 0 && _form.Repeats > _selectedMedicine.MaxRepeats)
                        {
                            <span>@_form.Repeats repeats requested, listing allows @_selectedMedicine.MaxRepeats.</span>
                        }
                        @if (_selectedMedicine?.MaxQuantity is > 0
                             && int.TryParse(_form.Quantity?.Trim(), out var overQty)
                             && overQty > _selectedMedicine.MaxQuantity)
                        {
                            <span>Quantity @overQty requested, listing allows @_selectedMedicine.MaxQuantity.</span>
                        }
                        Increased quantities need Authority approval.
                    </div>
                }
                @* Each block keys off its own trigger rather than an if/else on RestrictionLevel —
                   a Restricted item prescribed over its quantity limit legitimately needs both an
                   indication confirmation and an approval number. *@
                @if (_selectedMedicine?.RestrictionLevel == PbsRestrictionLevel.AuthorityRequired)
                {
                    <div class="alert alert-warning small py-2 mb-2">
                        <i class="bi bi-telephone me-1"></i>
                        Authority Required — phone the Authority Hotline before issuing, or record a prior
                        approval number below.
                    </div>
                }
                @if (NeedsApprovalNumber)
                {
                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small mb-0">Authority approval number</label>
                            <input class="form-control form-control-sm" @bind="_form.AuthorityApprovalNumber" placeholder="Not validated live — record only" />
                        </div>
                    </div>
                }
                @if (_selectedMedicine?.RestrictionLevel == PbsRestrictionLevel.Restricted)
                {
                    <div class="alert alert-secondary small py-2 mb-2">
                        <i class="bi bi-info-circle me-1"></i>
                        Restricted Benefit — subsidised only for the listed indication. No separate
                        approval number is required.
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chkRb" @bind="_rbAcknowledged" />
                        <label class="form-check-label small" for="chkRb">Indication confirmed — this prescription meets the Restricted Benefit criteria</label>
                    </div>
                }
                @if (_stepError != null)
                {
                    <div class="small text-danger mt-2">@_stepError</div>
                }
            </div>
        </div>
        <button type="button" class="btn btn-primary" @onclick="GoNext">Continue</button>
        <button type="button" class="btn btn-outline-secondary ms-1" @onclick="GoBack">Back</button>
    }
    else if (_step == WizardStep.StateAuthority)
    {
        <div class="card mb-3">
            <div class="card-header"><strong>5. State Authority (Schedule 8)</strong></div>
            <div class="card-body">
                <div class="alert alert-warning small py-2 mb-2">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Schedule 8 (drug of dependence) — this may not satisfy your state's S8 prescribing
                    requirements (sequentially-numbered forms or accredited e-prescribing software may
                    be required). Verify before use. A state authority code is required to continue.
                </div>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label small mb-0">State authority code</label>
                        <input class="form-control form-control-sm" @bind="_form.StateAuthorityCode" />
                    </div>
                </div>
                @if (_stepError != null)
                {
                    <div class="small text-danger mt-2">@_stepError</div>
                }
            </div>
        </div>
        <button type="button" class="btn btn-primary" @onclick="GoNext">Continue</button>
        <button type="button" class="btn btn-outline-secondary ms-1" @onclick="GoBack">Back</button>
    }
    else if (_step == WizardStep.Reason)
    {
        <div class="card mb-3">
            <div class="card-header"><strong>6. Reason</strong></div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label small mb-0">Reason for prescribing</label>
                    <textarea class="form-control form-control-sm" rows="2" @bind="_form.Reason" placeholder="e.g. Acute sinusitis"></textarea>
                </div>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small mb-0">Episode</label>
                        @if (_showNewEpisodeInput)
                        {
                            <div class="input-group input-group-sm">
                                <input class="form-control" placeholder="New episode title" @bind="_newEpisodeTitle" />
                                <button type="button" class="btn btn-outline-primary" @onclick="CreateEpisodeAsync">Add</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="@(() => _showNewEpisodeInput = false)">Cancel</button>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex">
                                <select class="form-select form-select-sm" @bind="_form.EpisodeId">
                                    <option value="">-- None --</option>
                                    @foreach (var ep in _episodes)
                                    {
                                        <option value="@ep.Id">@ep.Title</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-sm btn-link" @onclick="@(() => _showNewEpisodeInput = true)">+ New</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="row g-2 mt-1">
                    <div class="col-md-6">
                        <label class="form-label small mb-0">Prescribing notes</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="_form.PrescribingNotes"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-0">Notes for pharmacy</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="_form.NotesForPharmacy"></textarea>
                    </div>
                </div>
                @if (_stepError != null)
                {
                    <div class="small text-danger mt-2">@_stepError</div>
                }
            </div>
        </div>
        <button type="button" class="btn btn-primary" @onclick="GoNext">Continue</button>
        <button type="button" class="btn btn-outline-secondary ms-1" @onclick="GoBack">Back</button>
    }
    else if (_step == WizardStep.Review)
    {
        <div class="card mb-3">
            <div class="card-header"><strong>7. Review &amp; Issue</strong></div>
            <div class="card-body">
                <dl class="row small mb-0">
                    <dt class="col-sm-3">Medicine</dt><dd class="col-sm-9">@_form.MedicineName</dd>
                    <dt class="col-sm-3">Dose</dt><dd class="col-sm-9">@_form.Dose @_form.Frequency @_form.Route</dd>
                    @if (!string.IsNullOrWhiteSpace(_form.Instruction))
                    {
                        <dt class="col-sm-3">Instruction</dt><dd class="col-sm-9">@_form.Instruction</dd>
                    }
                    <dt class="col-sm-3">Duration</dt>
                    <dd class="col-sm-9">
                        @(_form.IsLimitedDuration ? $"Limited — {_form.Quantity} qty, {_form.Repeats} repeats" : "Long term")
                    </dd>
                    @if (!string.IsNullOrWhiteSpace(_form.AuthorityApprovalNumber))
                    {
                        <dt class="col-sm-3">Authority #</dt><dd class="col-sm-9">@_form.AuthorityApprovalNumber</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.StateAuthorityCode))
                    {
                        <dt class="col-sm-3">State authority</dt><dd class="col-sm-9">@_form.StateAuthorityCode</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.Reason))
                    {
                        <dt class="col-sm-3">Reason</dt><dd class="col-sm-9">@_form.Reason</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><strong>Prescriber</strong></div>
            <div class="card-body">
                <select class="form-select form-select-sm" style="max-width: 320px" @bind="_form.PrescribedByPractitionerId">
                    <option value="0">Select...</option>
                    @foreach (var p in _practitioners)
                    {
                        <option value="@p.Id">@p.Title @p.FirstName @p.LastName</option>
                    }
                </select>
            </div>
        </div>

        @if (_safetyResult != null)
        {
            <div class="card mb-3">
                <div class="card-header"><strong>Safety Check</strong></div>
                <div class="card-body">
                    @if (!_safetyResult.CanFullyCheck)
                    {
                        <div class="alert alert-secondary small py-2 mb-2">
                            <i class="bi bi-info-circle me-1"></i>
                            This is a free-text/compounded item — it can't be automatically checked against
                            interactions or allergies. Verify manually.
                        </div>
                    }
                    @if (_safetyResult.InteractionDatabaseEmpty)
                    {
                        <div class="alert alert-secondary small py-2 mb-2">
                            <i class="bi bi-info-circle me-1"></i>
                            The interaction reference database has no data loaded — this check found
                            nothing to compare against, not confirmed-safe.
                        </div>
                    }
                    @if (_selectedMedicine?.SchedulingUnknown == true)
                    {
                        <div class="alert alert-secondary small py-2 mb-2">
                            <i class="bi bi-info-circle me-1"></i>
                            Poisons scheduling is not recorded for this medicine — the PBS feed doesn't
                            publish it. If this is a Schedule 8 drug, the extra S8 requirements still
                            apply and this wizard has not prompted for them. Verify before issuing.
                        </div>
                    }
                    @if (!_safetyResult.HasWarnings)
                    {
                        <div class="text-success small"><i class="bi bi-check-circle me-1"></i>No known interactions, duplicate therapy or allergy conflicts found.</div>
                    }
                    else
                    {
                        @foreach (var w in _safetyResult.InteractionWarnings)
                        {
                            <div class="alert alert-@(w.Severity == InteractionSeverity.Major ? "danger" : "warning") small py-2 mb-1">
                                <strong>Interaction (@w.Severity):</strong> with @w.ConflictingMedicineName
                                (@w.IngredientAName / @w.IngredientBName). @w.Description
                            </div>
                        }
                        @foreach (var w in _safetyResult.DuplicateTherapyWarnings)
                        {
                            <div class="alert alert-warning small py-2 mb-1">
                                <strong>Duplicate therapy:</strong> already prescribed @w.ExistingMedicineName@(string.IsNullOrWhiteSpace(w.TherapeuticGroupTitle) ? "" : $", same therapeutic group ({w.TherapeuticGroupTitle})").
                            </div>
                        }
                        @foreach (var w in _safetyResult.AllergyWarnings)
                        {
                            <div class="alert alert-danger small py-2 mb-1">
                                <strong>Allergy@(w.IsConfirmedMatch ? "" : " (possible — please verify)"):</strong>
                                recorded allergy to @w.AllergySubstance@(w.Severity != null ? $" ({w.Severity})" : "")
                            </div>
                        }
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="chkOverride" @bind="_form.SafetyOverrideAcknowledged" />
                            <label class="form-check-label small" for="chkOverride">I've reviewed these warnings and want to proceed anyway</label>
                        </div>
                        @if (_form.SafetyOverrideAcknowledged)
                        {
                            <textarea class="form-control form-control-sm mt-1" rows="2" placeholder="Why is it safe to proceed? (required)" @bind="_form.SafetyOverrideNote"></textarea>
                        }
                    }
                </div>
            </div>
        }

        @if (_saveError != null)
        {
            <div class="small text-danger mb-2">@_saveError</div>
        }
        <button type="button" class="btn btn-primary" disabled="@(!CanSave || _isSaving)" @onclick="SaveAsync">
            @if (_isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            Create Prescription
        </button>
        <button type="button" class="btn btn-outline-secondary ms-1" @onclick="GoBack">Back</button>
        <a href="@($"/clients/edit/{ClientId}")" class="btn btn-outline-secondary ms-1">Cancel</a>
    }
}
else
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-1"></i> Prescription created — script number <strong>@_createdScriptNumber</strong>.
    </div>
    <button type="button" class="btn btn-primary" disabled="@_isIssuing" @onclick="IssueAndPrintAsync">
        @if (_isIssuing)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
        }
        <i class="bi bi-printer me-1"></i> Issue &amp; Print Now
    </button>
    <a href="@($"/clients/edit/{ClientId}")" class="btn btn-outline-secondary ms-1">Done — issue later</a>
}

@code {
    [Parameter] public int ClientId { get; set; }

    private enum WizardStep { Medicine, Dosage, QuantityRepeats, Authority, StateAuthority, Reason, Review }

    private ClientDto? _client;
    private List<PractitionerDto> _practitioners = new();
    private List<EpisodeDto> _episodes = new();

    private CreatePrescriptionDto _form = new();
    private MedicineDto? _selectedMedicine;
    private MedicationSafetyCheckResultDto? _safetyResult;

    private WizardStep _step = WizardStep.Medicine;
    private string? _stepError;
    private bool _rbAcknowledged;

    private string _drugSearchTerm = string.Empty;
    private List<MedicineDto> _drugSearchResults = new();

    private bool _showNewEpisodeInput;
    private string _newEpisodeTitle = string.Empty;

    private bool _isSaving;
    private string? _saveError;
    private int? _createdId;
    private string? _createdScriptNumber;
    private bool _isIssuing;

    protected override async Task OnInitializedAsync()
    {
        _form.ClientId = ClientId;
        _form.StartDate = DateTime.Today;
        _client = await ClientService.GetClientByIdAsync(ClientId);
        _practitioners = await PractitionerService.GetAllActiveAsync();
        _episodes = await EpisodeService.GetByClientIdAsync(ClientId);

        // Pre-fill (not lock) the prescriber for a logged-in Doctor with a linked practitioner
        // record — still an explicit, editable dropdown either way, since front-desk-prepares-for-
        // doctor is a real workflow (matches AddInvoice/NewAppointment's own practitioner-select
        // convention of never auto-locking this field).
        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser?.PractitionerId != null && (currentUser.Roles?.Contains("Doctor") ?? false))
        {
            _form.PrescribedByPractitionerId = currentUser.PractitionerId.Value;
        }
    }

    // The gating logic below mirrors legacy Medinet's step sequence (see
    // PRESCRIBING-BUSINESS-RULES.md): Quantity/Repeats only for Limited scripts, Authority/RB only
    // when the medicine's RestrictionLevel triggers it, State Authority only for Schedule 8.
    private IEnumerable<WizardStep> VisibleSteps => Enum.GetValues<WizardStep>().Where(IsStepApplicable);

    private bool IsStepApplicable(WizardStep step) => step switch
    {
        WizardStep.QuantityRepeats => _form.IsLimitedDuration,
        WizardStep.Authority => RequiresAuthorityStep,
        WizardStep.StateAuthority => _selectedMedicine?.Schedule == MedicineSchedule.S8,
        _ => true
    };

    /// <summary>
    /// Legacy §3: the Authority dialog opens on a restricted benefit type, on Section 100, OR on an
    /// "overdose" — a quantity or repeat count beyond what the PBS listing allows. The last two were
    /// impossible until the catalogue started carrying MaxRepeats/MaxQuantity/IsSection100.
    /// </summary>
    private bool RequiresAuthorityStep =>
        _selectedMedicine?.RestrictionLevel is PbsRestrictionLevel.AuthorityRequired or PbsRestrictionLevel.Restricted
        || _selectedMedicine?.IsSection100 == true
        || ExceedsPbsLimits;

    /// <summary>An approval number is the remedy for everything except a plain Restricted Benefit,
    /// which is satisfied by confirming the indication instead.</summary>
    private bool NeedsApprovalNumber =>
        _selectedMedicine?.RestrictionLevel == PbsRestrictionLevel.AuthorityRequired
        || _selectedMedicine?.IsSection100 == true
        || ExceedsPbsLimits;

    private string AuthorityStepTitle =>
        NeedsApprovalNumber ? "Authority" : "Restricted Benefit";

    /// <summary>Legacy §3's `overdose` condition. Only meaningful when the listing publishes a
    /// limit — a null limit means "not stated", never "zero".</summary>
    private bool ExceedsPbsLimits
    {
        get
        {
            if (_selectedMedicine == null) return false;

            if (_selectedMedicine.MaxRepeats is > 0 && _form.Repeats > _selectedMedicine.MaxRepeats)
                return true;

            // Quantity is free text (it can read "2 x 30" or "1 tube"), so only a cleanly numeric
            // value can be compared — anything else is left to the prescriber rather than guessed at.
            if (_selectedMedicine.MaxQuantity is > 0
                && int.TryParse(_form.Quantity?.Trim(), out var quantity)
                && quantity > _selectedMedicine.MaxQuantity)
                return true;

            return false;
        }
    }

    private int StepIndex(WizardStep step) => VisibleSteps.ToList().IndexOf(step) + 1;

    private static string StepLabel(WizardStep step) => step switch
    {
        WizardStep.Medicine => "Medicine",
        WizardStep.Dosage => "Dosage",
        WizardStep.QuantityRepeats => "Quantity",
        WizardStep.Authority => "Authority",
        WizardStep.StateAuthority => "State Auth.",
        WizardStep.Reason => "Reason",
        WizardStep.Review => "Review",
        _ => step.ToString()
    };

    private static string PurposeLabel(PrescriptionSourceCode p) => p switch
    {
        PrescriptionSourceCode.PrintedPrescription => "Printed prescription",
        PrescriptionSourceCode.HandwrittenPrescription => "Handwritten prescription",
        PrescriptionSourceCode.ProductAdvisedHere => "Product advised here",
        PrescriptionSourceCode.ProductSuppliedHere => "Product supplied here",
        PrescriptionSourceCode.AdvisedOrPrescribedElsewhere => "Advised or prescribed elsewhere",
        _ => p.ToString()
    };

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_form.MedicineName) &&
        _form.PrescribedByPractitionerId > 0 &&
        (_safetyResult == null || !_safetyResult.HasWarnings ||
         (_form.SafetyOverrideAcknowledged && !string.IsNullOrWhiteSpace(_form.SafetyOverrideNote)));

    private static string ScheduleBadgeClass(MedicineSchedule schedule) => schedule switch
    {
        MedicineSchedule.S8 => "bg-danger",
        MedicineSchedule.S4 => "bg-primary",
        MedicineSchedule.S3 => "bg-warning text-dark",
        MedicineSchedule.S2 => "bg-success",
        _ => "bg-secondary"
    };

    // Same labelling/colouring convention as MedicinesAdmin.razor's catalog table, reused here so
    // a drug looks identical whether seen in search results or in the admin list.
    private static string RestrictionLabel(PbsRestrictionLevel level) => level switch
    {
        PbsRestrictionLevel.AuthorityRequired => "Authority Required",
        _ => level.ToString()
    };

    private static string RestrictionBadgeClass(PbsRestrictionLevel level) => level switch
    {
        PbsRestrictionLevel.AuthorityRequired => "bg-danger",
        PbsRestrictionLevel.Restricted => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    // The latest search wins: a slow earlier response must not overwrite newer results, and the list shows
    // "Searching..." instead of a misleading "No matches." while a request is still in flight.
    private bool _searching;
    private int _searchSeq;

    private async Task SearchDrugCandidatesAsync()
    {
        var seq = ++_searchSeq;
        if (string.IsNullOrWhiteSpace(_drugSearchTerm))
        {
            _drugSearchResults = new();
            _searching = false;
            return;
        }
        _searching = true;
        try
        {
            var found = await MedicineService.SearchAsync(_drugSearchTerm);
            if (seq == _searchSeq) _drugSearchResults = found;
        }
        finally
        {
            if (seq == _searchSeq) _searching = false;
        }
    }

    private async Task SelectMedicineAsync(MedicineDto candidate)
    {
        _selectedMedicine = candidate;
        _form.MedicineId = candidate.Id;
        _form.MedicineName = candidate.Name;
        _form.Quantity = candidate.PackSize;

        // Pre-fill from the PBS listing where it publishes a value, matching legacy §5's defaults.
        // Both stay editable — the listing is the starting point, not a cap the prescriber can't
        // exceed. Going over simply routes them through the Authority step (see RequiresAuthorityStep).
        _form.Route ??= candidate.Route;
        if (candidate.MaxRepeats is > 0) _form.Repeats = candidate.MaxRepeats.Value;

        await RunSafetyCheckAsync();
    }

    private async Task UseFreeTextMedicineAsync()
    {
        _selectedMedicine = null;
        _form.MedicineId = null;
        _form.MedicineName = _drugSearchTerm;
        await RunSafetyCheckAsync();
    }

    private void ChangeMedicine()
    {
        _selectedMedicine = null;
        _form.MedicineId = null;
        _form.MedicineName = string.Empty;
        _drugSearchTerm = string.Empty;
        _drugSearchResults = new();
        _safetyResult = null;
    }

    private async Task RunSafetyCheckAsync()
    {
        _form.SafetyOverrideAcknowledged = false;
        _form.SafetyOverrideNote = null;
        _safetyResult = await PrescriptionService.CheckSafetyAsync(ClientId, new CheckPrescriptionSafetyDto
        {
            MedicineId = _form.MedicineId,
            MedicineName = _form.MedicineName,
            GenericName = _selectedMedicine?.GenericName
        });
    }

    private async Task CreateEpisodeAsync()
    {
        if (string.IsNullOrWhiteSpace(_newEpisodeTitle)) return;
        var id = await EpisodeService.CreateAsync(new CreateEpisodeDto { ClientId = ClientId, Title = _newEpisodeTitle });
        if (id != null)
        {
            _episodes = await EpisodeService.GetByClientIdAsync(ClientId);
            _form.EpisodeId = id;
            _newEpisodeTitle = string.Empty;
            _showNewEpisodeInput = false;
        }
    }

    // Per-step validation, run before advancing — mirrors legacy Medinet's per-dialog OK
    // validation (PRESCRIBING-BUSINESS-RULES.md §5's "quantity must be non-empty" etc.), with the
    // Schedule 8 state authority code treated as a hard/mandatory gate matching §4.
    private bool ValidateCurrentStep()
    {
        _stepError = null;
        switch (_step)
        {
            case WizardStep.Medicine:
                if (string.IsNullOrWhiteSpace(_form.MedicineName))
                {
                    _stepError = "Select or enter a medicine to continue.";
                    return false;
                }
                return true;
            case WizardStep.Dosage:
                return true;
            case WizardStep.QuantityRepeats:
                if (string.IsNullOrWhiteSpace(_form.Quantity))
                {
                    _stepError = "Quantity is required for a limited-duration script.";
                    return false;
                }
                if (_form.DurationDays is null or <= 0)
                {
                    _stepError = "Duration (days) must be greater than 0 for a limited-duration script.";
                    return false;
                }
                return true;
            case WizardStep.Authority:
                if (_selectedMedicine?.RestrictionLevel == PbsRestrictionLevel.Restricted && !_rbAcknowledged)
                {
                    _stepError = "Confirm the Restricted Benefit indication before continuing.";
                    return false;
                }
                return true;
            case WizardStep.StateAuthority:
                if (string.IsNullOrWhiteSpace(_form.StateAuthorityCode))
                {
                    _stepError = "A state authority code is mandatory for Schedule 8 prescribing.";
                    return false;
                }
                return true;
            default:
                return true;
        }
    }

    private void GoNext()
    {
        if (!ValidateCurrentStep()) return;
        var steps = VisibleSteps.ToList();
        var idx = steps.IndexOf(_step);
        if (idx < steps.Count - 1)
        {
            _step = steps[idx + 1];
            _stepError = null;
        }
    }

    private void GoBack()
    {
        _stepError = null;
        var steps = VisibleSteps.ToList();
        var idx = steps.IndexOf(_step);
        if (idx > 0)
        {
            _step = steps[idx - 1];
        }
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _saveError = null;
        try
        {
            var id = await PrescriptionService.CreateAsync(_form);
            if (id == null)
            {
                _saveError = "Save failed — check your permissions.";
            }
            else
            {
                _createdId = id;
                var created = (await PrescriptionService.GetByClientIdAsync(ClientId, includeInactive: true))
                    .FirstOrDefault(p => p.Id == id);
                _createdScriptNumber = created?.ScriptNumber;
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task IssueAndPrintAsync()
    {
        if (_createdId == null) return;
        _isIssuing = true;
        try
        {
            var issueId = await PrescriptionService.IssueAsync(ClientId, _createdId.Value, new IssuePrescriptionDto
            {
                IssuedByPractitionerId = _form.PrescribedByPractitionerId
            });
            if (issueId != null)
            {
                Nav.NavigateTo($"/prescriptions/print/{issueId}");
            }
        }
        finally
        {
            _isIssuing = false;
        }
    }
}
