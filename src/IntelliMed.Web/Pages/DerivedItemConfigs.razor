@page "/derived-item-configs"
@layout MainLayout
@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Entities
@using IntelliMed.Web.Services
@inject IDerivedItemConfigService ConfigService
@inject IBillingItemService BillingItemService
@inject IJSRuntime JS

<PageTitle>Derived Item Rules - IntelliMed</PageTitle>

<h4 class="mb-2">Derived Item Rules</h4>
<p class="text-muted small">
    Configures MBS items whose fee is computed from other items on the same invoice (assistant-at-surgery,
    after-hours anaesthesia-assistance modifiers, per-patient-seen billing, discontinued procedures, etc.)
    instead of a flat fee-schedule lookup. Ported field-for-field from legacy Pracnet's DerivedFeeCalculator.
    There's no bulk-import source for this data — add rules one at a time as you identify them.
</p>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between py-2">
        <span class="small text-muted"><i class="bi bi-calculator me-1"></i> Total: <strong>@_configs.Count</strong></span>
        <button class="btn btn-sm btn-primary" @onclick="OpenCreateDialog">
            <i class="bi bi-plus-lg me-1"></i> Add Rule
        </button>
    </div>

    @if (_loading)
    {
        <div class="card-body text-muted small">Loading...</div>
    }
    else if (_configs.Count == 0)
    {
        <div class="card-body text-muted small">No derived-item rules yet. Click "Add Rule" to create one.</div>
    }
    else
    {
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr>
                    <th>Item#</th>
                    <th>Description</th>
                    <th>Calculation</th>
                    <th>Associated Item</th>
                    <th>Value</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var config in _configs)
                {
                    <tr>
                        <td>@config.ItemNumber</td>
                        <td>@config.Description</td>
                        <td>@CalculationTypeLabel(config.CalculationType)</td>
                        <td>@AssociatedItemDisplay(config)</td>
                        <td>@ValueSummary(config)</td>
                        <td>
                            @if (config.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditDialog(config)"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(config)"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" aria-live="polite" aria-atomic="true">
    @if (_toastMessage != null)
    {
        <div class="toast show align-items-center @(_toastIsError ? "text-bg-danger" : "text-bg-success") border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">@_toastMessage</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="() => _toastMessage = null" aria-label="Close"></button>
            </div>
        </div>
    }
</div>

@if (_dialogVisible)
{
    <div class="modal-backdrop fade show" style="display:block;"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title">@(_isEditing ? "Edit Derived Item Rule" : "New Derived Item Rule")</h5>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Billing Item <span class="text-danger">*</span></label>
                        @if (_isEditing)
                        {
                            <input class="form-control" value="@($"{_billingItemLabel}")" readonly />
                        }
                        else
                        {
                            <input class="form-control form-control-sm mb-2" placeholder="Search by item number or description..."
                                   @bind="_billingItemSearchTerm" @bind:event="oninput" @bind:after="SearchBillingItemsAsync" />
                            @if (_billingItemSearchResults.Count > 0)
                            {
                                <ul class="list-group" style="max-height:180px; overflow-y:auto;">
                                    @foreach (var candidate in _billingItemSearchResults)
                                    {
                                        <li class="list-group-item list-group-item-action @(_model.BillingItemId == candidate.Id ? "active" : "")"
                                            style="cursor:pointer" @onclick="() => SelectBillingItem(candidate)">
                                            <strong>@candidate.ItemNumber</strong> — @candidate.Description
                                        </li>
                                    }
                                </ul>
                            }
                            @if (_billingItemLabel != null)
                            {
                                <div class="small text-success mt-1"><i class="bi bi-check-circle me-1"></i>@_billingItemLabel</div>
                            }
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Calculation Type</label>
                        <InputSelect @bind-Value="_model.CalculationType" class="form-select">
                            <option value="@DerivedCalculationType.PercentageOfAssociatedItem">Percentage of Associated Item</option>
                            <option value="@DerivedCalculationType.ExcisionMalignantTumour">Excision Malignant Tumour (% of associated item)</option>
                            <option value="@DerivedCalculationType.ProcedureDiscontinued">Procedure Discontinued (% of every other line)</option>
                            <option value="@DerivedCalculationType.CombinationOperations">Combination Operations (% of invoice total)</option>
                            <option value="@DerivedCalculationType.AssistanceAnaesthesia">Assistance / Anaesthesia (gated 4-group)</option>
                            <option value="@DerivedCalculationType.BasicUnits">Basic Units (gated group sum)</option>
                            <option value="@DerivedCalculationType.NumberOfPatientsSeen">Number of Patients Seen</option>
                            <option value="@DerivedCalculationType.FieldQuantity">Field Quantity</option>
                            <option value="@DerivedCalculationType.TimeDuration">Time Duration</option>
                        </InputSelect>
                    </div>

                    @if (UsesAssociationSelector(_model.CalculationType))
                    {
                        <div class="mb-3">
                            <label class="form-label d-block">Match Associated Item By</label>
                            <div class="btn-group btn-group-sm" role="group">
                                <input type="radio" class="btn-check" name="assocMode" id="assocModeItem" checked="@(_associationMode == AssociationMode.SpecificItem)" @onchange="() => SetAssociationMode(AssociationMode.SpecificItem)" />
                                <label class="btn btn-outline-primary" for="assocModeItem">Specific Item</label>
                                <input type="radio" class="btn-check" name="assocMode" id="assocModeGroup" checked="@(_associationMode == AssociationMode.MbsGroup)" @onchange="() => SetAssociationMode(AssociationMode.MbsGroup)" />
                                <label class="btn btn-outline-primary" for="assocModeGroup">MBS Group</label>
                                <input type="radio" class="btn-check" name="assocMode" id="assocModeList" checked="@(_associationMode == AssociationMode.ItemNumberList)" @onchange="() => SetAssociationMode(AssociationMode.ItemNumberList)" />
                                <label class="btn btn-outline-primary" for="assocModeList">Item Number List</label>
                            </div>
                        </div>

                        @if (_associationMode == AssociationMode.SpecificItem)
                        {
                            <div class="mb-3">
                                <label class="form-label">Associated Billing Item</label>
                                <input class="form-control form-control-sm mb-2" placeholder="Search by item number or description..."
                                       @bind="_associatedSearchTerm" @bind:event="oninput" @bind:after="SearchAssociatedItemsAsync" />
                                @if (_associatedSearchResults.Count > 0)
                                {
                                    <ul class="list-group" style="max-height:150px; overflow-y:auto;">
                                        @foreach (var candidate in _associatedSearchResults)
                                        {
                                            <li class="list-group-item list-group-item-action @(_model.AssociatedBillingItemId == candidate.Id ? "active" : "")"
                                                style="cursor:pointer" @onclick="() => SelectAssociatedItem(candidate)">
                                                <strong>@candidate.ItemNumber</strong> — @candidate.Description
                                            </li>
                                        }
                                    </ul>
                                }
                                @if (_associatedItemLabel != null)
                                {
                                    <div class="small text-success mt-1"><i class="bi bi-check-circle me-1"></i>@_associatedItemLabel</div>
                                }
                            </div>
                        }
                        else if (_associationMode == AssociationMode.MbsGroup)
                        {
                            <div class="mb-3">
                                <label class="form-label">MBS Group Code</label>
                                <input class="form-control form-control-sm" placeholder="e.g. T8" @bind="_model.AssociatedGroup" />
                                <div class="small text-muted mt-1">Sums every sibling line whose MBS Group equals this code.</div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label">Item Numbers</label>
                                <input class="form-control form-control-sm" placeholder="e.g. 25200-25205, 23010-24136" @bind="_model.AssociatedItemNumbers" />
                                <div class="small text-muted mt-1">Comma/space-separated item numbers; "X-Y" expands to every number in that range.</div>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Percentage (%)</label>
                            <input type="number" step="0.01" class="form-control" @bind="_model.Percentage" />
                        </div>
                    }

                    @if (_model.CalculationType == DerivedCalculationType.ProcedureDiscontinued)
                    {
                        <div class="mb-3">
                            <label class="form-label">Percentage (%)</label>
                            <input type="number" step="0.01" class="form-control" @bind="_model.Percentage" />
                            <div class="small text-muted mt-1">Applied to every OTHER line on the invoice (no association filter).</div>
                        </div>
                    }

                    @if (_model.CalculationType == DerivedCalculationType.CombinationOperations)
                    {
                        <div class="mb-3">
                            <label class="form-label">Percentage of Invoice Total (%)</label>
                            <input type="number" step="0.01" class="form-control" @bind="_model.PercentageFromInvoiceTotal" />
                            <div class="small text-muted mt-1">Applied to every OTHER line on the invoice.</div>
                        </div>
                    }

                    @if (_model.CalculationType == DerivedCalculationType.AssistanceAnaesthesia)
                    {
                        <div class="small text-muted mb-2">Fires only when both Group A and Group B have a matching sibling line; sums every sibling matching any of the 4 groups.</div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small mb-0">Group A Item Numbers</label>
                                <input class="form-control form-control-sm" @bind="_model.GroupAAssociatedItems" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-0">Group B Item Numbers</label>
                                <input class="form-control form-control-sm" @bind="_model.GroupBAssociatedItems" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-0">Group C Item Numbers (optional)</label>
                                <input class="form-control form-control-sm" @bind="_model.GroupCAssociatedItems" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-0">Group D Item Numbers (optional)</label>
                                <input class="form-control form-control-sm" @bind="_model.GroupDAssociatedItems" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Percentage (%)</label>
                            <input type="number" step="0.01" class="form-control" @bind="_model.Percentage" />
                        </div>
                    }

                    @if (_model.CalculationType == DerivedCalculationType.BasicUnits)
                    {
                        <div class="small text-muted mb-2">Fires only when Group A has a matching sibling line; fee = base + raw sum of sibling fees matching Group A/B/C.</div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Group A Item Numbers</label>
                                <input class="form-control form-control-sm" @bind="_model.GroupAAssociatedItems" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Group B Item Numbers (optional)</label>
                                <input class="form-control form-control-sm" @bind="_model.GroupBAssociatedItems" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Group C Item Numbers (optional)</label>
                                <input class="form-control form-control-sm" @bind="_model.GroupCAssociatedItems" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Base Fee ($)</label>
                            <input type="number" step="0.01" class="form-control" @bind="_model.CalculateFromFee" />
                        </div>
                    }

                    @if (_model.CalculationType == DerivedCalculationType.NumberOfPatientsSeen)
                    {
                        <div class="mb-3">
                            <label class="form-label">Base Fee ($) — leave blank to use the associated item's fee instead</label>
                            <input type="number" step="0.01" class="form-control" @bind="_model.CalculateFromFee" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Associated Billing Item (used when Base Fee is blank)</label>
                            <input class="form-control form-control-sm mb-2" placeholder="Search by item number or description..."
                                   @bind="_associatedSearchTerm" @bind:event="oninput" @bind:after="SearchAssociatedItemsAsync" />
                            @if (_associatedSearchResults.Count > 0)
                            {
                                <ul class="list-group" style="max-height:150px; overflow-y:auto;">
                                    @foreach (var candidate in _associatedSearchResults)
                                    {
                                        <li class="list-group-item list-group-item-action @(_model.AssociatedBillingItemId == candidate.Id ? "active" : "")"
                                            style="cursor:pointer" @onclick="() => SelectAssociatedItem(candidate)">
                                            <strong>@candidate.ItemNumber</strong> — @candidate.Description
                                        </li>
                                    }
                                </ul>
                            }
                            @if (_associatedItemLabel != null)
                            {
                                <div class="small text-success mt-1"><i class="bi bi-check-circle me-1"></i>@_associatedItemLabel</div>
                            }
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Patient Limit</label>
                                <input type="number" class="form-control form-control-sm" @bind="_model.NumOfLimitPatient" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Under-Limit Total ($)</label>
                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="_model.UnderNumOfLimitPatientPlusTotal" />
                                <div class="small text-muted">Divided by patient count when at/under the limit.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Over-Limit Plus ($)</label>
                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="_model.OverNumOfLimitPatientPlus" />
                            </div>
                        </div>
                    }

                    @if (_model.CalculationType is DerivedCalculationType.FieldQuantity or DerivedCalculationType.TimeDuration)
                    {
                        <div class="mb-3">
                            <label class="form-label">Associated Billing Item</label>
                            <input class="form-control form-control-sm mb-2" placeholder="Search by item number or description..."
                                   @bind="_associatedSearchTerm" @bind:event="oninput" @bind:after="SearchAssociatedItemsAsync" />
                            @if (_associatedSearchResults.Count > 0)
                            {
                                <ul class="list-group" style="max-height:150px; overflow-y:auto;">
                                    @foreach (var candidate in _associatedSearchResults)
                                    {
                                        <li class="list-group-item list-group-item-action @(_model.AssociatedBillingItemId == candidate.Id ? "active" : "")"
                                            style="cursor:pointer" @onclick="() => SelectAssociatedItem(candidate)">
                                            <strong>@candidate.ItemNumber</strong> — @candidate.Description
                                        </li>
                                    }
                                </ul>
                            }
                            @if (_associatedItemLabel != null)
                            {
                                <div class="small text-success mt-1"><i class="bi bi-check-circle me-1"></i>@_associatedItemLabel</div>
                            }
                        </div>
                        <div class="row g-2 mb-3">
                            @if (_model.CalculationType == DerivedCalculationType.FieldQuantity)
                            {
                                <div class="col-md-6">
                                    <label class="form-label small mb-0">Quantity Limit</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" @bind="_model.NumberOfLimitQuantity" />
                                </div>
                            }
                            <div class="col-md-6">
                                <label class="form-label small mb-0">Over-Limit Plus ($/unit)</label>
                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="_model.OverLimitQuantityPlus" />
                                @if (_model.CalculationType == DerivedCalculationType.TimeDuration)
                                {
                                    <div class="small text-muted">Multiplied by the full quantity, not just the over-limit portion.</div>
                                }
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" rows="2" @bind="_model.Notes"></textarea>
                    </div>

                    @if (_isEditing)
                    {
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" @bind="_model.IsActive" id="activeSwitch" />
                            <label class="form-check-label" for="activeSwitch">Active</label>
                        </div>
                    }
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@(_saving || _model.BillingItemId == 0)">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DerivedItemConfigDto> _configs = new();
    private bool _loading;
    private bool _saving;
    private string? _toastMessage;
    private bool _toastIsError;

    private bool _dialogVisible;
    private bool _isEditing;
    private int _editingId;
    private DialogModel _model = new();

    private string _billingItemSearchTerm = string.Empty;
    private List<BillingItemDto> _billingItemSearchResults = new();
    private string? _billingItemLabel;

    private string _associatedSearchTerm = string.Empty;
    private List<BillingItemDto> _associatedSearchResults = new();
    private string? _associatedItemLabel;
    private AssociationMode _associationMode = AssociationMode.SpecificItem;

    private enum AssociationMode { SpecificItem, MbsGroup, ItemNumberList }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _configs = await ConfigService.GetAllAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool UsesAssociationSelector(DerivedCalculationType type) =>
        type is DerivedCalculationType.PercentageOfAssociatedItem or DerivedCalculationType.ExcisionMalignantTumour;

    private static bool UsesSingleAssociatedItem(DerivedCalculationType type) =>
        type is DerivedCalculationType.NumberOfPatientsSeen or DerivedCalculationType.FieldQuantity or DerivedCalculationType.TimeDuration;

    private static string CalculationTypeLabel(DerivedCalculationType type) => type switch
    {
        DerivedCalculationType.PercentageOfAssociatedItem => "% of Associated Item",
        DerivedCalculationType.ExcisionMalignantTumour => "Excision Malignant Tumour",
        DerivedCalculationType.ProcedureDiscontinued => "Procedure Discontinued",
        DerivedCalculationType.CombinationOperations => "Combination Operations",
        DerivedCalculationType.AssistanceAnaesthesia => "Assistance / Anaesthesia",
        DerivedCalculationType.BasicUnits => "Basic Units",
        DerivedCalculationType.FieldQuantity => "Field Quantity",
        DerivedCalculationType.TimeDuration => "Time Duration",
        DerivedCalculationType.NumberOfPatientsSeen => "Patients Seen",
        _ => type.ToString()
    };

    private static string ValueSummary(DerivedItemConfigDto config) => config.CalculationType switch
    {
        DerivedCalculationType.CombinationOperations => $"{config.PercentageFromInvoiceTotal ?? 0}%",
        DerivedCalculationType.BasicUnits => $"{config.CalculateFromFee ?? 0:C} base",
        DerivedCalculationType.NumberOfPatientsSeen => config.CalculateFromFee.HasValue ? $"{config.CalculateFromFee:C} base" : "assoc. item fee",
        DerivedCalculationType.FieldQuantity or DerivedCalculationType.TimeDuration => $"{config.OverLimitQuantityPlus ?? 0:C}/unit",
        _ => $"{config.Percentage ?? 0}%"
    };

    private static string AssociatedItemDisplay(DerivedItemConfigDto config) =>
        !string.IsNullOrEmpty(config.AssociatedGroup) ? $"Any MBS Group {config.AssociatedGroup}"
        : !string.IsNullOrEmpty(config.AssociatedItemNumbers) ? config.AssociatedItemNumbers
        : config.AssociatedItemNumber ?? "—";

    private void OpenCreateDialog()
    {
        _isEditing = false;
        _model = new DialogModel();
        _billingItemSearchTerm = string.Empty;
        _billingItemSearchResults = new();
        _billingItemLabel = null;
        _associatedSearchTerm = string.Empty;
        _associatedSearchResults = new();
        _associatedItemLabel = null;
        _associationMode = AssociationMode.SpecificItem;
        _dialogVisible = true;
    }

    private void OpenEditDialog(DerivedItemConfigDto config)
    {
        _isEditing = true;
        _editingId = config.Id;
        _model = new DialogModel
        {
            BillingItemId = config.BillingItemId,
            CalculationType = config.CalculationType,
            AssociatedBillingItemId = config.AssociatedBillingItemId,
            AssociatedGroup = config.AssociatedGroup,
            AssociatedItemNumbers = config.AssociatedItemNumbers,
            GroupAAssociatedItems = config.GroupAAssociatedItems,
            GroupBAssociatedItems = config.GroupBAssociatedItems,
            GroupCAssociatedItems = config.GroupCAssociatedItems,
            GroupDAssociatedItems = config.GroupDAssociatedItems,
            Percentage = config.Percentage,
            PercentageFromInvoiceTotal = config.PercentageFromInvoiceTotal,
            CalculateFromFee = config.CalculateFromFee,
            NumOfLimitPatient = config.NumOfLimitPatient,
            UnderNumOfLimitPatientPlusTotal = config.UnderNumOfLimitPatientPlusTotal,
            OverNumOfLimitPatientPlus = config.OverNumOfLimitPatientPlus,
            NumberOfLimitQuantity = config.NumberOfLimitQuantity,
            OverLimitQuantityPlus = config.OverLimitQuantityPlus,
            IsActive = config.IsActive,
            Notes = config.Notes
        };
        _billingItemLabel = $"{config.ItemNumber} — {config.Description}";
        _associatedItemLabel = config.AssociatedItemNumber != null ? $"{config.AssociatedItemNumber} — {config.AssociatedDescription}" : null;
        _associatedSearchTerm = string.Empty;
        _associatedSearchResults = new();
        _associationMode = !string.IsNullOrEmpty(config.AssociatedGroup) ? AssociationMode.MbsGroup
            : !string.IsNullOrEmpty(config.AssociatedItemNumbers) ? AssociationMode.ItemNumberList
            : AssociationMode.SpecificItem;
        _dialogVisible = true;
    }

    private void CloseDialog() => _dialogVisible = false;

    private void SetAssociationMode(AssociationMode mode)
    {
        _associationMode = mode;
        // Only one of the three association fields may be set at a time — clear the others so a
        // stale value from switching modes can't silently get saved alongside the new one.
        _model.AssociatedGroup = mode == AssociationMode.MbsGroup ? _model.AssociatedGroup : null;
        _model.AssociatedItemNumbers = mode == AssociationMode.ItemNumberList ? _model.AssociatedItemNumbers : null;
        if (mode != AssociationMode.SpecificItem)
        {
            _model.AssociatedBillingItemId = null;
            _associatedItemLabel = null;
        }
    }

    private async Task SearchBillingItemsAsync()
    {
        _billingItemSearchResults = string.IsNullOrWhiteSpace(_billingItemSearchTerm)
            ? new()
            : await BillingItemService.SearchAsync(_billingItemSearchTerm);
    }

    private void SelectBillingItem(BillingItemDto candidate)
    {
        _model.BillingItemId = candidate.Id;
        _billingItemLabel = $"{candidate.ItemNumber} — {candidate.Description}";
        _billingItemSearchResults = new();
    }

    private async Task SearchAssociatedItemsAsync()
    {
        _associatedSearchResults = string.IsNullOrWhiteSpace(_associatedSearchTerm)
            ? new()
            : await BillingItemService.SearchAsync(_associatedSearchTerm);
    }

    private void SelectAssociatedItem(BillingItemDto candidate)
    {
        _model.AssociatedBillingItemId = candidate.Id;
        _associatedItemLabel = $"{candidate.ItemNumber} — {candidate.Description}";
        _associatedSearchResults = new();
    }


    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            bool success;
            if (_isEditing)
            {
                success = await ConfigService.UpdateAsync(_editingId, new UpdateDerivedItemConfigDto
                {
                    CalculationType = _model.CalculationType,
                    AssociatedBillingItemId = _model.AssociatedBillingItemId,
                    AssociatedGroup = _model.AssociatedGroup,
                    AssociatedItemNumbers = _model.AssociatedItemNumbers,
                    GroupAAssociatedItems = _model.GroupAAssociatedItems,
                    GroupBAssociatedItems = _model.GroupBAssociatedItems,
                    GroupCAssociatedItems = _model.GroupCAssociatedItems,
                    GroupDAssociatedItems = _model.GroupDAssociatedItems,
                    Percentage = _model.Percentage,
                    PercentageFromInvoiceTotal = _model.PercentageFromInvoiceTotal,
                    CalculateFromFee = _model.CalculateFromFee,
                    NumOfLimitPatient = _model.NumOfLimitPatient,
                    UnderNumOfLimitPatientPlusTotal = _model.UnderNumOfLimitPatientPlusTotal,
                    OverNumOfLimitPatientPlus = _model.OverNumOfLimitPatientPlus,
                    NumberOfLimitQuantity = _model.NumberOfLimitQuantity,
                    OverLimitQuantityPlus = _model.OverLimitQuantityPlus,
                    IsActive = _model.IsActive,
                    Notes = _model.Notes
                });
            }
            else
            {
                success = await ConfigService.CreateAsync(new CreateDerivedItemConfigDto
                {
                    BillingItemId = _model.BillingItemId,
                    CalculationType = _model.CalculationType,
                    AssociatedBillingItemId = _model.AssociatedBillingItemId,
                    AssociatedGroup = _model.AssociatedGroup,
                    AssociatedItemNumbers = _model.AssociatedItemNumbers,
                    GroupAAssociatedItems = _model.GroupAAssociatedItems,
                    GroupBAssociatedItems = _model.GroupBAssociatedItems,
                    GroupCAssociatedItems = _model.GroupCAssociatedItems,
                    GroupDAssociatedItems = _model.GroupDAssociatedItems,
                    Percentage = _model.Percentage,
                    PercentageFromInvoiceTotal = _model.PercentageFromInvoiceTotal,
                    CalculateFromFee = _model.CalculateFromFee,
                    NumOfLimitPatient = _model.NumOfLimitPatient,
                    UnderNumOfLimitPatientPlusTotal = _model.UnderNumOfLimitPatientPlusTotal,
                    OverNumOfLimitPatientPlus = _model.OverNumOfLimitPatientPlus,
                    NumberOfLimitQuantity = _model.NumberOfLimitQuantity,
                    OverLimitQuantityPlus = _model.OverLimitQuantityPlus,
                    Notes = _model.Notes
                }) != null;
            }

            if (success)
            {
                ShowToast(_isEditing ? "Rule updated." : "Rule created.", false);
                _dialogVisible = false;
                await LoadAsync();
            }
            else
            {
                ShowToast("Failed to save rule.", true);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(DerivedItemConfigDto config)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete the derived-item rule for item {config.ItemNumber}?");
        if (!confirmed) return;

        var success = await ConfigService.DeleteAsync(config.Id);
        ShowToast(success ? "Rule deleted." : "Failed to delete rule.", !success);
        if (success) await LoadAsync();
    }

    private void ShowToast(string message, bool isError)
    {
        _toastMessage = message;
        _toastIsError = isError;
    }

