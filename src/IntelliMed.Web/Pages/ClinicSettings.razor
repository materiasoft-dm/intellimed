@page "/clinic-settings"
@layout MainLayout
@using System.ComponentModel.DataAnnotations
@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Entities
@using IntelliMed.Web.Services
@inject IClinicSettingsService ClinicSettingsService
@inject IBillingItemService BillingItemService
@inject IInvoiceService InvoiceService
@inject IFeeScheduleService FeeScheduleService

<PageTitle>Clinic Settings - IntelliMed</PageTitle>

<h4 class="mb-4">Clinic Settings</h4>

@if (_isLoading)
{
    <div class="card text-center py-5">
        <div class="card-body">
            <span class="spinner-border spinner-border-sm text-primary me-2"></span>
            Loading clinic settings...
        </div>
    </div>
}
else if (_forbidden)
{
    <div class="alert alert-danger">You don't have access to this page.</div>
}
else if (_settings == null)
{
    <div class="alert alert-danger">Failed to load clinic settings. Please try reloading the page.</div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header"><strong>Practice Information</strong></div>
                <div class="card-body">
                    <EditForm Model="@_model" OnValidSubmit="SaveAsync" FormName="clinicSettingsForm">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger small mb-3" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label class="form-label">Practice Name <span class="text-danger">*</span></label>
                                <InputText @bind-Value="_model.PracticeName" class="form-control" />
                                <ValidationMessage For="() => _model.PracticeName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">ABN</label>
                                <InputText @bind-Value="_model.Abn" class="form-control" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Phone</label>
                                <InputText @bind-Value="_model.Phone" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Fax</label>
                                <InputText @bind-Value="_model.Fax" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Email</label>
                                <InputText @bind-Value="_model.Email" class="form-control" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-12">
                                <label class="form-label">Website</label>
                                <InputText @bind-Value="_model.Website" class="form-control" />
                            </div>
                        </div>

                        <hr class="my-4" />
                        <h6 class="mb-3">Scheduling</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label class="form-label">Minimum Appointment Timeslot (minutes)</label>
                                <InputNumber @bind-Value="_model.MinimumTimeslotMinutes" class="form-control" />
                                <div class="form-text">Granularity of the appointment calendar's time grid. Staff can override this for themselves in Profile Settings.</div>
                            </div>
                        </div>

                        <hr class="my-4" />
                        <h6 class="mb-3">Address</h6>
                        <div class="row g-3 mb-2">
                            <div class="col-md-12">
                                <label class="form-label small mb-0">Address</label>
                                <InputText @bind-Value="_model.Address" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small mb-0">Suburb</label>
                                <InputText @bind-Value="_model.Suburb" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small mb-0">Postcode</label>
                                <InputText @bind-Value="_model.Postcode" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small mb-0">State</label>
                                <InputText @bind-Value="_model.State" class="form-control form-control-sm" />
                            </div>
                        </div>

                        <hr class="my-4" />
                        <h6 class="mb-3">Email (SMTP)</h6>
                        <div class="row g-3 mb-2">
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="smtpEnabled"
                                           checked="@_model.SmtpEnabled"
                                           @onchange="(ChangeEventArgs e) => _model.SmtpEnabled = (bool)e.Value!" />
                                    <label class="form-check-label" for="smtpEnabled">Enable email sending</label>
                                </div>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label class="form-label">SMTP Host</label>
                                <InputText @bind-Value="_model.SmtpHost" class="form-control" placeholder="smtp.example.com" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Port</label>
                                <InputNumber @bind-Value="_model.SmtpPort" class="form-control" />
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Username</label>
                                <InputText @bind-Value="_model.SmtpUsername" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Password</label>
                                <InputText @bind-Value="_model.SmtpPassword" type="password" class="form-control" />
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">From Email</label>
                                <InputText @bind-Value="_model.SmtpFromEmail" class="form-control" placeholder="no-reply@yourclinic.com" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">From Name</label>
                                <InputText @bind-Value="_model.SmtpFromName" class="form-control" placeholder="@_model.PracticeName" />
                            </div>
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="smtpUseSsl"
                                           checked="@_model.SmtpUseSsl"
                                           @onchange="(ChangeEventArgs e) => _model.SmtpUseSsl = (bool)e.Value!" />
                                    <label class="form-check-label" for="smtpUseSsl">Use SSL/TLS</label>
                                </div>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenTestEmailDialog">
                                    <i class="bi bi-send me-1"></i>Send Test Email
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span><i class="bi bi-save me-1"></i>Save Changes</span>
                            }
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header"><strong>Billing Item Catalog</strong></div>
                <div class="card-body">
                    <p class="small text-muted">
                        Refreshes the invoice line-item picker from the free, official Medicare
                        Benefits Schedule (MBS) published quarterly by the Department of Health.
                    </p>
                    <button type="button" class="btn btn-outline-primary" disabled="@_isSyncing" @onclick="SyncBillingItemsAsync">
                        @if (_isSyncing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Updating...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-cloud-download me-1"></i>Update Fees &amp; Bill Items</span>
                        }
                    </button>
                    @if (_lastSyncResult != null)
                    {
                        <div class="small text-muted mt-3">
                            Last sync @_lastSyncResult.SyncedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"):
                            @_lastSyncResult.Added added, @_lastSyncResult.Updated updated, @_lastSyncResult.Deactivated deactivated.
                        </div>
                    }
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header"><strong>Account Type → Fee Schedule</strong></div>
                <div class="card-body">
                    <p class="small text-muted">
                        Maps each account type to the fee schedule that prices its invoice lines. For the
                        Medicare rebate to resolve, also create schedules coded <code>BBGP</code>,
                        <code>BBO</code> and <code>BBI</code> and populate them via Fee Schedules → Items.
                    </p>
                    @foreach (var mapping in _mappings)
                    {
                        <div class="row g-2 align-items-center mb-2">
                            <div class="col-5 small">@AccountTypeLabel(mapping.AccountType)</div>
                            <div class="col-7">
                                <select class="form-select form-select-sm"
                                        value="@(mapping.FeeScheduleId?.ToString() ?? "")"
                                        @onchange="@(e => SaveMappingAsync(mapping, e.Value?.ToString()))">
                                    <option value="">-- None --</option>
                                    @foreach (var schedule in _feeSchedules)
                                    {
                                        <option value="@schedule.Id">@schedule.Code - @schedule.Description</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (_toastMessage != null)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        <div class="toast show align-items-center @(_toastIsError ? "text-bg-danger" : "text-bg-success") border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">@_toastMessage</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="DismissToast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

@* =========================================================================
   SEND TEST EMAIL MODAL
   ========================================================================= *@
@if (_testEmailVisible)
{
    <div class="modal-backdrop fade show" style="display:block;"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Send Test Email</h5>
                    <button type="button" class="btn-close" @onclick="() => _testEmailVisible = false" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Email Address <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" @bind="_testEmailModel.ToEmail" @bind:event="oninput" placeholder="you@example.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Message</label>
                        <textarea class="form-control" rows="4" @bind="_testEmailModel.Message" @bind:event="oninput"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _testEmailVisible = false">Cancel</button>
                    <button type="button" class="btn btn-primary"
                            @onclick="SendTestEmailAsync"
                            disabled="@(string.IsNullOrWhiteSpace(_testEmailModel.ToEmail) || _testEmailSending)">
                        @if (_testEmailSending)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-send me-1"></i>Send</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isSyncing;
    private bool _forbidden;
    private ClinicSettingsDto? _settings;
    private ClinicSettingsFormModel _model = new();
    private BillingItemSyncResultDto? _lastSyncResult;
    private List<AccountTypeFeeScheduleMappingDto> _mappings = new();
    private List<FeeScheduleDto> _feeSchedules = new();
    private string? _toastMessage;
    private bool _toastIsError;

    private bool _testEmailVisible;
    private bool _testEmailSending;
    private TestEmailRequest _testEmailModel = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await ClinicSettingsService.GetAsync();
        if (_settings == null)
        {
            _forbidden = true;
        }
        else
        {
            _model = new ClinicSettingsFormModel
            {
                PracticeName = _settings.PracticeName,
                Abn = _settings.Abn,
                Phone = _settings.Phone,
                Fax = _settings.Fax,
                Email = _settings.Email,
                Website = _settings.Website,
                Address = _settings.Address,
                Suburb = _settings.Suburb,
                Postcode = _settings.Postcode,
                State = _settings.State,
                MinimumTimeslotMinutes = _settings.MinimumTimeslotMinutes,
                SmtpEnabled = _settings.SmtpEnabled,
                SmtpHost = _settings.SmtpHost,
                SmtpPort = _settings.SmtpPort,
                SmtpUsername = _settings.SmtpUsername,
                SmtpPassword = _settings.SmtpPassword,
                SmtpFromEmail = _settings.SmtpFromEmail,
                SmtpFromName = _settings.SmtpFromName,
                SmtpUseSsl = _settings.SmtpUseSsl
            };

            _feeSchedules = await FeeScheduleService.GetAllActiveAsync();
            _mappings = await InvoiceService.GetFeeScheduleMappingsAsync();
        }
        _isLoading = false;
    }

    private void OpenTestEmailDialog()
    {
        _testEmailModel = new TestEmailRequest { Message = "This is a test email" };
        _testEmailVisible = true;
    }

    private async Task SendTestEmailAsync()
    {
        _testEmailSending = true;
        StateHasChanged();
        try
        {
            var (success, message) = await ClinicSettingsService.SendTestEmailAsync(_testEmailModel);
            ShowToast(message ?? (success ? "Test email sent." : "Failed to send test email."), !success);
            if (success) _testEmailVisible = false;
        }
        finally
        {
            _testEmailSending = false;
        }
    }

    private static string AccountTypeLabel(AccountTypeEnum type) => type switch
    {
        AccountTypeEnum.BulkBill => "Bulk Bill",
        AccountTypeEnum.PrivatePatient => "Private Patient",
        AccountTypeEnum.Veteran => "DVA (Veteran)",
        AccountTypeEnum.WorkCover => "WorkCover",
        AccountTypeEnum.Tac => "TAC",
        AccountTypeEnum.Imc => "IMC",
        AccountTypeEnum.Ovs => "OVS",
        AccountTypeEnum.ChildImm => "Immunisation",
        _ => type.ToString()
    };

    private async Task SaveMappingAsync(AccountTypeFeeScheduleMappingDto mapping, string? feeScheduleId)
    {
        int? scheduleId = int.TryParse(feeScheduleId, out var id) ? id : null;
        mapping.FeeScheduleId = scheduleId;

        var success = await InvoiceService.SaveFeeScheduleMappingAsync(new SaveAccountTypeFeeScheduleMappingDto
        {
            AccountType = mapping.AccountType,
            FeeScheduleId = scheduleId
        });
        ShowToast(success ? $"{AccountTypeLabel(mapping.AccountType)} mapping saved." : "Failed to save mapping.", !success);
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        try
        {
            var request = new UpdateClinicSettingsRequest
            {
                PracticeName = _model.PracticeName,
                Abn = _model.Abn,
                Phone = _model.Phone,
                Fax = _model.Fax,
                Email = _model.Email,
                Website = _model.Website,
                Address = _model.Address,
                Suburb = _model.Suburb,
                Postcode = _model.Postcode,
                State = _model.State,
                MinimumTimeslotMinutes = _model.MinimumTimeslotMinutes,
                SmtpEnabled = _model.SmtpEnabled,
                SmtpHost = _model.SmtpHost,
                SmtpPort = _model.SmtpPort,
                SmtpUsername = _model.SmtpUsername,
                SmtpPassword = _model.SmtpPassword,
                SmtpFromEmail = _model.SmtpFromEmail,
                SmtpFromName = _model.SmtpFromName,
                SmtpUseSsl = _model.SmtpUseSsl
            };

            var success = await ClinicSettingsService.UpdateAsync(request);
            ShowToast(success ? "Clinic settings updated successfully." : "Failed to update clinic settings.", !success);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SyncBillingItemsAsync()
    {
        _isSyncing = true;
        try
        {
            var result = await BillingItemService.SyncAsync();
            if (result != null)
            {
                _lastSyncResult = result;
                ShowToast($"Billing items updated: {result.Added} added, {result.Updated} updated, {result.Deactivated} deactivated.");
            }
            else
            {
                ShowToast("Failed to update billing items.", true);
            }
        }
        finally
        {
            _isSyncing = false;
        }
    }

    private void ShowToast(string message, bool isError = false)
    {
        _toastMessage = message;
        _toastIsError = isError;
    }

    private void DismissToast()
    {
        _toastMessage = null;
    }

    private class ClinicSettingsFormModel
    {
        [Required]
        public string PracticeName { get; set; } = string.Empty;
        public string? Abn { get; set; }
        public string? Phone { get; set; }
        public string? Fax { get; set; }
        public string? Email { get; set; }
        public string? Website { get; set; }
        public string? Address { get; set; }
        public string? Suburb { get; set; }
        public string? Postcode { get; set; }
        public string? State { get; set; }
        [Range(1, 240)]
        public int MinimumTimeslotMinutes { get; set; } = 15;

        public bool SmtpEnabled { get; set; }
        public string? SmtpHost { get; set; }
        [Range(1, 65535)]
        public int SmtpPort { get; set; } = 587;
        public string? SmtpUsername { get; set; }
        public string? SmtpPassword { get; set; }
        public string? SmtpFromEmail { get; set; }
        public string? SmtpFromName { get; set; }
        public bool SmtpUseSsl { get; set; } = true;
    }
}
