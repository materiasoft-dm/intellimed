@page "/admin/medicines"
@layout MainLayout
@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Entities
@using IntelliMed.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IMedicineService MedicineService
@inject IJSRuntime JS

<PageTitle>Medicine Catalog - IntelliMed</PageTitle>

<h4 class="mb-1">Medicine Catalog</h4>
<p class="text-muted small mb-4">
    A self-hosted medicines reference list — built without a MIMS subscription. Today this is seeded
    from the PBS API Public v3 (Australian Pharmaceutical Benefits Scheme), Wikidata (CC0-licensed
    generic names with ATC codes), and CSV import. See the README for the licensing status of each
    source.
</p>

<div class="card mb-3">
    <div class="card-header"><strong>Sync from Sources</strong></div>
    <div class="card-body">
        <p class="small text-muted mb-2">
            Fetches candidate rows from every registered data source (PBS API Public v3 — Australian
            Pharmaceutical Benefits Scheme, and Wikidata — CC0-licensed generic names with ATC codes),
            imports them directly into the catalog below, then automatically looks up each newly-added
            ingredient on Wikidata for an ATC code. Takes 10-15 minutes — almost all of it spent
            waiting out the PBS API's rate limit, not local work.
        </p>
        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_isSyncing" @onclick="SyncFromSourcesAsync">
            @if (_isSyncing)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            <i class="bi bi-arrow-repeat me-1"></i> Sync from Sources
        </button>
        @if (_syncError != null)
        {
            <div class="small text-danger mt-3">@_syncError</div>
        }
        @if (_lastSyncResult?.ImportResult != null)
        {
            <div class="small text-muted mt-3">
                Last sync: @_lastSyncResult.ImportResult.Added added, @_lastSyncResult.ImportResult.Updated updated,
                @_lastSyncResult.ImportResult.Deactivated deactivated (no longer PBS-listed),
                @_lastSyncResult.ImportResult.Unmatched new ingredient(s) auto-created.
                @if (_lastSyncResult.EnrichmentResult != null)
                {
                    <text> Then enriched @_lastSyncResult.EnrichmentResult.Enriched of @_lastSyncResult.EnrichmentResult.TotalProcessed new ingredient(s) (@_lastSyncResult.EnrichmentResult.NotFound not found on Wikidata).</text>
                }
            </div>
        }
    </div>
</div>

@if (_isSyncing)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-arrow-repeat me-1"></i> Syncing Medicine Catalog</h6>
                </div>
                <div class="modal-body">
                    <div class="d-flex gap-2 mb-3">
                        <span class="badge @StepClass("gather")">1. Gather from sources</span>
                        <span class="badge @StepClass("import")">2. Import</span>
                        <span class="badge @StepClass("enrich")">3. Enrich ingredients</span>
                    </div>
                    <div class="mb-3">
                        <div class="small text-muted mb-1">@_progressStatus</div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 100%;"></div>
                        </div>
                    </div>
                    <div class="border rounded bg-light p-2" style="max-height: 300px; overflow-y: auto;">
                        <div class="small font-monospace">
                            @foreach (var entry in _progressLog)
                            {
                                <div class="text-@(entry.Contains("FAILED", StringComparison.OrdinalIgnoreCase) || entry.Contains("ERROR", StringComparison.OrdinalIgnoreCase) ? "danger" : "muted") mb-1">@entry</div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@(_currentSyncJobId == null || _isCancelling)" @onclick="CancelSyncAsync">
                        @if (_isCancelling)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Cancel Sync
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-header"><strong>Import / Export</strong></div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small mb-0">CSV file</label>
                <InputFile OnChange="OnFileSelected" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">&nbsp;</label>
                <button type="button" class="btn btn-sm btn-primary d-block" disabled="@(_selectedFile == null || _isImporting)" @onclick="ImportAsync">
                    @if (_isImporting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-upload me-1"></i> Import
                </button>
            </div>
            <div class="col-auto ms-auto">
                <label class="form-label small mb-0">&nbsp;</label>
                <button type="button" class="btn btn-sm btn-outline-secondary d-block" disabled="@_isExporting" @onclick="ExportCsvAsync">
                    @if (_isExporting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-download me-1"></i> Download Catalogue CSV
                </button>
            </div>
        </div>
        @if (_lastImportResult != null)
        {
            <div class="small text-muted mt-3">
                Last import @_lastImportResult.ImportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"):
                @_lastImportResult.Added added, @_lastImportResult.Updated updated,
                @_lastImportResult.Deactivated deactivated (no longer PBS-listed),
                @_lastImportResult.Unmatched new ingredient(s) auto-created (not AMT-confirmed).
            </div>
        }
        else if (_importError != null)
        {
            <div class="small text-danger mt-3">@_importError</div>
        }
        @if (_exportError != null)
        {
            <div class="small text-danger mt-3">@_exportError</div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
        <strong>Search</strong>
        <button class="btn btn-sm btn-primary" @onclick="OpenNew"><i class="bi bi-plus-lg"></i> Add Medicine</button>
    </div>
    <div class="card-body">
        <div class="row g-2 mb-3">
            <div class="col-auto">
                <input type="text" class="form-control form-control-sm" style="width:280px"
                       placeholder="Search by name..." @bind="_query" @bind:event="oninput" @bind:after="SearchAsync" />
            </div>
            <div class="col-auto">
                <select class="form-select form-select-sm" style="width:180px" @bind="_sourceFilter" @bind:after="SearchAsync">
                    <option value="">All sources</option>
                    <option value="@MedicineSource.Manual">Manually created</option>
                    <option value="@MedicineSource.Synced">Synced / imported</option>
                </select>
            </div>
        </div>

        @if (_isSearching)
        {
            <div class="text-muted small">Searching...</div>
        }
        else if (_results.Count == 0)
        {
            <div class="text-muted small">No medicines found. Import a CSV above to get started.</div>
        }
        else
        {
            <div style="overflow-x:auto">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Generic Name</th>
                        <th>Strength</th>
                        <th>Form</th>
                        <th>Pack Size</th>
                        <th>Active Ingredient(s)</th>
                        <th>Schedule</th>
                        <th>Subsidy</th>
                        <th>Restriction</th>
                        <th>Source</th>
                        <th>Last Updated</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _results)
                    {
                        <tr>
                            <td><a href="javascript:void(0)" class="link-primary" @onclick="() => OpenRecord(m)">@m.Name</a></td>
                            <td>@m.GenericName</td>
                            <td>@m.Strength</td>
                            <td>@m.Form</td>
                            <td>@m.PackSize</td>
                            <td>@string.Join(", ", m.ActiveIngredients.Select(IngredientLabel))</td>
                            <td>
                                @if (m.Schedule != null)
                                {
                                    <span class="badge @ScheduleBadgeClass(m.Schedule.Value)">@ScheduleLabel(m.Schedule.Value)</span>
                                }
                            </td>
                            <td>
                                @if (m.IsPbsListed)
                                {
                                    <span class="badge bg-info text-dark">PBS</span>
                                }
                                @if (m.IsRpbsListed)
                                {
                                    <span class="badge bg-info text-dark">RPBS</span>
                                }
                            </td>
                            <td>
                                @if (m.RestrictionLevel != null)
                                {
                                    <span class="badge @RestrictionBadgeClass(m.RestrictionLevel.Value)">@RestrictionLabel(m.RestrictionLevel.Value)</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(m.Source == MedicineSource.Manual ? "bg-secondary" : "bg-light text-dark border")">
                                    @(m.Source == MedicineSource.Manual ? "Manual" : "Synced")
                                </span>
                            </td>
                            <td class="text-muted small">@(m.LastSyncedAt.HasValue ? m.LastSyncedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")</td>
                            <td class="text-end">
                                @if (m.Source == MedicineSource.Manual)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeactivateAsync(m)">Deactivate</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
</div>

<div class="small text-muted mt-4 border-top pt-3">
    <strong>PBS data copyright:</strong> Copyright (c) 2024 Department of Health, Commonwealth of
    Australia. Permission is granted to use and redistribute this content, as long as all copyright
    statements are retained. Permission is not granted to modify this content.
    <a href="https://www.health.gov.au/using-our-websites/copyright" target="_blank" rel="noopener">More information</a>.
</div>

@if (_showModal)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">@(_isReadOnly ? "View" : _editingId.HasValue ? "Edit" : "New") Medicine</h6>
                    <button type="button" class="btn-close" @onclick="@(() => _showModal = false)"></button>
                </div>
                <div class="modal-body">
                    @if (_isReadOnly)
                    {
                        <div class="alert alert-secondary small py-2 mb-3">
                            This medicine was synced/imported, not manually created — it can be viewed here but
                            only edited by re-importing an updated CSV.
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label small mb-0">Name</label>
                        <input class="form-control form-control-sm" @bind="_form.Name" disabled="@_isReadOnly" />
                    </div>
                    <div class="row g-2">
                        <div class="col">
                            <label class="form-label small mb-0">Generic Name</label>
                            <input class="form-control form-control-sm" @bind="_form.GenericName" disabled="@_isReadOnly" />
                        </div>
                        <div class="col">
                            <label class="form-label small mb-0">Strength</label>
                            <input class="form-control form-control-sm" @bind="_form.Strength" disabled="@_isReadOnly" />
                        </div>
                    </div>
                    <div class="row g-2 mt-1">
                        <div class="col">
                            <label class="form-label small mb-0">Form</label>
                            <input class="form-control form-control-sm" @bind="_form.Form" disabled="@_isReadOnly" />
                        </div>
                        <div class="col">
                            <label class="form-label small mb-0">Pack Size</label>
                            <input class="form-control form-control-sm" @bind="_form.PackSize" disabled="@_isReadOnly" />
                        </div>
                    </div>
                    <div class="mb-2 mt-1">
                        <label class="form-label small mb-0">Manufacturer</label>
                        <input class="form-control form-control-sm" @bind="_form.Manufacturer" disabled="@_isReadOnly" />
                    </div>
                    <div class="mb-2 mt-2">
                        <label class="form-label small mb-0">Active Ingredient(s)</label>
                        <input class="form-control form-control-sm" @bind="_form.ActiveIngredientNames" placeholder="Semicolon-separated, e.g. Paracetamol;Codeine" disabled="@_isReadOnly" />
                    </div>
                    <div class="row g-2 mt-1">
                        <div class="col">
                            <label class="form-label small mb-0">Schedule</label>
                            <select class="form-select form-select-sm" @bind="_form.Schedule" disabled="@_isReadOnly">
                                <option value="">Unknown</option>
                                @foreach (var s in Enum.GetValues<MedicineSchedule>())
                                {
                                    <option value="@s">@ScheduleLabel(s)</option>
                                }
                            </select>
                        </div>
                        <div class="col">
                            <label class="form-label small mb-0">Restriction</label>
                            <select class="form-select form-select-sm" @bind="_form.RestrictionLevel" disabled="@_isReadOnly">
                                <option value="">N/A</option>
                                @foreach (var r in Enum.GetValues<PbsRestrictionLevel>())
                                {
                                    <option value="@r">@RestrictionLabel(r)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mt-2">
                        <div class="col d-flex align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkPbs" @bind="_form.IsPbsListed" disabled="@_isReadOnly" />
                                <label class="form-check-label small" for="chkPbs">PBS listed</label>
                            </div>
                        </div>
                        <div class="col d-flex align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkRpbs" @bind="_form.IsRpbsListed" disabled="@_isReadOnly" />
                                <label class="form-check-label small" for="chkRpbs">RPBS listed</label>
                            </div>
                        </div>
                    </div>
                    @if (_editingId.HasValue)
                    {
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="chkActive" @bind="_form.IsActive" disabled="@_isReadOnly" />
                            <label class="form-check-label small" for="chkActive">Active</label>
                        </div>
                    }
                    @if (_formError != null)
                    {
                        <div class="small text-danger mt-2">@_formError</div>
                    }
                </div>
                <div class="modal-footer py-2">
                    @if (_isReadOnly)
                    {
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="@(() => _showModal = false)">Close</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="@(() => _showModal = false)">Cancel</button>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="SaveAsync">Save</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MedicineDto> _results = new();
    private string _query = string.Empty;
    private MedicineSource? _sourceFilter;
    private bool _isSearching;

    private bool _isSyncing;
    private string? _syncError;
    private string _progressStatus = string.Empty;
    private List<string> _progressLog = new();
    private string? _currentSyncJobId;
    private bool _isCancelling;
    private SyncProgressDto? _lastSyncResult;

    private IBrowserFile? _selectedFile;
    private bool _isImporting;
    private MedicineImportResultDto? _lastImportResult;
    private string? _importError;
    private bool _isExporting;
    private string? _exportError;

    private bool _showModal;
    private bool _isReadOnly;
    private int? _editingId;
    private UpdateMedicineDto _form = new();
    private string? _formError;

    protected override async Task OnInitializedAsync()
    {
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _isSearching = true;
        _results = await MedicineService.SearchAsync(_query, _sourceFilter);
        _isSearching = false;
    }

    private static string ScheduleLabel(MedicineSchedule schedule) =>
        schedule == MedicineSchedule.Unscheduled ? "Unscheduled" : schedule.ToString();

    private static string ScheduleBadgeClass(MedicineSchedule schedule) => schedule switch
    {
        MedicineSchedule.S8 => "bg-danger",
        MedicineSchedule.S4 => "bg-primary",
        MedicineSchedule.S3 => "bg-warning text-dark",
        MedicineSchedule.S2 => "bg-success",
        _ => "bg-secondary"
    };

    private static string IngredientLabel(IngredientRefDto i) => i.AtcCode == null ? i.Name : $"{i.Name} ({i.AtcCode})";

    private static string RestrictionLabel(PbsRestrictionLevel level) => level switch
    {
        PbsRestrictionLevel.AuthorityRequired => "Authority Required",
        _ => level.ToString()
    };

    private static string RestrictionBadgeClass(PbsRestrictionLevel level) => level switch
    {
        PbsRestrictionLevel.AuthorityRequired => "bg-danger",
        PbsRestrictionLevel.Restricted => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private void OpenNew()
    {
        _editingId = null;
        _isReadOnly = false;
        _form = new UpdateMedicineDto { IsActive = true };
        _formError = null;
        _showModal = true;
    }

    /// <summary>Opens the modal for an existing row — editable for Manual entries, read-only for
    /// Synced ones (see MedicineSource).</summary>
    private void OpenRecord(MedicineDto m)
    {
        _editingId = m.Id;
        _isReadOnly = m.Source != MedicineSource.Manual;
        _form = new UpdateMedicineDto
        {
            Name = m.Name,
            GenericName = m.GenericName,
            Strength = m.Strength,
            Form = m.Form,
            PackSize = m.PackSize,
            Manufacturer = m.Manufacturer,
            IsPbsListed = m.IsPbsListed,
            IsRpbsListed = m.IsRpbsListed,
            RestrictionLevel = m.RestrictionLevel,
            Schedule = m.Schedule,
            IsActive = m.IsActive,
            ActiveIngredientNames = string.Join(";", m.ActiveIngredients.Select(i => i.Name))
        };
        _formError = null;
        _showModal = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _formError = "Name is required.";
            return;
        }

        if (_editingId.HasValue)
        {
            var ok = await MedicineService.UpdateAsync(_editingId.Value, _form);
            if (!ok)
            {
                _formError = "Save failed — check your permissions.";
                return;
            }
        }
        else
        {
            var created = await MedicineService.CreateAsync(new CreateMedicineDto
            {
                Name = _form.Name,
                GenericName = _form.GenericName,
                Strength = _form.Strength,
                Form = _form.Form,
                PackSize = _form.PackSize,
                Manufacturer = _form.Manufacturer,
                IsPbsListed = _form.IsPbsListed,
                IsRpbsListed = _form.IsRpbsListed,
                RestrictionLevel = _form.RestrictionLevel,
                Schedule = _form.Schedule,
                ActiveIngredientNames = _form.ActiveIngredientNames
            });
            if (created == null)
            {
                _formError = "Save failed — check your permissions.";
                return;
            }
        }

        _showModal = false;
        await SearchAsync();
    }

    private async Task DeactivateAsync(MedicineDto m)
    {
        await MedicineService.DeactivateAsync(m.Id);
        await SearchAsync();
    }

    /// <summary>Which of the three Sync phases we're in, inferred from the whole accumulated log
    /// rather than just the latest message — the final line of a phase (e.g. the import tally) doesn't
    /// necessarily repeat a phase keyword, so checking only the latest message could fall back to
    /// "gather" right after a phase most people would call complete.</summary>
    private string CurrentSyncPhase =>
        _progressLog.Any(m => m.Contains("Enrich", StringComparison.OrdinalIgnoreCase)) ? "enrich" :
        _progressLog.Any(m => m.Contains("Importing into catalogue", StringComparison.OrdinalIgnoreCase)) ? "import" :
        "gather";

    private string StepClass(string step)
    {
        string[] order = ["gather", "import", "enrich"];
        var current = Array.IndexOf(order, CurrentSyncPhase);
        var target = Array.IndexOf(order, step);
        if (target < current) return "bg-success";
        return target == current ? "bg-primary" : "bg-secondary";
    }

    private async Task SyncFromSourcesAsync()
    {
        _isSyncing = true;
        _syncError = null;
        _lastSyncResult = null;
        _progressStatus = "Starting...";
        _progressLog = new List<string>();
        _currentSyncJobId = null;

        var progress = new Progress<string>(msg =>
        {
            // msg is relayed from the server's progress log and already carries a "[HH:mm:ss]"
            // (UTC) prefix stamped by MedicinesController — adding a second client-local one here
            // would produce confusing double timestamps.
            _progressLog.Add(msg);
            _progressStatus = msg;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            var result = await MedicineService.SyncFromSourcesAsync(progress, jobId =>
            {
                _currentSyncJobId = jobId;
                InvokeAsync(StateHasChanged);
            });

            if (result == null)
            {
                _syncError = "Sync failed — check your permissions.";
            }
            else
            {
                _lastSyncResult = result;
                if (result.Error != null)
                {
                    _syncError = $"Sync failed: {result.Error}";
                }
                if (result.ImportResult != null)
                {
                    await SearchAsync();
                }
            }
        }
        catch (Exception ex)
        {
            _syncError = $"Sync failed: {ex.Message}";
            _progressLog.Add($"[{DateTime.Now:HH:mm:ss}] ERROR: {ex.Message}");
        }

        // Brief delay so the user sees the final status before the modal closes.
        await Task.Delay(800);
        _currentSyncJobId = null;
        _isSyncing = false;
    }

    private async Task CancelSyncAsync()
    {
        if (_currentSyncJobId == null) return;
        _isCancelling = true;
        await MedicineService.CancelSyncAsync(_currentSyncJobId);
        _isCancelling = false;
    }

    private async Task ExportCsvAsync()
    {
        _isExporting = true;
        _exportError = null;
        try
        {
            var bytes = await MedicineService.ExportCsvAsync();
            if (bytes == null)
            {
                _exportError = "Export failed — check your permissions.";
            }
            else
            {
                var base64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("IntelliMedDownload.fromBase64", $"medicine-catalogue-{DateTime.Now:yyyyMMdd-HHmmss}.csv", base64);
            }
        }
        finally
        {
            _isExporting = false;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _lastImportResult = null;
        _importError = null;
    }

    private async Task ImportAsync()
    {
        if (_selectedFile == null) return;

        _isImporting = true;
        _importError = null;
        try
        {
            await using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 20_000_000);
            var result = await MedicineService.ImportAsync(stream, _selectedFile.Name);
            if (result == null)
            {
                _importError = "Import failed — check the file format and your permissions.";
            }
            else
            {
                _lastImportResult = result;
                await SearchAsync();
            }
        }
        catch (Exception ex)
        {
            _importError = $"Import failed: {ex.Message}";
        }
        finally
        {
            _isImporting = false;
        }
    }
}
