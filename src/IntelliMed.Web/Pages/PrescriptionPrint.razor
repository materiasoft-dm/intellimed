@page "/prescriptions/print/{IssueId:int}"
@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Entities
@using IntelliMed.Web.Services
@inject IPrescriptionService PrescriptionService
@inject IJSRuntime JS

<PageTitle>Script @(_issue?.ScriptNumber) - IntelliMed</PageTitle>

<style>
    .no-print { }
    @@media print {
        .no-print { display: none !important; }
        body { margin: 0; }
    }
</style>

<div class="no-print p-3 d-flex justify-content-end">
    <button class="btn btn-primary" @onclick="Print"><i class="bi bi-printer"></i> Print</button>
</div>

@if (_isLoading)
{
    <div class="p-4 text-center">
        <span class="spinner-border spinner-border-sm text-primary me-2"></span>
        Loading script...
    </div>
}
else if (_issue == null)
{
    <div class="p-4"><div class="alert alert-danger">Prescription issue not found.</div></div>
}
else
{
    <div class="p-4" style="max-width: 700px; margin: 0 auto;">
        @if (_issue.Schedule == MedicineSchedule.S8)
        {
            <div class="no-print alert alert-warning small py-2">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Schedule 8 — verify this satisfies your state's S8 prescribing requirements before use.
            </div>
        }

        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h5 class="mb-1">@_issue.PrescriberName</h5>
                @if (!string.IsNullOrWhiteSpace(_issue.PrescriberQualifications))
                {
                    <div class="small">@_issue.PrescriberQualifications</div>
                }
                <div class="row g-1 small mt-1">
                    @if (!string.IsNullOrWhiteSpace(_issue.PrescriberProviderNumber))
                    {
                        <div class="col-12">Provider No: @_issue.PrescriberProviderNumber</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_issue.PrescriberAhpraNumber))
                    {
                        <div class="col-12">AHPRA: @_issue.PrescriberAhpraNumber</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_issue.PrescriberHpiiNumber))
                    {
                        <div class="col-12">HPI-I: @_issue.PrescriberHpiiNumber</div>
                    }
                </div>
            </div>
            <div class="text-end">
                <div class="d-flex gap-1 justify-content-end mb-1">
                    @if (_issue.IsPbsListed)
                    {
                        <span class="badge bg-info text-dark">PBS</span>
                    }
                    @if (_issue.IsRpbsListed)
                    {
                        <span class="badge bg-info text-dark">RPBS</span>
                    }
                    @if (_issue.RestrictionLevel != null)
                    {
                        <span class="badge @(_issue.RestrictionLevel == PbsRestrictionLevel.AuthorityRequired ? "bg-danger" : "bg-warning text-dark")">
                            @(_issue.RestrictionLevel == PbsRestrictionLevel.AuthorityRequired ? "Authority Required" : _issue.RestrictionLevel.ToString())
                        </span>
                    }
                    @if (_issue.Schedule != null && _issue.Schedule != MedicineSchedule.Unscheduled)
                    {
                        <span class="badge bg-secondary">@_issue.Schedule</span>
                    }
                </div>
                <div><strong>Script No: @_issue.ScriptNumber</strong></div>
                @if (_issue.RepeatNumber > 0)
                {
                    <div class="small">Repeat @_issue.RepeatNumber</div>
                }
                <div class="small">@_issue.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-8">
                <div class="text-muted small">Patient</div>
                <div class="fw-semibold">@_issue.ClientName</div>
                <div class="small">DOB: @_issue.ClientDateOfBirth.ToString("dd/MM/yyyy")</div>
                @if (!string.IsNullOrWhiteSpace(_issue.ClientMedicareNumber))
                {
                    <div class="small">Medicare: @_issue.ClientMedicareNumber</div>
                }
            </div>
        </div>

        <table class="table table-sm table-bordered">
            <tbody>
                <tr>
                    <td style="width:140px" class="text-muted">Medicine</td>
                    <td><strong>@_issue.MedicineName</strong></td>
                </tr>
                @if (!string.IsNullOrWhiteSpace(_issue.Dose) || !string.IsNullOrWhiteSpace(_issue.Frequency) || !string.IsNullOrWhiteSpace(_issue.Route))
                {
                    <tr>
                        <td class="text-muted">Dose</td>
                        <td>@_issue.Dose @_issue.Frequency @_issue.Route</td>
                    </tr>
                }
                @if (!string.IsNullOrWhiteSpace(_issue.Quantity))
                {
                    <tr>
                        <td class="text-muted">Quantity</td>
                        <td>@_issue.Quantity</td>
                    </tr>
                }
                <tr>
                    <td class="text-muted">Repeats</td>
                    <td>@_issue.Repeats</td>
                </tr>
                @if (!string.IsNullOrWhiteSpace(_issue.AuthorityApprovalNumber))
                {
                    <tr>
                        <td class="text-muted">Authority No.</td>
                        <td>@_issue.AuthorityApprovalNumber</td>
                    </tr>
                }
                @if (!string.IsNullOrWhiteSpace(_issue.StateAuthorityCode))
                {
                    <tr>
                        <td class="text-muted">State Authority</td>
                        <td>@_issue.StateAuthorityCode</td>
                    </tr>
                }
                @if (!string.IsNullOrWhiteSpace(_issue.PrescribingNotes))
                {
                    <tr>
                        <td class="text-muted">Notes</td>
                        <td>@_issue.PrescribingNotes</td>
                    </tr>
                }
                @if (!string.IsNullOrWhiteSpace(_issue.NotesForPharmacy))
                {
                    <tr>
                        <td class="text-muted">For pharmacy</td>
                        <td>@_issue.NotesForPharmacy</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="small text-muted mt-4">Prescriber signature: _______________________</div>
    </div>
}

@code {
    [Parameter] public int IssueId { get; set; }

    private PrescriptionIssueDto? _issue;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _issue = await PrescriptionService.GetIssueByIdAsync(IssueId);
        _isLoading = false;
    }

    private async Task Print()
    {
        await JS.InvokeVoidAsync("window.print");
    }
}
