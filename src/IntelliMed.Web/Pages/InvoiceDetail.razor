@page "/invoices/edit/{Id:int}"
@layout MainLayout
@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Entities
@using IntelliMed.Web.Services
@inject IInvoiceService InvoiceService
@inject IAuthService AuthService
@inject NavigationManager NavManager

<PageTitle>Invoice @(_invoice?.InvoiceNumber) - IntelliMed</PageTitle>

@if (_isLoading)
{
    <div class="card text-center py-3">
        <div class="card-body py-2">
            <span class="spinner-border spinner-border-sm text-primary me-2"></span>
            Loading invoice...
        </div>
    </div>
}
else if (_invoice == null)
{
    <div class="alert alert-danger">Invoice not found.</div>
}
else
{
    <div class="d-flex align-items-center justify-content-between mb-1">
        <h5 class="mb-0 small">🧾 Invoice @_invoice.InvoiceNumber — @_invoice.ClientName</h5>
        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <span class="small @(_statusIsError ? "text-danger" : "text-success")">@_statusMessage</span>
        }
    </div>

    <div class="row g-2 mb-2">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header py-1"><strong>Details</strong></div>
                <div class="card-body py-2">
                    <div class="row g-1 small">
                        <div class="col-6 text-muted">Client</div>
                        <div class="col-6">@_invoice.ClientName</div>
                        <div class="col-6 text-muted">Provider</div>
                        <div class="col-6">@(_invoice.PractitionerName ?? "-")</div>
                        <div class="col-6 text-muted">Payee</div>
                        <div class="col-6">@(_invoice.PayeePractitionerName ?? "Same as Provider")</div>
                        <div class="col-6 text-muted">Account Type</div>
                        <div class="col-6">@_invoice.AccountTypeName</div>
                        <div class="col-6 text-muted">Invoice Date</div>
                        <div class="col-6">@_invoice.InvoiceDate.ToString("dd/MM/yyyy")</div>
                        <div class="col-6 text-muted">Due Date</div>
                        <div class="col-6">@_invoice.DueDate.ToString("dd/MM/yyyy")</div>
                        @if (!string.IsNullOrWhiteSpace(_invoice.Notes))
                        {
                            <div class="col-6 text-muted">Notes</div>
                            <div class="col-6">@_invoice.Notes</div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header py-1"><strong>Status</strong></div>
                <div class="card-body py-2">
                    <div class="row g-1 small">
                        <div class="col-6 text-muted">Status</div>
                        <div class="col-6"><span class="badge bg-primary">@_invoice.StatusName</span></div>
                        <div class="col-6 text-muted">Claim Status</div>
                        <div class="col-6">
                            <select class="form-select form-select-sm" style="width:auto;font-size:0.8rem" value="@_invoice.ClaimStatus" @onchange="OnClaimStatusChangedAsync">
                                @foreach (var status in Enum.GetValues<ClaimStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 text-muted">Total</div>
                        <div class="col-6">@_invoice.TotalAmount.ToString("C")</div>
                        <div class="col-6 text-muted">Paid</div>
                        <div class="col-6">@_invoice.AmountPaid.ToString("C")</div>
                        <div class="col-6 text-muted fw-semibold">Owing</div>
                        <div class="col-6 fw-semibold">@_invoice.AmountOwing.ToString("C")</div>
                        @if (_invoice.AmountWrittenOff > 0)
                        {
                            <div class="col-6 text-muted">Written Off</div>
                            <div class="col-6">@_invoice.AmountWrittenOff.ToString("C")</div>
                        }
                        @if (_availableCredit > 0)
                        {
                            <div class="col-6 text-muted">Payer Credit Available</div>
                            <div class="col-6 text-success">@_availableCredit.ToString("C")</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_invoice.CancelReason))
                        {
                            <div class="col-6 text-muted">Cancel Reason</div>
                            <div class="col-6">@_invoice.CancelReason</div>
                        }
                        @{ var consentFlags = ApplicableConsentFlags(); }
                        @if (consentFlags.Count > 0)
                        {
                            <div class="col-12 text-muted mt-1">Consent &amp; Claiming</div>
                            <div class="col-12">
                                @foreach (var flag in consentFlags)
                                {
                                    <span class="badge @(flag.Value ? "bg-success" : "bg-secondary") me-1">@(flag.Value ? "✓" : "✗") @flag.Label</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-2">
        <div class="card-header py-1"><strong>Line Items</strong></div>
        <div class="card-body py-2">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th style="width:60px">Item#</th>
                        <th>Description</th>
                        <th style="width:100px">Service Date</th>
                        <th style="width:110px">Schedule</th>
                        <th style="width:50px">Qty</th>
                        <th style="width:90px" class="text-end">Fee</th>
                        <th style="width:90px" class="text-end">Rebate</th>
                        <th style="width:80px" class="text-end">Disc.</th>
                        <th style="width:90px" class="text-end">Gap</th>
                        <th style="width:90px" class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _invoice.Items)
                    {
                        <tr>
                            <td>@(item.ItemNumber ?? "-")</td>
                            <td>
                                @item.Description
                                @if (!string.IsNullOrWhiteSpace(item.Note))
                                {
                                    <i class="bi bi-info-circle text-primary ms-1" title="@item.Note" style="cursor:help"></i>
                                }
                            </td>
                            <td>@(item.ServiceDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>@(item.FeeScheduleCode ?? "Default")</td>
                            <td>@item.Quantity</td>
                            <td class="text-end">@item.UnitPrice.ToString("C")</td>
                            <td class="text-end">@item.LineRebate.ToString("C")</td>
                            <td class="text-end">@item.Discount.ToString("C")</td>
                            <td class="text-end @(item.Gap > 0 ? "text-danger" : "")">@item.Gap.ToString("C")</td>
                            <td class="text-end">@item.TotalPrice.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="5" class="text-end">Totals</td>
                        <td class="text-end">@_invoice.TotalRebate.ToString("C")</td>
                        <td></td>
                        <td class="text-end">@_invoice.TotalGap.ToString("C")</td>
                        <td class="text-end">@_invoice.TotalAmount.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="card mb-2">
        <div class="card-header py-1 d-flex justify-content-between align-items-center">
            <strong>Payments</strong>
            <div class="d-flex gap-1">
                @if (_isAdmin)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenWriteOffModal" disabled="@(_invoice.Status == InvoiceStatus.Cancelled || _invoice.AmountOwing <= 0)">Write Off</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenRefundModal" disabled="@(RefundableFromInvoice <= 0 && _availableCredit <= 0)">Refund</button>
                }
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenReceiptModal" disabled="@(_invoice.AmountOwing <= 0)">+ Record Receipt</button>
            </div>
        </div>
        <div class="card-body py-2">
            @if (_invoice.Payments.Count == 0)
            {
                <div class="text-muted small">No payments recorded yet.</div>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th style="width:110px">Date</th>
                            <th style="width:120px">Method</th>
                            <th>Reference</th>
                            <th style="width:100px">Amount</th>
                            <th style="width:40px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in _invoice.Payments)
                        {
                            <tr>
                                <td>@payment.PaymentDate.ToString("dd/MM/yyyy")</td>
                                <td>@payment.MethodName</td>
                                <td>@(payment.Reference ?? "-")</td>
                                <td>@payment.Amount.ToString("C")</td>
                                <td>
                                    <a href="/invoices/receipt/@payment.ReceiptId" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary" title="Print Receipt">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        @if (_isAdmin)
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="@(() => NavManager.NavigateTo($"/invoices/split/{Id}"))" disabled="@(!CanSplit)" title="@(CanSplit ? null : "Only unpaid invoices with no write-offs can be split")">Split Invoice</button>
            <button type="button" class="btn btn-outline-danger" @onclick="OpenCancelModal" disabled="@(!CanCancel)" title="@CancelDisabledReason">Cancel Invoice</button>
        }
        <a href="/invoices/print/@Id" target="_blank" rel="noopener" class="btn btn-outline-primary"><i class="bi bi-printer"></i> Print Invoice</a>
        <button type="button" class="btn btn-secondary" @onclick="@(() => NavManager.NavigateTo("/invoices"))">Close</button>
    </div>
}

@if (_showReceiptModal)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">
                        Record Receipt
                        @if (_invoice?.PayerClientId != null)
                        {
                            <span class="text-muted small fw-normal">— Payer: @_invoice.PayerName</span>
                        }
                    </h6>
                    <button type="button" class="btn-close" @onclick="@(() => _showReceiptModal = false)"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small mb-1 fw-semibold">Allocate To</label>
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th style="width:30px"></th>
                                <th>Invoice #</th>
                                <th>Client</th>
                                <th style="width:100px" class="text-end">Owing</th>
                                <th style="width:120px" class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _allocationRows)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input" @bind="row.IsSelected" @bind:after="RecalculateTenderAmount" disabled="@row.IsLocked" />
                                    </td>
                                    <td>@row.InvoiceNumber</td>
                                    <td>@row.ClientName</td>
                                    <td class="text-end">@row.MaxAmount.ToString("C")</td>
                                    <td class="text-end">
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="row.Amount" @bind:after="RecalculateTenderAmount" disabled="@(!row.IsSelected)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_allocationRows.Count <= 1)
                    {
                        <div class="text-muted small mt-1">No other outstanding invoices for this payer.</div>
                    }

                    <hr />

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small mb-0">Amount Tendered</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" @bind="_paymentAmount" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Method</label>
                            <select class="form-select form-select-sm" @bind="_paymentMethod">
                                @foreach (var method in Enum.GetValues<PaymentMethod>())
                                {
                                    <option value="@method">@method</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Date</label>
                            <input type="date" class="form-control form-control-sm" @bind="_paymentDate" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Reference</label>
                            <input class="form-control form-control-sm" @bind="_paymentReference" />
                        </div>
                    </div>

                    <div class="small mt-2 @(_paymentAmount < TotalAllocated ? "text-danger" : "text-muted")">
                        Total Allocated: @TotalAllocated.ToString("C") &middot; Total Tendered: @_paymentAmount.ToString("C")
                        @if (_paymentAmount > TotalAllocated)
                        {
                            <span> &middot; Excess of @((_paymentAmount - TotalAllocated).ToString("C")) will be kept as credit.</span>
                        }
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="@(() => _showReceiptModal = false)">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="SaveReceiptAsync" disabled="@(_paymentAmount < TotalAllocated)">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showRefundModal && _invoice != null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">Refund</h6>
                    <button type="button" class="btn-close" @onclick="@(() => _showRefundModal = false)"></button>
                </div>
                <div class="modal-body">
                    @if (RefundableFromInvoice > 0 && _availableCredit > 0)
                    {
                        <div class="mb-2">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="refundSource" id="refundSourceInvoice" checked="@(!_refundFromCredit)" @onchange="@(() => SetRefundSource(false))" />
                                <label class="form-check-label small" for="refundSourceInvoice">This invoice (@RefundableFromInvoice.ToString("C"))</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="refundSource" id="refundSourceCredit" checked="@(_refundFromCredit)" @onchange="@(() => SetRefundSource(true))" />
                                <label class="form-check-label small" for="refundSourceCredit">Account credit (@_availableCredit.ToString("C"))</label>
                            </div>
                        </div>
                    }
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small mb-0">Amount (max @RefundCap.ToString("C"))</label>
                            <input type="number" step="0.01" max="@RefundCap" class="form-control form-control-sm" @bind="_refundAmount" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Method</label>
                            <select class="form-select form-select-sm" @bind="_refundMethod">
                                @foreach (var method in Enum.GetValues<PaymentMethod>())
                                {
                                    <option value="@method">@method</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Date</label>
                            <input type="date" class="form-control form-control-sm" @bind="_refundDate" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Reference</label>
                            <input class="form-control form-control-sm" @bind="_refundReference" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-0">Reason</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="_refundReason"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="@(() => _showRefundModal = false)">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary"
                            @onclick="SaveRefundAsync"
                            disabled="@(_refundSaving || _refundAmount <= 0 || _refundAmount > RefundCap || string.IsNullOrWhiteSpace(_refundReason))">
                        @if (_refundSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Refunding...</span>
                        }
                        else
                        {
                            <span>Refund</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showWriteOffModal && _invoice != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Write Off Invoice</h5>
                    <button type="button" class="btn-close" @onclick="@(() => _showWriteOffModal = false)" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning d-flex align-items-center mb-3">
                        <i class="bi bi-exclamation-triangle me-1"></i> This forgives part or all of the outstanding balance. No money changes hands, and this cannot be undone.
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small mb-0">Amount (max @_invoice.AmountOwing.ToString("C"))</label>
                            <input type="number" step="0.01" max="@_invoice.AmountOwing" class="form-control form-control-sm" @bind="_writeOffAmount" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-0">Reason</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="_writeOffReason"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="@(() => _showWriteOffModal = false)">Cancel</button>
                    <button type="button" class="btn btn-danger"
                            @onclick="SaveWriteOffAsync"
                            disabled="@(_writeOffSaving || _writeOffAmount <= 0 || _writeOffAmount > _invoice.AmountOwing || string.IsNullOrWhiteSpace(_writeOffReason))">
                        @if (_writeOffSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Writing Off...</span>
                        }
                        else
                        {
                            <span>Write Off Invoice</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showCancelModal && _invoice != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Cancel Invoice</h5>
                    <button type="button" class="btn-close" @onclick="@(() => _showCancelModal = false)" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning d-flex align-items-center mb-3">
                        <i class="bi bi-exclamation-triangle me-1"></i> This will cancel invoice @_invoice.InvoiceNumber. It can no longer be paid or split.
                    </div>
                    <label class="form-label small mb-0">Reason</label>
                    <textarea class="form-control form-control-sm" rows="2" @bind="_cancelReason"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="@(() => _showCancelModal = false)">Keep Invoice</button>
                    <button type="button" class="btn btn-danger"
                            @onclick="SaveCancelAsync"
                            disabled="@(_cancelSaving || string.IsNullOrWhiteSpace(_cancelReason))">
                        @if (_cancelSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Cancelling...</span>
                        }
                        else
                        {
                            <span>Cancel Invoice</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private InvoiceDto? _invoice;
    private bool _isLoading = true;

    private bool _showReceiptModal;
    private List<ReceiptAllocationRow> _allocationRows = new();
    private decimal _paymentAmount;
    private PaymentMethod _paymentMethod = PaymentMethod.Cash;
    private DateTime _paymentDate = DateTime.Today;
    private string? _paymentReference;

    private decimal TotalAllocated => _allocationRows.Where(r => r.IsSelected).Sum(r => r.Amount);

    private string? _statusMessage;
    private bool _statusIsError;

    private IList<string> _currentUserRoles = new List<string>();
    private bool _isAdmin => _currentUserRoles.Any(r => r == "SuperAdmin" || r == "Admin");
    private decimal _availableCredit;

    private bool _showRefundModal;
    private bool _refundFromCredit;
    private decimal _refundAmount;
    private PaymentMethod _refundMethod = PaymentMethod.Cash;
    private DateTime _refundDate = DateTime.Today;
    private string? _refundReference;
    private string _refundReason = string.Empty;
    private bool _refundSaving;

    private bool _showWriteOffModal;
    private decimal _writeOffAmount;
    private string _writeOffReason = string.Empty;
    private bool _writeOffSaving;

    private bool _showCancelModal;
    private string _cancelReason = string.Empty;
    private bool _cancelSaving;

    // AmountPaid is already net of every prior refund, so it IS the refundable cap — see the matching
    // comment in ReceiptRepository.CreateRefundAsync for why subtracting Refunds again would be wrong.
    private decimal RefundableFromInvoice => _invoice?.AmountPaid ?? 0;
    private decimal RefundCap => _refundFromCredit ? _availableCredit : RefundableFromInvoice;
    private bool CanCancel => _invoice != null && _invoice.Status != InvoiceStatus.Cancelled && _invoice.AmountPaid <= 0;
    private string? CancelDisabledReason => _invoice == null || CanCancel
        ? null
        : _invoice.Status == InvoiceStatus.Cancelled ? "This invoice is already cancelled" : "Refund this invoice before cancelling it";
    private bool CanSplit => _invoice != null && _invoice.Status != InvoiceStatus.Cancelled && _invoice.AmountPaid <= 0 && _invoice.AmountWrittenOff <= 0;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        if (user?.IsAuthenticated == true && user.Roles != null)
            _currentUserRoles = user.Roles;

        await LoadAsync();
        await LoadAvailableCreditAsync();
    }

    private async Task LoadAvailableCreditAsync()
    {
        if (_invoice == null) return;
        _availableCredit = await InvoiceService.GetAvailableCreditAsync(_invoice.PayerClientId ?? _invoice.ClientId);
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _invoice = await InvoiceService.GetInvoiceByIdAsync(Id);
        _isLoading = false;
    }

    private async Task OpenReceiptModal()
    {
        if (_invoice == null) return;

        _allocationRows = new List<ReceiptAllocationRow>
        {
            new()
            {
                InvoiceId = _invoice.Id,
                InvoiceNumber = _invoice.InvoiceNumber,
                ClientName = _invoice.ClientName,
                MaxAmount = _invoice.AmountOwing,
                IsLocked = true,
                IsSelected = true,
                Amount = _invoice.AmountOwing
            }
        };

        var payerClientId = _invoice.PayerClientId ?? _invoice.ClientId;
        var outstanding = await InvoiceService.GetOutstandingInvoicesForPayerAsync(payerClientId, _invoice.Id);
        foreach (var o in outstanding)
        {
            _allocationRows.Add(new ReceiptAllocationRow
            {
                InvoiceId = o.InvoiceId,
                InvoiceNumber = o.InvoiceNumber,
                ClientName = o.ClientName,
                MaxAmount = o.AmountOwing,
                IsLocked = false,
                IsSelected = false,
                Amount = o.AmountOwing
            });
        }

        RecalculateTenderAmount();
        _paymentMethod = PaymentMethod.Cash;
        _paymentDate = DateTime.Today;
        _paymentReference = null;
        _showReceiptModal = true;
    }

    private void RecalculateTenderAmount()
    {
        _paymentAmount = TotalAllocated;
    }

    private async Task SaveReceiptAsync()
    {
        if (_invoice == null) return;

        var selectedRows = _allocationRows.Where(r => r.IsSelected).ToList();
        if (selectedRows.Count == 0) return;

        var receiptId = await InvoiceService.CreateReceiptAsync(new CreateReceiptDto
        {
            PayerClientId = _invoice.PayerClientId ?? _invoice.ClientId,
            ReceiptDate = _paymentDate,
            Payments = new List<CreateReceiptTenderDto>
            {
                new() { Amount = _paymentAmount, Method = _paymentMethod, Reference = _paymentReference }
            },
            Allocations = selectedRows.Select(r => new CreateReceiptAllocationDto
            {
                InvoiceId = r.InvoiceId,
                Amount = r.Amount
            }).ToList()
        });

        _showReceiptModal = false;
        if (receiptId.HasValue)
        {
            ShowStatus("Receipt recorded.", false);
            await LoadAsync();
        }
        else
        {
            ShowStatus("Failed to record receipt.", true);
        }
    }

    private void OpenRefundModal()
    {
        if (_invoice == null) return;

        _refundFromCredit = RefundableFromInvoice <= 0 && _availableCredit > 0;
        _refundAmount = RefundCap;
        _refundMethod = PaymentMethod.Cash;
        _refundDate = DateTime.Today;
        _refundReference = null;
        _refundReason = string.Empty;
        _showRefundModal = true;
    }

    private void SetRefundSource(bool fromCredit)
    {
        _refundFromCredit = fromCredit;
        _refundAmount = RefundCap;
    }

    private async Task SaveRefundAsync()
    {
        if (_invoice == null || _refundAmount <= 0 || _refundAmount > RefundCap || string.IsNullOrWhiteSpace(_refundReason)) return;

        _refundSaving = true;
        var result = await InvoiceService.CreateRefundAsync(new CreateRefundDto
        {
            PayerClientId = _invoice.PayerClientId ?? _invoice.ClientId,
            InvoiceId = _refundFromCredit ? null : _invoice.Id,
            Amount = _refundAmount,
            Method = _refundMethod,
            Reference = _refundReference,
            RefundDate = _refundDate,
            Reason = _refundReason
        });
        _refundSaving = false;
        _showRefundModal = false;

        if (result.HasValue)
        {
            ShowStatus("Refund recorded.", false);
            await LoadAsync();
            await LoadAvailableCreditAsync();
        }
        else
        {
            ShowStatus("Failed to record refund.", true);
        }
    }

    private void OpenWriteOffModal()
    {
        if (_invoice == null) return;

        _writeOffAmount = _invoice.AmountOwing;
        _writeOffReason = string.Empty;
        _showWriteOffModal = true;
    }

    private async Task SaveWriteOffAsync()
    {
        if (_invoice == null || _writeOffAmount <= 0 || _writeOffAmount > _invoice.AmountOwing || string.IsNullOrWhiteSpace(_writeOffReason)) return;

        _writeOffSaving = true;
        var ok = await InvoiceService.WriteOffAsync(_invoice.Id, new CreateWriteOffDto { Amount = _writeOffAmount, Reason = _writeOffReason });
        _writeOffSaving = false;
        _showWriteOffModal = false;

        if (ok)
        {
            ShowStatus("Invoice written off.", false);
            await LoadAsync();
        }
        else
        {
            ShowStatus("Failed to write off invoice.", true);
        }
    }

    private void OpenCancelModal()
    {
        _cancelReason = string.Empty;
        _showCancelModal = true;
    }

    private async Task SaveCancelAsync()
    {
        if (_invoice == null || string.IsNullOrWhiteSpace(_cancelReason)) return;

        _cancelSaving = true;
        var ok = await InvoiceService.CancelInvoiceAsync(_invoice.Id, new CancelInvoiceDto { Reason = _cancelReason });
        _cancelSaving = false;
        _showCancelModal = false;

        if (ok)
        {
            ShowStatus("Invoice cancelled.", false);
            await LoadAsync();
        }
        else
        {
            ShowStatus("Failed to cancel invoice.", true);
        }
    }

    private void ShowStatus(string message, bool isError)
    {
        _statusMessage = message;
        _statusIsError = isError;
    }

    /// <summary>Same account-type gating as AddInvoice.razor's Consent &amp; Claiming card — only
    /// list the checkboxes that actually applied when this invoice was created.</summary>
    private List<(string Label, bool Value)> ApplicableConsentFlags()
    {
        var list = new List<(string, bool)>();
        if (_invoice == null) return list;

        if (_invoice.AccountType is not (AccountTypeEnum.WorkCover or AccountTypeEnum.Tac or AccountTypeEnum.Other))
            list.Add(("Online Submission Authorised", _invoice.ClaimSubmissionAuthorised));
        if (_invoice.AccountType is AccountTypeEnum.Imc or AccountTypeEnum.Ovs)
        {
            list.Add(("Financial Interest Disclosed", _invoice.FinancialInterestDisclosed));
            list.Add(("Compensation Claim", _invoice.CompensationClaim));
        }
        if (_invoice.AccountType == AccountTypeEnum.BulkBill)
            list.Add(("Submission Authority Received", _invoice.SubmissionAuthorityReceived));
        if (_invoice.AccountType == AccountTypeEnum.Imc)
            list.Add(("Assignment Requested", _invoice.BenefitAssignmentRequested));

        return list;
    }

    private async Task OnClaimStatusChangedAsync(ChangeEventArgs e)
    {
        if (_invoice == null || e.Value == null) return;
        if (!Enum.TryParse<ClaimStatus>(e.Value.ToString(), out var newStatus)) return;

        var ok = await InvoiceService.UpdateClaimStatusAsync(_invoice.Id, newStatus);
        if (ok)
        {
            ShowStatus("Claim status updated.", false);
            await LoadAsync();
        }
        else
        {
            ShowStatus("Failed to update claim status.", true);
        }
    }

    private class ReceiptAllocationRow
    {
        public int InvoiceId { get; set; }
        public string InvoiceNumber { get; set; } = string.Empty;
        public string ClientName { get; set; } = string.Empty;
        public decimal MaxAmount { get; set; }
        public bool IsLocked { get; set; }
        public bool IsSelected { get; set; }
        public decimal Amount { get; set; }
    }
