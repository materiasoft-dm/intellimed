@page "/invoices/edit/{Id:int}"
@layout MainLayout
@using IntelliMed.Core.DTOs
@using IntelliMed.Core.Entities
@using IntelliMed.Web.Services
@inject IInvoiceService InvoiceService
@inject NavigationManager NavManager

<PageTitle>Invoice @(_invoice?.InvoiceNumber) - IntelliMed</PageTitle>

@if (_isLoading)
{
    <div class="card text-center py-3">
        <div class="card-body py-2">
            <span class="spinner-border spinner-border-sm text-primary me-2"></span>
            Loading invoice...
        </div>
    </div>
}
else if (_invoice == null)
{
    <div class="alert alert-danger">Invoice not found.</div>
}
else
{
    <div class="d-flex align-items-center justify-content-between mb-1">
        <h5 class="mb-0 small">🧾 Invoice @_invoice.InvoiceNumber — @_invoice.ClientName</h5>
        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <span class="small @(_statusIsError ? "text-danger" : "text-success")">@_statusMessage</span>
        }
    </div>

    <div class="row g-2 mb-2">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header py-1"><strong>Details</strong></div>
                <div class="card-body py-2">
                    <div class="row g-1 small">
                        <div class="col-6 text-muted">Client</div>
                        <div class="col-6">@_invoice.ClientName</div>
                        <div class="col-6 text-muted">Provider</div>
                        <div class="col-6">@(_invoice.PractitionerName ?? "-")</div>
                        <div class="col-6 text-muted">Account Type</div>
                        <div class="col-6">@_invoice.AccountTypeName</div>
                        <div class="col-6 text-muted">Invoice Date</div>
                        <div class="col-6">@_invoice.InvoiceDate.ToString("dd/MM/yyyy")</div>
                        <div class="col-6 text-muted">Due Date</div>
                        <div class="col-6">@_invoice.DueDate.ToString("dd/MM/yyyy")</div>
                        @if (!string.IsNullOrWhiteSpace(_invoice.Notes))
                        {
                            <div class="col-6 text-muted">Notes</div>
                            <div class="col-6">@_invoice.Notes</div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header py-1"><strong>Status</strong></div>
                <div class="card-body py-2">
                    <div class="row g-1 small">
                        <div class="col-6 text-muted">Status</div>
                        <div class="col-6"><span class="badge bg-primary">@_invoice.StatusName</span></div>
                        <div class="col-6 text-muted">Total</div>
                        <div class="col-6">@_invoice.TotalAmount.ToString("C")</div>
                        <div class="col-6 text-muted">Paid</div>
                        <div class="col-6">@_invoice.AmountPaid.ToString("C")</div>
                        <div class="col-6 text-muted fw-semibold">Owing</div>
                        <div class="col-6 fw-semibold">@_invoice.AmountOwing.ToString("C")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-2">
        <div class="card-header py-1"><strong>Line Items</strong></div>
        <div class="card-body py-2">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th style="width:60px">Item#</th>
                        <th>Description</th>
                        <th style="width:100px">Service Date</th>
                        <th style="width:110px">Schedule</th>
                        <th style="width:50px">Qty</th>
                        <th style="width:90px" class="text-end">Fee</th>
                        <th style="width:90px" class="text-end">Rebate</th>
                        <th style="width:80px" class="text-end">Disc.</th>
                        <th style="width:90px" class="text-end">Gap</th>
                        <th style="width:90px" class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _invoice.Items)
                    {
                        <tr>
                            <td>@(item.ItemNumber ?? "-")</td>
                            <td>
                                @item.Description
                                @if (!string.IsNullOrWhiteSpace(item.Note))
                                {
                                    <i class="bi bi-info-circle text-primary ms-1" title="@item.Note" style="cursor:help"></i>
                                }
                            </td>
                            <td>@(item.ServiceDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>@(item.FeeScheduleCode ?? "Default")</td>
                            <td>@item.Quantity</td>
                            <td class="text-end">@item.UnitPrice.ToString("C")</td>
                            <td class="text-end">@item.LineRebate.ToString("C")</td>
                            <td class="text-end">@item.Discount.ToString("C")</td>
                            <td class="text-end @(item.Gap > 0 ? "text-danger" : "")">@item.Gap.ToString("C")</td>
                            <td class="text-end">@item.TotalPrice.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="5" class="text-end">Totals</td>
                        <td class="text-end">@_invoice.TotalRebate.ToString("C")</td>
                        <td></td>
                        <td class="text-end">@_invoice.TotalGap.ToString("C")</td>
                        <td class="text-end">@_invoice.TotalAmount.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="card mb-2">
        <div class="card-header py-1 d-flex justify-content-between align-items-center">
            <strong>Payments</strong>
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenReceiptModal" disabled="@(_invoice.AmountOwing <= 0)">+ Record Receipt</button>
        </div>
        <div class="card-body py-2">
            @if (_invoice.Payments.Count == 0)
            {
                <div class="text-muted small">No payments recorded yet.</div>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th style="width:110px">Date</th>
                            <th style="width:120px">Method</th>
                            <th>Reference</th>
                            <th style="width:100px">Amount</th>
                            <th style="width:40px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in _invoice.Payments)
                        {
                            <tr>
                                <td>@payment.PaymentDate.ToString("dd/MM/yyyy")</td>
                                <td>@payment.MethodName</td>
                                <td>@(payment.Reference ?? "-")</td>
                                <td>@payment.Amount.ToString("C")</td>
                                <td>
                                    <a href="/invoices/receipt/@payment.ReceiptId" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary" title="Print Receipt">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a href="/invoices/print/@Id" target="_blank" rel="noopener" class="btn btn-outline-primary"><i class="bi bi-printer"></i> Print Invoice</a>
        <button type="button" class="btn btn-secondary" @onclick="@(() => NavManager.NavigateTo("/invoices"))">Close</button>
    </div>
}

@if (_showReceiptModal)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">
                        Record Receipt
                        @if (_invoice?.PayerClientId != null)
                        {
                            <span class="text-muted small fw-normal">— Payer: @_invoice.PayerName</span>
                        }
                    </h6>
                    <button type="button" class="btn-close" @onclick="@(() => _showReceiptModal = false)"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small mb-1 fw-semibold">Allocate To</label>
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th style="width:30px"></th>
                                <th>Invoice #</th>
                                <th>Client</th>
                                <th style="width:100px" class="text-end">Owing</th>
                                <th style="width:120px" class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _allocationRows)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input" @bind="row.IsSelected" @bind:after="RecalculateTenderAmount" disabled="@row.IsLocked" />
                                    </td>
                                    <td>@row.InvoiceNumber</td>
                                    <td>@row.ClientName</td>
                                    <td class="text-end">@row.MaxAmount.ToString("C")</td>
                                    <td class="text-end">
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="row.Amount" @bind:after="RecalculateTenderAmount" disabled="@(!row.IsSelected)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_allocationRows.Count <= 1)
                    {
                        <div class="text-muted small mt-1">No other outstanding invoices for this payer.</div>
                    }

                    <hr />

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small mb-0">Amount Tendered</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" @bind="_paymentAmount" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Method</label>
                            <select class="form-select form-select-sm" @bind="_paymentMethod">
                                @foreach (var method in Enum.GetValues<PaymentMethod>())
                                {
                                    <option value="@method">@method</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Date</label>
                            <input type="date" class="form-control form-control-sm" @bind="_paymentDate" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Reference</label>
                            <input class="form-control form-control-sm" @bind="_paymentReference" />
                        </div>
                    </div>

                    <div class="small mt-2 @(_paymentAmount < TotalAllocated ? "text-danger" : "text-muted")">
                        Total Allocated: @TotalAllocated.ToString("C") &middot; Total Tendered: @_paymentAmount.ToString("C")
                        @if (_paymentAmount > TotalAllocated)
                        {
                            <span> &middot; Excess of @((_paymentAmount - TotalAllocated).ToString("C")) will be kept as credit.</span>
                        }
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="@(() => _showReceiptModal = false)">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="SaveReceiptAsync" disabled="@(_paymentAmount < TotalAllocated)">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private InvoiceDto? _invoice;
    private bool _isLoading = true;

    private bool _showReceiptModal;
    private List<ReceiptAllocationRow> _allocationRows = new();
    private decimal _paymentAmount;
    private PaymentMethod _paymentMethod = PaymentMethod.Cash;
    private DateTime _paymentDate = DateTime.Today;
    private string? _paymentReference;

    private decimal TotalAllocated => _allocationRows.Where(r => r.IsSelected).Sum(r => r.Amount);

    private string? _statusMessage;
    private bool _statusIsError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _invoice = await InvoiceService.GetInvoiceByIdAsync(Id);
        _isLoading = false;
    }

    private async Task OpenReceiptModal()
    {
        if (_invoice == null) return;

        _allocationRows = new List<ReceiptAllocationRow>
        {
            new()
            {
                InvoiceId = _invoice.Id,
                InvoiceNumber = _invoice.InvoiceNumber,
                ClientName = _invoice.ClientName,
                MaxAmount = _invoice.AmountOwing,
                IsLocked = true,
                IsSelected = true,
                Amount = _invoice.AmountOwing
            }
        };

        var payerClientId = _invoice.PayerClientId ?? _invoice.ClientId;
        var outstanding = await InvoiceService.GetOutstandingInvoicesForPayerAsync(payerClientId, _invoice.Id);
        foreach (var o in outstanding)
        {
            _allocationRows.Add(new ReceiptAllocationRow
            {
                InvoiceId = o.InvoiceId,
                InvoiceNumber = o.InvoiceNumber,
                ClientName = o.ClientName,
                MaxAmount = o.AmountOwing,
                IsLocked = false,
                IsSelected = false,
                Amount = o.AmountOwing
            });
        }

        RecalculateTenderAmount();
        _paymentMethod = PaymentMethod.Cash;
        _paymentDate = DateTime.Today;
        _paymentReference = null;
        _showReceiptModal = true;
    }

    private void RecalculateTenderAmount()
    {
        _paymentAmount = TotalAllocated;
    }

    private async Task SaveReceiptAsync()
    {
        if (_invoice == null) return;

        var selectedRows = _allocationRows.Where(r => r.IsSelected).ToList();
        if (selectedRows.Count == 0) return;

        var receiptId = await InvoiceService.CreateReceiptAsync(new CreateReceiptDto
        {
            PayerClientId = _invoice.PayerClientId ?? _invoice.ClientId,
            ReceiptDate = _paymentDate,
            Payments = new List<CreateReceiptTenderDto>
            {
                new() { Amount = _paymentAmount, Method = _paymentMethod, Reference = _paymentReference }
            },
            Allocations = selectedRows.Select(r => new CreateReceiptAllocationDto
            {
                InvoiceId = r.InvoiceId,
                Amount = r.Amount
            }).ToList()
        });

        _showReceiptModal = false;
        if (receiptId.HasValue)
        {
            ShowStatus("Receipt recorded.", false);
            await LoadAsync();
        }
        else
        {
            ShowStatus("Failed to record receipt.", true);
        }
    }

    private void ShowStatus(string message, bool isError)
    {
        _statusMessage = message;
        _statusIsError = isError;
    }

    private class ReceiptAllocationRow
    {
        public int InvoiceId { get; set; }
        public string InvoiceNumber { get; set; } = string.Empty;
        public string ClientName { get; set; } = string.Empty;
        public decimal MaxAmount { get; set; }
        public bool IsLocked { get; set; }
        public bool IsSelected { get; set; }
        public decimal Amount { get; set; }
    }
}
