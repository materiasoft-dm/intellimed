<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one deliberate exception to "Core has no EF" (see CLAUDE.md / ARCHITECTURE.md): only
         ApplicationUser needs it, to derive from IdentityUser. No DbContext, repository, or query
         code lives in Core. Version must stay in lockstep with the other projects. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.6" />
  </ItemGroup>

</Project>
